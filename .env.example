# ---------------------------------------------------------------------------
# Contact form — POST /api/contact → SMTP
#
# These are SERVER-side variables. They are read at runtime by the Vercel
# function and never bundled into the browser build. Configure them in the
# Vercel project under Settings → Environment Variables, for Production, Preview
# and Development. Never commit real values: this file is a template only.
# ---------------------------------------------------------------------------

# SMTP host.
#   GoDaddy Professional Email / Titan  → smtpout.secureserver.net
#   Microsoft 365 from GoDaddy          → smtp.office365.com
SMTP_HOST=smtpout.secureserver.net

# 465 with implicit TLS (Titan) · 587 with STARTTLS (Microsoft 365).
SMTP_PORT=465
SMTP_SECURE=true

# Mailbox that authenticates. It is also the From address of every message.
SMTP_USER=info@paulaambrosio.com
SMTP_PASSWORD=

# Inbox that receives the leads. Defaults to SMTP_USER when empty.
CONTACT_RECIPIENT_EMAIL=info@paulaambrosio.com

# Testing only: 'json' serialises the composed email into the server log instead
# of sending it. Leave empty in production.
CONTACT_MAIL_MODE=

# Optional — distributed rate limiting (Upstash Redis over REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CONTACT_RATE_LIMIT=5
CONTACT_RATE_LIMIT_WINDOW=600
CONTACT_RATE_LIMIT_PEPPER=

# Optional — Cloudflare Turnstile. Both keys must be present to activate it.
# The site key is public by design; the secret never leaves the server.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
