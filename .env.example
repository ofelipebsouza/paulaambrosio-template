# ---------------------------------------------------------------------------
# Contact form — POST /api/contact → SMTP
#
# These are SERVER-side variables. They are read at runtime by the Vercel
# function and never bundled into the browser build. Configure them in the
# Vercel project under Settings → Environment Variables, for Production, Preview
# and Development. Never commit real values: this file is a template only.
# ---------------------------------------------------------------------------

# SMTP host.
#   GoDaddy Professional Email / Titan  → smtpout.secureserver.net
#   Microsoft 365 from GoDaddy          → smtp.office365.com
SMTP_HOST=smtpout.secureserver.net

# 465 with implicit TLS (Titan) · 587 with STARTTLS (Microsoft 365).
SMTP_PORT=465
SMTP_SECURE=true

# Mailbox that authenticates. It is also the From address of every message.
SMTP_USER=info@paulaambrosio.com
SMTP_PASSWORD=

# Inbox that receives the leads. Defaults to SMTP_USER when empty.
CONTACT_RECIPIENT_EMAIL=info@paulaambrosio.com

# Testing only: 'json' serialises the composed email into the server log
# instead of sending it. Leave empty in production.
CONTACT_MAIL_MODE=

# Optional — distributed rate limiting (Upstash Redis over REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CONTACT_RATE_LIMIT=5
CONTACT_RATE_LIMIT_WINDOW=600
CONTACT_RATE_LIMIT_PEPPER=

# Optional — Cloudflare Turnstile. Both keys must be present to activate it.
# The site key is public by design; the secret never leaves the server.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Internal CRM — /admin/ dashboard + /api/crm/*
#
# Also SERVER-side. CRM_PASSWORD is mandatory: without it the login endpoint
# answers 503 and refuses every password. Everything else is optional and has
# a documented default. Full runbook: docs/crm.md.
# ---------------------------------------------------------------------------

# Required — the team credential for /admin/.
CRM_PASSWORD=

# Recommended — HMAC key for the session cookie. When empty the key is derived
# from CRM_PASSWORD (works, but rotating the password then signs everyone out).
CRM_SESSION_SECRET=

# Session lifetime in seconds (default 43200 = 12 h).
CRM_SESSION_TTL=

# Optional pepper for the hashed email lookup key. The rate-limit pepper is
# reused when this is empty.
CRM_INDEX_PEPPER=

# The CRM also persists leads with Upstash. Reuse the same instance as the
# rate limiter: CRM:lead:* keys are prefixed, so they never collide.

# Required for Hermes: the static token it sends as `x-hermes-token` when
# pulling its KPI payload from GET /api/crm/report/.
HERMES_TOKEN=

# Hermes → dashboard. When set, POST /api/crm/report/ requires
#   x-hermes-signature: sha256=HMAC-SHA256(rawBody, HERMES_WEBHOOK_SECRET)
HERMES_WEBHOOK_SECRET=

# JEV scoring (TypeSafe systemone). Every inquiry is classified on arrival:
# score, temperature, project type, budget fit, urgency and sentiment, stored
# on the lead and shown in the dashboard. Leave TYPESAFE_API_KEY empty to turn
# scoring off — the CRM still runs, leads show as "not scored" until it is set.
TYPESAFE_API_KEY=
# Defaults shown for reference; both are optional overrides.
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest

# JEV automation. Leave JEV_WEBHOOK_URL empty to disable outbound events.
# Payloads are signed with x-jev-signature: sha256=HMAC-SHA256(rawBody, secret).
JEV_WEBHOOK_URL=
JEV_WEBHOOK_SECRET=

# Vercel Cron (and the "Send reminders" button) for the follow-up digest.
# The cron sends Authorization: Bearer $CRON_SECRET automatically.
CRON_SECRET=

# Follow-up deadlines, in hours after the inquiry arrives.
CRM_FOLLOWUP_HOURS=24
CRM_FOLLOWUP_SECOND_HOURS=72

# Optional Google loader kill switch. Default release: consent bridge only, GTM v9.
# Set false and rebuild to disable the loader; see docs/google-tracking.md.
# PUBLIC_GOOGLE_TRACKING_ENABLED=false
