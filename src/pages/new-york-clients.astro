---
import type { ImageMetadata } from 'astro';
import phosphorIcons from '@phosphor-icons/web/regular/selection.json';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';
import FAQ from '../components/ui/FAQ.astro';
import ProjectLightbox from '../components/projects/ProjectLightbox.astro';
import { SITE, projectUrl, serviceUrl } from '../config';
import { faqSchema, webPageSchema, schemaScript } from '../lib/seo';
import type { BreadcrumbEntry } from '../lib/seo';

import homeAa01 from '../assets/projects/home-aa/web/01.webp';
import homeAa03 from '../assets/projects/home-aa/web/03.webp';
import homeAa04 from '../assets/projects/home-aa/web/04.webp';
import homeAa05 from '../assets/projects/home-aa/web/05.webp';

interface WorkImage {
	image: ImageMetadata;
	alt: string;
	project: string;
}

/**
 * Approved HOME A&A photographs already optimized in the project library.
 * 01, 03, 04 and 05 match the studio's numbered originals. No other project
 * is shown on this page.
 */
const gallery: WorkImage[] = [
	{
		image: homeAa01,
		alt: 'Oak media wall with a floating console, open display shelf and concealed storage in the HOME A&A residence by Paula Ambrosio Interiors',
		project: 'home-aa',
	},
	{
		image: homeAa05,
		alt: 'Kitchen with oak cabinetry, stone counters and an illuminated glass display cabinet in the HOME A&A residence by Paula Ambrosio Interiors',
		project: 'home-aa',
	},
	{
		image: homeAa03,
		alt: 'Illuminated glass cabinet and stone coffee niche with taupe cabinetry in the HOME A&A residence by Paula Ambrosio Interiors',
		project: 'home-aa',
	},
	{
		image: homeAa04,
		alt: 'Oak entry millwork with an integrated mirror, drawers and open storage in the HOME A&A residence by Paula Ambrosio Interiors',
		project: 'home-aa',
	},
];

const iconPaths = (name: string) => phosphorIcons.icons.find((icon) => icon.properties.name === name)?.icon.paths ?? [];

const hero = gallery[0];
const full = gallery.map((item) => item.image.src);
const projects = (await getCollection('projects')).filter((project) => !project.data.draft);
const projectTitles = Object.fromEntries(projects.map((project) => [project.id, project.data.title.replace(/\s*[–—]\s*/g, ', ')]));

const faqs = [
	{
		question: 'Where is the studio?',
		answer: 'Paula Ambrosio Interiors is a Miami studio at 1938 NE 149th St, North Miami, FL. Clients based in New York work with this studio. The phone numbers and email on this page reach the Miami studio.',
	},
	{
		question: 'I live in New York and own or am buying in Miami or South Florida. Can we talk?',
		answer: 'Yes. The studio designs full-service and turnkey interiors, and custom millwork, for residences, hospitality and commercial spaces in Miami and South Florida. A conversation can begin with one built-in or one room, or with a wider interior.',
	},
	{
		question: 'My project is located in New York. Can the studio help?',
		answer: "Tell us about your New York project and we'll discuss whether and how the studio can help (for example design direction and millwork design coordinated remotely with your local team).",
	},
	{
		question: 'What can custom millwork include?',
		answer: 'Depending on the room, custom millwork can include media walls, libraries, display shelving, bars, wardrobes, home offices, storage walls and cabinetry for hospitality or commercial interiors. The scope begins with what the space needs to hold and how it needs to feel.',
	},
	{
		question: 'Can you coordinate with my architect or contractor?',
		answer: 'Yes. Millwork is developed as part of the interior architecture, with proportions, materials, lighting and hardware considered alongside the room. The studio can collaborate with your architect, designer or properly licensed contractor on the information needed to carry the design forward.',
	},
	{
		question: 'Can I start with one room or one built-in?',
		answer: 'Yes. A conversation can begin with a single media wall, library, bar, wardrobe or other focused need. The studio can then clarify how that element should relate to the surrounding rooms and the wider interior direction.',
	},
];

const breadcrumbs: BreadcrumbEntry[] = [{ name: 'New York Clients', url: '/new-york-clients' }];
const description =
	'Paula Ambrosio Interiors is a North Miami studio for clients based in New York. Discuss a Miami or South Florida project, or a New York project coordinated with your local team.';
const pageTitle = 'Miami Interior Design for New York Clients';
const pagePath = '/new-york-clients';
---

<Layout title={pageTitle} description={description} canonical={pagePath} ogImage={hero.image.src} ogImageAlt={hero.alt}>
	<Fragment slot="head">
		<link rel="preload" as="image" href={hero.image.src} fetchpriority="high" />
	</Fragment>
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: pagePath,
		title: `${pageTitle} | Paula Ambrosio Interiors`,
		description,
		breadcrumbs,
	}))} />
	<Fragment slot="head" set:html={schemaScript(faqSchema(faqs))} />

	<article class="ny-page millwork-page">
		<div class="millwork-scroll-progress" aria-hidden="true"></div>
		<section class="millwork-hero bg-bone pb-14 text-center lg:pb-20" aria-labelledby="ny-hero-title">
			<div class="millwork-hero-media relative overflow-hidden bg-linen">
				<img
					src={hero.image.src}
					alt={hero.alt}
					width={hero.image.width}
					height={hero.image.height}
					loading="eager"
					decoding="async"
					fetchpriority="high"
					class="h-full w-full object-cover"
				/>
				<div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-bone via-bone/50 to-transparent lg:h-48" aria-hidden="true"></div>
			</div>
			<div class="container-editorial relative -mt-3 lg:-mt-8">
				<p class="eyebrow text-stone">Miami studio · Clients in New York</p>
				<h1 id="ny-hero-title" class="font-display mx-auto mt-4 max-w-5xl text-5xl leading-[0.98] tracking-[-0.025em] text-ink sm:text-6xl lg:text-[5.75rem]">For New York clients.<br /><span class="italic">From our Miami studio.</span></h1>
				<p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-slate sm:text-lg">Paula Ambrosio Interiors designs from North Miami. If you live in New York, talk with us about a home in Miami or South Florida, or about a project that stays in New York.</p>
				<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
					<button type="button" class="inquiry-open btn-primary cursor-pointer" data-analytics-event="cta_start_project" data-analytics-location="new_york_clients_hero">Discuss Your Project <svg viewBox="0 0 1024 1024" fill="currentColor" class="ml-1 inline-block h-4 w-4 shrink-0 align-middle" aria-hidden="true">{iconPaths('arrow-right').map((path) => <path d={path} />)}</svg></button>
					<a href="#ny-paths" class="btn-secondary">How a project can begin <svg viewBox="0 0 1024 1024" fill="currentColor" class="ml-1 inline-block h-4 w-4 shrink-0 align-middle" aria-hidden="true">{iconPaths('arrow-down').map((path) => <path d={path} />)}</svg></a>
				</div>
				<p class="mt-5 text-xs text-stone">One built-in, a complete room, or a wider interior vision.</p>
			</div>
		</section>

		<nav class="millwork-section-nav sticky top-16 z-30 border-y border-sand bg-bone/95 backdrop-blur-sm xl:top-20" aria-label="New York clients page sections">
			<div class="container-editorial flex items-center justify-between gap-5 py-4">
				<div class="ny-section-links flex min-w-0 gap-4 overflow-x-auto whitespace-nowrap text-[10px] font-semibold uppercase tracking-[0.14em] sm:gap-8 sm:text-xs">
					<a href="#ny-studio" class="transition-colors hover:text-coffee">Studio</a>
					<a href="#ny-paths" class="transition-colors hover:text-coffee">Project</a>
					<a href="#ny-millwork" class="transition-colors hover:text-coffee">Millwork</a>
					<a href="#ny-work" class="transition-colors hover:text-coffee">Work</a>
					<a href="#ny-process" class="transition-colors hover:text-coffee">Process</a>
				</div>
				<button type="button" class="inquiry-open shrink-0 cursor-pointer border-l border-sand pl-5 text-[10px] font-semibold uppercase tracking-[0.12em] text-coffee sm:text-xs" data-analytics-event="cta_start_project" data-analytics-location="new_york_clients_section_nav">Let’s talk <svg viewBox="0 0 1024 1024" fill="currentColor" class="ml-1 inline-block h-4 w-4 shrink-0 align-middle" aria-hidden="true">{iconPaths('arrow-up-right').map((path) => <path d={path} />)}</svg></button>
			</div>
		</nav>

		<section class="border-b border-sand bg-bone" aria-label="Studio, clients and project locations">
			<div class="container-editorial grid divide-y divide-sand py-0 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
				<div class="py-7 sm:px-8 sm:py-9 sm:first:pl-0 millwork-reveal">
					<p class="eyebrow text-stone">01 · Studio</p>
					<p class="mt-3 font-display text-2xl">North Miami</p>
					<p class="mt-2 text-sm leading-relaxed text-slate">{SITE.address}</p>
				</div>
				<div class="py-7 sm:px-8 sm:py-9 millwork-reveal">
					<p class="eyebrow text-stone">02 · Clients</p>
					<p class="mt-3 font-display text-2xl">Based in New York</p>
					<p class="mt-2 text-sm leading-relaxed text-slate">A Miami studio for people who live in New York.</p>
				</div>
				<div class="py-7 sm:py-9 sm:pl-8 millwork-reveal">
					<p class="eyebrow text-stone">03 · The brief</p>
					<p class="mt-3 font-display text-2xl">Two kinds of project</p>
					<p class="mt-2 text-sm leading-relaxed text-slate">A Miami or South Florida property, or a project located in New York.</p>
				</div>
			</div>
		</section>

		<section id="ny-studio" class="container-editorial grid gap-14 py-20 lg:grid-cols-12 lg:gap-16 lg:py-32" aria-labelledby="ny-studio-title">
			<div class="lg:col-span-4 millwork-reveal">
				<Breadcrumbs items={breadcrumbs} />
				<p class="eyebrow mt-7 text-stone">The studio</p>
				<h2 id="ny-studio-title" class="font-display mt-5 text-5xl leading-[0.98]">The same studio. A conversation that starts where you are.</h2>
			</div>
			<div class="lg:col-span-7 lg:col-start-6 millwork-reveal">
				<p class="text-xl leading-relaxed text-graphite">
					Paula Ambrosio Interiors is a Miami studio for full-service and turnkey interior design, and for custom millwork, across residences, hospitality and commercial spaces in Miami and South Florida.
				</p>
				<p class="mt-7 text-lg leading-relaxed text-slate">
					Clients based in New York may own or be buying property in Miami or South Florida. Others have a project in New York and want to know whether the studio can take part. Both conversations start the same way: tell us about the property and what you need the rooms to do.
				</p>
				<address class="mt-10 space-y-3 text-sm not-italic text-graphite">
					<p class="eyebrow text-stone">Miami studio</p>
					<p>{SITE.address}</p>
					<p><a href={`mailto:${SITE.email}`} class="underline decoration-brass/60 underline-offset-4 hover:text-ink" data-analytics-location="new_york_clients_studio">{SITE.email}</a></p>
					<p><a href={`tel:${SITE.phoneE164}`} class="underline decoration-brass/60 underline-offset-4 hover:text-ink" data-analytics-location="new_york_clients_studio">{SITE.phone}</a></p>
					<p><a href="tel:+17862085412" class="underline decoration-brass/60 underline-offset-4 hover:text-ink" data-analytics-location="new_york_clients_studio">{SITE.phone2}</a></p>
				</address>
			</div>
		</section>

		<section id="ny-paths" class="border-y border-sand bg-linen py-20 lg:py-28" aria-labelledby="ny-paths-title">
			<div class="container-editorial">
				<div class="max-w-2xl millwork-reveal">
					<p class="eyebrow text-stone">Where the project is</p>
					<h2 id="ny-paths-title" class="font-display mt-5 text-5xl leading-[0.98]">Two ways a New York client begins.</h2>
					<p class="mt-6 max-w-xl text-lede text-slate">Say which one describes the property. The studio is in North Miami either way.</p>
				</div>
				<div class="mt-14 grid gap-px bg-sand lg:grid-cols-2">
					<div class="bg-bone p-7 lg:p-10 millwork-reveal">
						<p class="font-display text-4xl text-brass">01</p>
						<h3 class="mt-5 font-display text-3xl leading-tight">A property in Miami or South Florida</h3>
						<p class="mt-5 text-base leading-relaxed text-slate">You live in New York, and the home you own or are buying is in Miami or South Florida. The studio can design the interior, including custom millwork and built-ins, and carry a full-service or turnkey scope when that is what the project needs.</p>
						<p class="mt-4 text-base leading-relaxed text-slate">Turnkey interior design is for clients who want a fully realized home, with the studio coordinating the path from concept through furniture, procurement, installation and final styling. A brief can also begin with one built-in or one room.</p>
						<p class="mt-6 text-sm leading-relaxed text-graphite">
							<a href={serviceUrl('turnkey-interior-design-miami')} class="underline decoration-brass/60 underline-offset-4 hover:text-ink">Turnkey interior design</a>
							<span aria-hidden="true"> · </span>
							<a href="/millwork/" class="underline decoration-brass/60 underline-offset-4 hover:text-ink">Custom millwork</a>
						</p>
					</div>
					<div class="bg-bone p-7 lg:p-10 millwork-reveal">
						<p class="font-display text-4xl text-brass">02</p>
						<h3 class="mt-5 font-display text-3xl leading-tight">A project located in New York</h3>
						<p class="mt-5 text-base leading-relaxed text-slate">Tell us about your New York project and we'll discuss whether and how the studio can help (for example design direction and millwork design coordinated remotely with your local team).</p>
						<p class="mt-4 text-base leading-relaxed text-slate">That conversation is with the Miami studio. Share the rooms, the local architect, designer or contractor you are already working with, and what you hope the studio might contribute.</p>
						<button type="button" class="inquiry-open btn-primary mt-8 cursor-pointer" data-analytics-event="cta_start_project" data-analytics-location="new_york_clients_paths">Discuss Your Project <svg viewBox="0 0 1024 1024" fill="currentColor" class="ml-1 inline-block h-4 w-4 shrink-0 align-middle" aria-hidden="true">{iconPaths('arrow-right').map((path) => <path d={path} />)}</svg></button>
					</div>
				</div>
			</div>
		</section>

		<section id="ny-millwork" class="border-b border-sand bg-bone py-20 lg:py-28" aria-labelledby="ny-millwork-title">
			<div class="container-editorial">
				<div class="grid gap-10 lg:grid-cols-12 lg:items-end">
					<div class="lg:col-span-6 millwork-reveal">
						<p class="eyebrow text-stone">Millwork &amp; interiors</p>
						<h2 id="ny-millwork-title" class="font-display mt-5 text-5xl leading-[0.98]">The quiet structure behind a finished room.</h2>
					</div>
					<div class="lg:col-span-5 lg:col-start-8 millwork-reveal">
						<p class="text-lg leading-relaxed text-slate">Custom millwork is more than cabinetry. It is the way a room holds what matters: books, art, media, glassware, clothing and the daily details of life. Built-ins are designed as part of the interior architecture, resolving proportion, material, lighting and storage together.</p>
					</div>
				</div>
				<div class="mt-14 grid gap-px bg-sand sm:grid-cols-2 lg:grid-cols-4">
					{[
						{ number: '01', title: 'Media walls', icon: 'television', body: 'Television, display, cable management and storage composed as one architectural elevation.' },
						{ number: '02', title: 'Libraries & display', icon: 'books', body: 'Open shelving and concealed storage with a deliberate balance of objects, books and negative space.' },
						{ number: '03', title: 'Bars & service areas', icon: 'wine', body: 'Cabinetry for bottles, glassware, appliances and the rituals that happen around them.' },
						{ number: '04', title: 'Wardrobes & offices', icon: 'desk', body: 'Built-in systems that make daily routines easier to see, reach and put away.' },
					].map((item) => (
						<div class="bg-linen p-7 transition-colors duration-500 hover:bg-white lg:p-8 millwork-reveal">
							<div class="flex items-center justify-between"><span class="font-display text-4xl text-brass">{item.number}</span><svg viewBox="0 0 1024 1024" fill="currentColor" class="h-8 w-8 text-coffee" aria-hidden="true">{iconPaths(item.icon).map((path) => <path d={path} />)}</svg></div>
							<h3 class="mt-5 font-display text-2xl">{item.title}</h3>
							<p class="mt-3 text-sm leading-relaxed text-slate">{item.body}</p>
						</div>
					))}
				</div>
				<p class="mt-8 max-w-3xl text-sm leading-relaxed text-slate millwork-reveal">The studio works across residences, hospitality and commercial environments in Miami and South Florida. The same attention to proportion and materiality is adapted to the way each space is used.</p>
			</div>
		</section>

		<section class="container-editorial grid gap-12 py-20 lg:grid-cols-12 lg:gap-16 lg:py-32" aria-labelledby="ny-detail-title">
			<div class="lg:col-span-5 millwork-reveal">
				<div class="aspect-[4/5] overflow-hidden bg-stone/10">
					<img src={homeAa04.src} alt={gallery[3].alt} width={homeAa04.width} height={homeAa04.height} loading="lazy" decoding="async" class="h-full w-full object-cover" />
				</div>
				<p class="mt-4 text-xs uppercase tracking-[0.16em] text-stone">Existing work · HOME A&amp;A</p>
			</div>
			<div class="flex flex-col justify-center lg:col-span-6 lg:col-start-7 millwork-reveal">
				<p class="eyebrow text-stone">Why it matters</p>
				<h2 id="ny-detail-title" class="font-display mt-5 text-5xl leading-[0.98]">Details that make the whole room quieter.</h2>
				<div class="mt-10 divide-y divide-sand border-y border-sand">
					<div class="py-5"><h3 class="flex items-center gap-3 font-display text-2xl"><svg viewBox="0 0 1024 1024" fill="currentColor" class="h-6 w-6 shrink-0 text-coffee" aria-hidden="true">{iconPaths('grid-four').map((path) => <path d={path} />)}</svg>A clear visual rhythm</h3><p class="mt-2 text-sm leading-relaxed text-slate">Open and closed storage are composed together, so the eye knows where to rest and what to find.</p></div>
					<div class="py-5"><h3 class="flex items-center gap-3 font-display text-2xl"><svg viewBox="0 0 1024 1024" fill="currentColor" class="h-6 w-6 shrink-0 text-coffee" aria-hidden="true">{iconPaths('stack').map((path) => <path d={path} />)}</svg>Materials in conversation</h3><p class="mt-2 text-sm leading-relaxed text-slate">Wood, stone, metal, glass and light are considered as one palette rather than a series of late additions.</p></div>
					<div class="py-5"><h3 class="flex items-center gap-3 font-display text-2xl"><svg viewBox="0 0 1024 1024" fill="currentColor" class="h-6 w-6 shrink-0 text-coffee" aria-hidden="true">{iconPaths('ruler').map((path) => <path d={path} />)}</svg>A brief that stays practical</h3><p class="mt-2 text-sm leading-relaxed text-slate">The finished element has to work every day: what it holds, how it opens and how it relates to circulation all matter.</p></div>
				</div>
				<button type="button" class="inquiry-open btn-primary mt-9 cursor-pointer" data-analytics-event="cta_start_project" data-analytics-location="new_york_clients_detail">Discuss Your Project <svg viewBox="0 0 1024 1024" fill="currentColor" class="ml-1 inline-block h-4 w-4 shrink-0 align-middle" aria-hidden="true">{iconPaths('arrow-right').map((path) => <path d={path} />)}</svg></button>
			</div>
		</section>

		<section id="ny-work" class="border-y border-sand bg-graphite py-20 text-bone lg:py-28" aria-labelledby="ny-work-title">
			<div class="container-editorial">
				<div class="mb-12 flex flex-wrap items-end justify-between gap-6 millwork-reveal">
					<div>
						<p class="eyebrow text-brass">Documented work</p>
						<h2 id="ny-work-title" class="font-display mt-5 text-5xl leading-[0.98]">HOME A&amp;A, from the studio portfolio.</h2>
					</div>
					<p class="max-w-sm text-sm leading-relaxed text-bone/65">Four photographs from HOME A&amp;A, a private residence in Miami and Palm Beach. Custom millwork is part of the work on that project.</p>
				</div>
				<div class="columns-1 gap-6 sm:columns-2" style="column-fill: balance;">
					{gallery.map((item, i) => (
						<figure class="mb-8 break-inside-avoid millwork-reveal">
							<button
								type="button"
								class="group relative block w-full cursor-zoom-in overflow-hidden"
								data-lightbox-trigger
								data-full={item.image.src}
								aria-label={`Open ${item.alt} fullscreen, image ${i + 1} of ${gallery.length}`}
							>
								<img src={item.image.src} alt={item.alt} width={item.image.width} height={item.image.height} loading="lazy" decoding="async" class="h-auto w-full" />
								<span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true"><span class="absolute bottom-4 left-4 text-xs uppercase tracking-[0.16em] text-bone">Open image</span></span>
							</button>
							<figcaption class="mt-3"><a href={projectUrl(item.project)} class="eyebrow text-bone/60 underline decoration-brass/60 underline-offset-4 transition-colors hover:text-bone" data-analytics-event="cta_view_project" data-analytics-location="new_york_clients_gallery">From {projectTitles[item.project] ?? item.project} <svg viewBox="0 0 1024 1024" fill="currentColor" class="ml-1 inline-block h-4 w-4 shrink-0 align-middle" aria-hidden="true">{iconPaths('arrow-up-right').map((path) => <path d={path} />)}</svg></a></figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

		<ProjectLightbox title="HOME A&A" full={full} />

		<section class="bg-graphite py-20 text-bone lg:py-28" aria-labelledby="ny-process">
			<div class="container-editorial grid gap-12 lg:grid-cols-12 lg:gap-16">
				<div class="lg:col-span-5 millwork-reveal">
					<p class="eyebrow text-brass">The process</p>
					<h2 id="ny-process" class="font-display mt-5 text-5xl leading-[0.98]">A considered conversation, from room to detail.</h2>
					<p class="mt-6 text-sm leading-relaxed text-bone/65">For a project located in New York, the first step is the discussion itself: whether and how the studio can help, for example with design direction and millwork design coordinated remotely with your local team.</p>
				</div>
				<div class="lg:col-span-6 lg:col-start-7">
					<div class="divide-y divide-bone/20 border-y border-bone/20">
						{[
							{ number: '01', title: 'Discover', icon: 'chat-circle-text', body: 'We talk through your space, your routines and what you need the cabinetry to do.' },
							{ number: '02', title: 'Direct', icon: 'pencil-ruler', body: 'We shape a visual direction across proportion, material, hardware and light.' },
							{ number: '03', title: 'Coordinate', icon: 'users-three', body: 'We coordinate the millwork design with the rest of your project team.' },
							{ number: '04', title: 'Refine', icon: 'check-circle', body: 'We review the details so the millwork fits the room and the way you use it.' },
						].map((step) => (
							<div class="grid grid-cols-[3rem_1fr] gap-5 py-6 millwork-reveal">
								<div class="text-brass"><svg viewBox="0 0 1024 1024" fill="currentColor" class="h-8 w-8" aria-hidden="true">{iconPaths(step.icon).map((path) => <path d={path} />)}</svg><span class="mt-2 block text-[10px] tracking-[0.18em]">{step.number}</span></div>
								<div><h3 class="font-display text-2xl">{step.title}</h3><p class="mt-2 text-sm leading-relaxed text-bone/65">{step.body}</p></div>
							</div>
						))}
					</div>
