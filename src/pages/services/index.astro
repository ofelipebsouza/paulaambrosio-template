---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import { webPageSchema, breadcrumbSchema, schemaScript } from '../../lib/seo';
import type { BreadcrumbEntry } from '../../lib/seo';
import { serviceUrl } from '../../config';

const services = (await getCollection('services')).filter((s) => !s.data.draft);

const paths = [
	{ label: 'Furnish My Condo', text: 'Choose furniture, lighting and accessories for a condo that is ready for installation.', href: serviceUrl('design-express-miami') },
	{ label: 'Renovate My Home', text: 'Rework the layout, finishes, lighting and cabinetry with a team that coordinates with your contractor.', href: serviceUrl('condo-renovation-interior-design-miami') },
	{ label: 'Design My New Home', text: 'Plan your interiors early and carry the design through furnishing and installation.', href: serviceUrl('turnkey-interior-design-miami') },
];

const breadcrumbs: BreadcrumbEntry[] = [{ name: 'Services', url: '/services' }];
---

<Layout
	title="Interior Design Services in Miami & South Florida"
	description="Explore interior design services in Miami for condo furnishing, home renovations, new homes, custom cabinetry and hospitality."
	canonical="/services"
>
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: '/services',
		title: 'Services | Paula Ambrosio Interior Design',
		description: 'Luxury interior design services in Miami and South Florida.',
		breadcrumbs,
	}))} />

	<section class="container-editorial pt-16 pb-14 lg:pt-24">
		<Breadcrumbs items={breadcrumbs} />
		<p class="eyebrow mt-10 text-stone">Services</p>
		<h1 class="font-display mt-4 max-w-2xl text-display">
			Interior Design Services in Miami and South Florida
		</h1>
		<p class="mt-6 max-w-xl text-lede text-slate">
			Tell us what you want to do with your property. We can furnish a condo, design a renovation or plan a new home before construction starts.
		</p>
	</section>

	<section class="container-editorial pb-12" aria-label="Find the right service">
		<div class="grid gap-4 md:grid-cols-3">
			{paths.map((item) => (
				<a href={item.href} class="block border border-sand p-6 transition-colors hover:bg-linen/60">
					<h2 class="font-display text-2xl">{item.label}</h2>
					<p class="mt-3 text-sm leading-relaxed text-slate">{item.text}</p>
				</a>
			))}
		</div>
	</section>

	<section class="container-editorial pb-24">
		<div class="divide-y divide-sand border-y border-sand">
			{services.map((service) => (
				<a href={serviceUrl(service.id)} class="group grid gap-4 py-10 transition-colors hover:bg-linen/60 lg:grid-cols-12 lg:items-baseline" data-analytics-event="service_open" data-analytics-service={service.id} data-analytics-location="services">
					<h2 class="font-display text-3xl lg:col-span-5 lg:text-4xl">{service.data.title}</h2>
					<p class="text-sm leading-relaxed text-slate lg:col-span-5">{service.data.introduction}</p>
					<span aria-hidden="true" class="eyebrow text-stone lg:col-span-2 lg:text-right">View service →</span>
				</a>
			))}
		</div>
	</section>

	<CtaBanner />
</Layout>
