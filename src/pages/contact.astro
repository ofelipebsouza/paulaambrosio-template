---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { webPageSchema, schemaScript } from '../lib/seo';
import type { BreadcrumbEntry } from '../lib/seo';
import { SITE, SOCIAL_LINKS } from '../config';
import Turnstile from '../components/ui/Turnstile.astro';
import UtmFields from '../components/UtmFields.astro';
import {
	BUDGET_OPTIONS,
	CONTACT_API_PATH,
	CONTACT_FIELDS,
	FIELD_LIMITS,
	HONEYPOT_FIELD,
	LOCATION_OPTIONS,
	PROPERTY_TYPE_OPTIONS,
	SERVICE_OPTIONS,
	TIMELINE_OPTIONS,
	type ContactFieldName,
} from '../lib/contact-form';

const inputClass =
	'mt-2 w-full border border-sand bg-white px-4 py-3 text-sm placeholder:text-mist focus:border-brass focus:outline-none';

const breadcrumbs: BreadcrumbEntry[] = [{ name: 'Contact', url: '/contact' }];
const socialIconMap: Record<string, string> = {
	Instagram: 'ph ph-instagram-logo',
	TikTok: 'ph ph-tiktok-logo',
	Threads: 'ph ph-threads-logo',
	LinkedIn: 'ph ph-linkedin-logo',
	Houzz: 'ph ph-buildings',
};

// The inquiry is posted to the server-side endpoint (src/pages/api/contact.ts),
// which validates and delivers it over SMTP. Labels, limits, requirements and
// option lists all come from src/lib/contact-form.ts so the markup, the email
// and the server validation cannot drift apart.
const fieldSpec = (field: ContactFieldName) =>
	CONTACT_FIELDS.find((entry) => entry.name === field) ?? { name: field, label: field, required: false };
const labelFor = (field: ContactFieldName) => fieldSpec(field).label;
const isRequired = (field: ContactFieldName) => fieldSpec(field).required;
const maxLengthFor = (field: ContactFieldName) => FIELD_LIMITS[field];
---

<Layout
	title="Contact | Start Your Interior Design Project"
	description="Start your project with Paula Ambrosio Interiors. Tell us about your Miami or South Florida property and schedule a private design consultation."
	canonical="/contact"
>
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: '/contact',
		title: 'Contact | Paula Ambrosio Interiors',
		description: 'Start your project with a private consultation.',
		breadcrumbs,
	}))} />

	<section class="container-editorial grid gap-16 pt-16 pb-24 lg:grid-cols-12 lg:pt-24">
		<div class="lg:col-span-5">
			<Breadcrumbs items={breadcrumbs} />
			<p class="eyebrow mt-10 text-stone">Contact</p>
			<h1 class="font-display mt-4 text-4xl lg:text-5xl">Start your project</h1>
			<p class="mt-6 max-w-md text-lg leading-relaxed text-slate">
				Tell us about your property and vision. We will schedule a confidential discovery session
				with our design team.
			</p>
			<address class="mt-10 space-y-3 text-sm not-italic text-graphite">
				<p class="eyebrow text-stone">Studio</p>
				<p>1938 NE 149th St, North Miami, FL</p>
				<p><a href="mailto:info@paulaambrosio.com" class="hover:text-stone">info@paulaambrosio.com</a></p>
				<p><a href="tel:+178****9478" class="hover:text-stone">+1 (786) 658-9478</a></p>
					<p><a href="tel:+178****5412" class="hover:text-stone">+1 (786) 208-5412</a></p>
				</address>
				<div class="mt-8">
					<p class="eyebrow text-stone">Follow Us</p>
					<div class="mt-4 flex flex-wrap gap-3">
						{SOCIAL_LINKS.map(({ label, href }) => (
							<a
								href={href}
								class="inline-flex h-11 w-11 items-center justify-center border border-sand bg-white text-graphite transition-colors hover:border-brass hover:text-coffee"
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${SITE.name} on ${label}`}
								title={label}
							>
								<i class={`${socialIconMap[label] ?? 'ph ph-link'} text-xl`} aria-hidden="true"></i>
							</a>
						))}
					</div>
				</div>
		</div>

		<div class="lg:col-span-7">
			<form
				class="space-y-6"
				method="POST"
				action={CONTACT_API_PATH}
				data-analytics-form="contact"
				data-contact-email={SITE.email}
			>
				<div class="grid gap-6 sm:grid-cols-2">
					<div>
						<label for="name" class="eyebrow text-slate">{labelFor('name')} *</label>
						<input id="name" name="name" type="text" required={isRequired('name')} autocomplete="name"
							maxlength={maxLengthFor('name')} class={inputClass} />
					</div>
					<div>
						<label for="email" class="eyebrow text-slate">{labelFor('email')} *</label>
						<input id="email" name="email" type="email" required={isRequired('email')} autocomplete="email"
							maxlength={maxLengthFor('email')} class={inputClass} />
					</div>
				</div>
				<div class="grid gap-6 sm:grid-cols-2">
					<div>
						<label for="phone" class="eyebrow text-slate">{labelFor('phone')}</label>
						<input id="phone" name="phone" type="tel" autocomplete="tel"
							maxlength={maxLengthFor('phone')} class={inputClass} />
					</div>
					<div>
						<label for="location" class="eyebrow text-slate">{labelFor('location')} *</label>
						<select id="location" name="location" required={isRequired('location')} class={inputClass}>
							<option value="">Select a location</option>
							{LOCATION_OPTIONS.map((option) => <option value={option}>{option}</option>)}
						</select>
					</div>
				</div>
				<div class="grid gap-6 sm:grid-cols-2">
					<div>
						<label for="propertyType" class="eyebrow text-slate">{labelFor('propertyType')}</label>
						<select id="propertyType" name="propertyType" class={inputClass}>
							<option value="">Select a property type</option>
							{PROPERTY_TYPE_OPTIONS.map((option) => <option value={option}>{option}</option>)}
						</select>
					</div>
					<div>
						<label for="service" class="eyebrow text-slate">{labelFor('service')} *</label>
						<select id="service" name="service" required={isRequired('service')} class={inputClass}>
							<option value="">Select a service</option>
							{SERVICE_OPTIONS.map((option) => <option value={option}>{option}</option>)}
						</select>
					</div>
				</div>
				<div class="grid gap-6 sm:grid-cols-2">
					<div>
						<label for="budget" class="eyebrow text-slate">{labelFor('budget')}</label>
						<select id="budget" name="budget" class={inputClass}>
							<option value="">Select a range</option>
							{BUDGET_OPTIONS.map((option) => <option value={option}>{option}</option>)}
						</select>
					</div>
					<div>
						<label for="timeline" class="eyebrow text-slate">{labelFor('timeline')}</label>
						<select id="timeline" name="timeline" class={inputClass}>
							<option value="">Select a timeline</option>
							{TIMELINE_OPTIONS.map((option) => <option value={option}>{option}</option>)}
						</select>
					</div>
				</div>
				<div>
					<label for="message" class="eyebrow text-slate">{labelFor('message')} *</label>
					<textarea id="message" name="message" rows="5" required={isRequired('message')}
						maxlength={maxLengthFor('message')}
						placeholder="Property type, neighborhood, approximate scope, timeline…"
						class={inputClass}></textarea>
				</div>

				<!-- Honeypot: hidden from visitors and assistive tech, irresistible to bots. -->
				<div class="hidden" aria-hidden="true">
					<label for="contact-website">Website</label>
					<input id="contact-website" name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
				</div>

				<!-- Campaign attribution, kept in the form backend — never in Analytics. -->
				<UtmFields />

				<Turnstile />

				<button type="submit" class="btn-primary w-full sm:w-auto">Submit Inquiry</button>
				<p class="analytics-form-status mt-3 text-sm" role="status" aria-live="polite"></p>
				<noscript>
					<p class="mt-3 text-sm text-slate">
						Prefer email? Write to
						<a class="underline decoration-brass/60 underline-offset-4" href={`mailto:${SITE.email}`}>{SITE.email}</a>
						or call <a class="underline decoration-brass/60 underline-offset-4" href={`tel:${SITE.phoneE164}`}>{SITE.phone}</a>.
					</p>
				</noscript>
			</form>
		</div>
	</section>
</Layout>
