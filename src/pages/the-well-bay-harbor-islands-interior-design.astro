---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import FAQ from '../components/ui/FAQ.astro';
import { faqSchema, schemaScript, serviceSchema, webPageSchema } from '../lib/seo';

const path = '/the-well-bay-harbor-islands-interior-design/';
const city = '/interior-designer-bay-harbor-islands/';
const heading = 'Interior Design for THE WELL Bay Harbor Islands Owners';
const title = 'THE WELL Bay Harbor Islands Interior Design';
const description = 'Plan a serene, furnished residence at THE WELL Bay Harbor Islands with independent interior design, custom cabinetry and turnkey coordination.';
const breadcrumbs = [{ name: 'Locations', url: '/locations/' }, { name: 'Bay Harbor Islands', url: city }, { name: 'THE WELL Bay Harbor Islands', url: path }];
const packages = [
  { name: 'Design + Furniture', text: 'A room plan with seating, bedding, dining furniture, lighting and textiles selected around your daily routines and the light in your residence.' },
  { name: 'Design + Furniture + Custom Millwork', text: 'Furniture selections plus storage designed for your belongings, from an entry bench to a concealed home office or integrated bedroom cabinetry.' },
  { name: 'Turnkey Arrival', text: 'A coordinated plan for purchasing, receiving, furniture installation and final styling, subject to building access, approvals and supplier availability.' },
];
const faqs = [
  { question: 'Can I plan the interiors before receiving access to my residence?', answer: 'Yes. We can review your current drawings and finish specifications remotely. Final measurements, access and building approvals are confirmed before releasing custom orders.' },
  { question: 'How can I create a quieter home office?', answer: 'We consider furniture placement, task lighting, storage, acoustically appropriate textiles and room separation based on your actual plan. Architectural or mechanical modifications require the applicable approvals.' },
  { question: 'Can you furnish my residence for part time living?', answer: 'Yes. We plan practical storage, durable furnishings and convenient arrival routines, then coordinate the agreed procurement and installation scope around confirmed access.' },
];
---
<Layout {title} {description} canonical={path}>
  <Fragment slot="head" set:html={schemaScript(webPageSchema({ path, title, description, breadcrumbs }))} />
  <Fragment slot="head" set:html={schemaScript(serviceSchema({ path, name: heading, description, areaServed: ['Bay Harbor Islands'] }))} />
  <Fragment slot="head" set:html={schemaScript(faqSchema(faqs))} />
  <article>
    <header class="border-b border-sand bg-linen py-16 lg:py-24">
      <div class="container-editorial">
        <Breadcrumbs items={breadcrumbs} />
        <p class="eyebrow mt-8 text-stone">Bay Harbor Islands · Furniture and custom millwork</p>
        <h1 class="font-display mt-4 max-w-4xl text-display">{heading}</h1>
        <p class="mt-6 max-w-2xl text-lede text-slate">A residence designed around well being deserves interiors that make ordinary rituals feel effortless. We help owners create a personal home with thoughtful furniture, lighting and storage, independently of the development.</p>
        <a href="/contact/" class="btn-primary mt-8 inline-flex" data-analytics-event="cta_start_project" data-analytics-location="hero">Plan Your Residence</a>
      </div>
    </header>
    <section aria-labelledby="layout-heading" class="container-editorial grid gap-10 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <h2 id="layout-heading" class="font-display text-4xl">Make room for your daily rituals</h2>
        <p class="mt-4 leading-relaxed text-slate">The <a href="https://www.terragroup.com/projects/the-well-bay-harbor-islands" class="underline underline-offset-4">developer's project overview</a> describes residences with generous glazing and private balconies alongside a wellness club and offices. That combination suggests a home organized around different rhythms: a place to prepare for the day, a comfortable space to work, and a calm room to unwind. Club access and membership terms are separate matters to confirm directly with the operator.</p>
      </div>
      <div>
        <h2 class="font-display text-4xl">Balance daylight, privacy and rest</h2>
        <p class="mt-4 leading-relaxed text-slate">A reading chair near the window, a layered window treatment and dimmable bedside lighting can support very different uses of the same home. We review orientation, the existing lighting and window specifications before choosing fabrics or fixtures. A nearby balcony can be an extension of a quiet seating area, provided the furnishings suit the exposure and the association permits them.</p>
      </div>
    </section>
    <section aria-labelledby="access-heading" class="border-y border-sand bg-linen py-16 lg:py-24">
      <div class="container-editorial">
        <h2 id="access-heading" class="font-display text-4xl">A practical plan for move in</h2>
        <p class="mt-4 max-w-3xl leading-relaxed text-slate">Start with the finish schedule and floor plan, then inventory what you will bring. We look for a place to put away exercise equipment, luggage and everyday items without crowding circulation. If an office needs to disappear at the end of the day, we can explore concealed storage and furniture that serves more than one purpose.</p>
        <p class="mt-4 max-w-3xl leading-relaxed text-slate">Before ordering, we check actual interior dimensions, service elevator clearances, loading access, delivery appointments and any installation requirements with the owner and building management. A club opening or office occupancy does not establish when a particular residence can accept deliveries.</p>
      </div>
    </section>
    <section aria-labelledby="packages-heading" class="container-editorial py-16 lg:py-24">
      <h2 id="packages-heading" class="font-display text-4xl">Choose what you want us to handle</h2>
      <div class="mt-8 grid gap-8 lg:grid-cols-3">
        {packages.map(({ name, text }) => <div class="border-t border-sand pt-5"><h3 class="font-display text-2xl">{name}</h3><p class="mt-3 leading-relaxed text-slate">{text}</p></div>)}
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
        <li><a href="/turnkey-interior-design-miami/" class="underline underline-offset-4">Turnkey Interior Design</a></li>
        <li><a href="/millwork/" class="underline underline-offset-4">Custom Millwork</a></li>
        <li><a href="/penthouse-interior-design-miami-beach/" class="underline underline-offset-4">Penthouse Interior Design</a></li>
        <li><a href={city} class="underline underline-offset-4">Bay Harbor Islands Interior Design</a></li>
      </ul>
    </section>
    <section aria-labelledby="faq-heading" class="container-editorial pb-16 lg:pb-24">
      <h2 id="faq-heading" class="font-display text-3xl">Questions for owners</h2>
      <div class="mt-7 max-w-3xl"><FAQ {faqs} context="the-well-bay-harbor-islands" /></div>
    </section>
    <section aria-labelledby="start-heading" class="border-t border-sand bg-linen py-16 lg:py-24">
      <div class="container-editorial">
        <h2 id="start-heading" class="font-display text-4xl">Design a home around your lifestyle</h2>
        <p class="mt-4 max-w-3xl leading-relaxed text-slate">Tell us about your residence, the routines you want to make easier and whether you need furniture, custom cabinetry or complete furnishing coordination. We can begin with a consultation and your current floor plan.</p>
        <a href="/contact/" class="btn-primary mt-7 inline-flex" data-analytics-event="cta_start_project" data-analytics-location="footer">Discuss Your Project</a>
        <p class="mt-8 max-w-3xl text-sm text-slate">Paula Ambrosio Interior Design is an independent interior design studio and is not affiliated with the developer, sales team or condominium association of this building. Building names are used for identification only.</p>
      </div>
    </section>
  </article>
</Layout>
