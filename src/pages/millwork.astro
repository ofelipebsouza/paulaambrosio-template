---
import type { ImageMetadata } from 'astro';
import phosphorIcons from '@phosphor-icons/web/regular/selection.json';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';
import FAQ from '../components/ui/FAQ.astro';
import ProjectLightbox from '../components/projects/ProjectLightbox.astro';
import { getCollection } from 'astro:content';
import { projectUrl } from '../config';
import { faqSchema, serviceSchema, webPageSchema, schemaScript } from '../lib/seo';
import type { BreadcrumbEntry } from '../lib/seo';

import homeTr09 from '../assets/projects/home-tr/web/09.webp';
import homeTr06 from '../assets/projects/home-tr/web/06.webp';
import homeTr11 from '../assets/projects/home-tr/web/11.webp';
import homeTr25 from '../assets/projects/home-tr/web/25.webp';
import homeIt01 from '../assets/projects/home-it/web/01.webp';
import homeIt04 from '../assets/projects/home-it/web/04.webp';
import homeIt07 from '../assets/projects/home-it/web/07.webp';
import homeDr03 from '../assets/projects/home-dr/web/03.webp';
import homeDr15 from '../assets/projects/home-dr/web/15.webp';
import homeKa01 from '../assets/projects/home-ka/web/01.webp';
import homeKa02 from '../assets/projects/home-ka/web/02.webp';
import homeKa05 from '../assets/projects/home-ka/web/05.webp';
import commercialHs02 from '../assets/projects/commercial-hs/web/02.webp';
import commercialHs17 from '../assets/projects/commercial-hs/web/17.webp';
import commercialG305 from '../assets/projects/home-g3/web/05.webp';

interface MillworkImage {
	image: ImageMetadata;
	alt: string;
	project: string;
}

interface ConceptImage {
	src: string;
	alt: string;
	label: string;
	detail: string;
	libraryFileId: string;
}

/**
 * These are documented project photographs already in the repository. Keep
 * them distinct from the concept references below: the gallery is the proof
 * of work, while the concept cards are visual direction only.
 */
const gallery: MillworkImage[] = [
	{
		image: homeTr09,
		alt: 'HOME TR custom walnut wall of open shelving with integrated warm lighting and concealed storage',
		project: 'home-tr',
	},
	{
		image: homeIt01,
		alt: 'HOME IT living room with a full-width oak media wall, open shelving and lower cabinets',
		project: 'home-it',
	},
	{
		image: homeDr03,
		alt: 'HOME DR bar with black cabinetry, lit bottle shelving, wine storage and a stone counter',
		project: 'home-dr',
	},
	{
		image: homeKa01,
		alt: 'HOME KA double-height living room with illuminated display niches and a vertical oak screen',
		project: 'home-ka',
	},
	{
		image: homeTr11,
		alt: 'HOME TR living room with a full-height walnut library wall and integrated display lighting',
		project: 'home-tr',
	},
	{
		image: homeIt04,
		alt: 'HOME IT media wall with long oak cabinetry, concealed television storage and integrated lighting',
		project: 'home-it',
	},
	{
		image: homeTr25,
		alt: 'HOME TR study with a walnut built-in library, display shelving and a white desk',
		project: 'home-tr',
	},
	{
		image: homeDr15,
		alt: 'HOME DR office with a full wall of fluted cabinetry, open shelves, drawers and integrated lighting',
		project: 'home-dr',
	},
	{
		image: homeKa02,
		alt: 'HOME KA illuminated built-in display shelving with objects, art and concealed storage',
		project: 'home-ka',
	},
	{
		image: commercialHs02,
		alt: 'COMMERCIAL HS salon with pale oak cabinetry, mirrored storage and illuminated work surfaces',
		project: 'commercial-hs',
	},
	{
		image: homeKa05,
		alt: 'HOME KA living room with a full-height fluted wood wall and television built-in',
		project: 'home-ka',
	},
	{
		image: commercialHs17,
		alt: 'COMMERCIAL HS salon with a continuous reception and styling cabinetry under illuminated arches',
		project: 'commercial-hs',
	},
	{
		image: homeIt07,
		alt: 'HOME IT bedroom with a green illuminated media wall, display shelving and custom drawers',
		project: 'home-it',
	},
	{
		image: homeTr06,
		alt: 'HOME TR hallway with a walnut built-in library and concealed storage beside the stair',
		project: 'home-tr',
	},
	{
		image: commercialG305,
		alt: 'Commercial G3 retail shelving with integrated lighting displaying luggage and accessories',
		project: 'home-g3',
	},
];

/**
 * Concept references are intentionally not part of the real-project gallery.
 * The files are generated visual studies and are labelled as such in the UI.
 * Library IDs are retained here so a later asset replacement can keep the
 * content model stable without ever presenting the references as built work.
 */
const conceptImages: ConceptImage[] = [
	{
		src: '/images/millwork-concepts/millwork-miami-interior-concept.webp',
		alt: 'AI-generated interior concept with pale wood cabinetry, a darker illuminated display niche and natural stone in a sunlit living room',
		label: 'Interior direction',
		detail: 'A study in proportion, light and the calm rhythm of open and closed storage.',
		libraryFileId: 'libfile_f4118010531c8191a7e1ca20873e4c92',
	},
	{
		src: '/images/millwork-concepts/millwork-craft-workshop-concept.webp',
		alt: 'AI-generated craft concept showing a craftsperson’s hands planing a wood board at a workbench',
		label: 'The craft',
		detail: 'A conceptual close-up of hands, tools and the tactile character of working wood.',
		libraryFileId: 'libfile_54910ea6811c8191af4b353f929f8177',
	},
	{
		src: '/images/millwork-concepts/millwork-joinery-concept.webp',
		alt: 'AI-generated joinery concept showing a close-up of a pale wood drawer corner with contrasting dovetail joints',
		label: 'Detail direction',
		detail: 'Grain, precise joints and softly finished edges — the details you see and touch every day.',
		libraryFileId: 'libfile_1ff4fcdcfbc081919455a99b91739f1e',
	},
	{
		src: '/images/millwork-concepts/millwork-ribbed-panel-paula-inspired-concept.webp',
		alt: 'AI-generated concept of honey-toned vertical wood fins turning around a corner in a bright neutral interior',
		label: 'Rhythm & texture',
		detail: 'Warm vertical lines and quiet shadow gaps, informed by the material language of HOME KA.',
		libraryFileId: 'libfile_e98ad2ed61588191810c6b6e8e400732',
	},
	{
		src: '/images/millwork-concepts/millwork-honey-taupe-cabinet-paula-inspired-concept.webp',
		alt: 'AI-generated concept of honey-toned wood cabinetry, illuminated display niches and taupe lower drawers',
		label: 'A considered palette',
		detail: 'Honey-toned grain, soft taupe and illuminated niches, inspired by references from HOME IT and HOME KA.',
		libraryFileId: 'libfile_9d5a6f0b0ea48191b28ec07473126854',
	},
	{
		src: '/images/millwork-concepts/millwork-wood-finish-samples-paula-inspired-concept.webp',
		alt: 'AI-generated material study of warm wood panels, vertical slats, a taupe finish and ribbed glass on pale stone',
		label: 'Material conversation',
		detail: 'An imagined palette of wood tones, satin finishes and ribbed glass — a starting point, not a product specification.',
		libraryFileId: 'libfile_e9ec6d03e170819182cc37870707dee7',
	},
];

// Render only the selected Phosphor paths as inline SVG; no extra icon font or browser JavaScript.
const iconPaths = (name: string) => phosphorIcons.icons.find((icon) => icon.properties.name === name)?.icon.paths ?? [];

const hero = conceptImages[0];
const conceptSrcSet = (src: string) => `${src.replace('.webp', '-768.webp')} 768w, ${src} 1536w`;
const full = gallery.map((item) => item.image.src);
const projects = (await getCollection('projects')).filter((project) => !project.data.draft);
const projectTitles = Object.fromEntries(projects.map((project) => [project.id, project.data.title]));

const faqs = [
	{
		question: 'What can custom millwork include?',
		answer: 'Depending on the room, custom millwork can include media walls, libraries, display shelving, bars, wardrobes, home offices, storage walls and cabinetry for hospitality or commercial interiors. The scope begins with what the space needs to hold and how it needs to feel.',
	},
	{
		question: 'Can you coordinate millwork with my architect or contractor?',
		answer: 'Yes. Millwork is developed as part of the interior architecture, with proportions, materials, lighting and hardware considered alongside the room. The studio can collaborate with your architect, designer or properly licensed contractor on the information needed to carry the design forward.',
	},
	{
		question: 'Do you work on residential and commercial interiors?',
		answer: 'The studio works across residences, hospitality and commercial environments in Miami and South Florida. The same attention to proportion and materiality is adapted to the way each space is used.',
	},
	{
		question: 'How does a millwork project begin?',
		answer: 'It begins with a confidential discovery session. We learn about the room, property, practical requirements and the design direction you are drawn to, then determine which next conversations and drawings are appropriate for the project.',
	},
	{
		question: 'Can I start with one room or one built-in?',
		answer: 'Yes. A conversation can begin with a single media wall, library, bar, wardrobe or other focused need. The studio can then clarify how that element should relate to the surrounding rooms and the wider interior direction.',
	},
];

const breadcrumbs: BreadcrumbEntry[] = [{ name: 'Millwork', url: '/millwork' }];
const description =
	'Custom millwork and built-ins by Paula Ambrosio Interiors: media walls, libraries, bars, storage and commercial cabinetry designed as part of the architecture of each room.';
const pageTitle = 'Custom Millwork & Built-Ins in Miami';
const pagePath = '/millwork';
---

<Layout
	title={pageTitle}
	description={description}
	canonical={pagePath}
	ogImage={hero.src}
	ogImageAlt={hero.alt}
>
	<Fragment slot="head"><link rel="preload" as="image" href={hero.src} imagesrcset={conceptSrcSet(hero.src)} imagesizes="100vw" fetchpriority="high" /></Fragment>
	<Fragment slot="head" set:html={schemaScript(serviceSchema({
		path: pagePath,
		name: 'Custom Millwork',
		description,
	}))} />
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: pagePath,
		title: 'Custom Millwork | Paula Ambrosio Interiors',
		description,
		breadcrumbs,
	}))} />
	<Fragment slot="head" set:html={schemaScript(faqSchema(faqs))} />

	<article class="millwork-page">
		<div class="millwork-scroll-progress" aria-hidden="true"></div>
		<section class="millwork-hero bg-bone pb-14 text-center lg:pb-20" aria-labelledby="millwork-hero-title">
			<div class="millwork-hero-media relative overflow-hidden bg-linen">
				<img
					src={hero.src}
					srcset={conceptSrcSet(hero.src)}
					sizes="100vw"
					alt={hero.alt}
					width="1536"
					height="1024"
					loading="eager"
					decoding="async"
					fetchpriority="high"
					class="h-full w-full object-cover"
				/>
				<div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-bone via-bone/50 to-transparent lg:h-48" aria-hidden="true"></div>
				<p class="absolute right-4 top-4 rounded-full bg-bone/90 px-3 py-2 text-[9px] font-semibold uppercase tracking-[0.13em] text-graphite sm:right-8 sm:top-6">AI concept · Interior direction</p>
			</div>
			<div class="container-editorial relative -mt-3 lg:-mt-8">
				<p class="eyebrow text-stone">Custom millwork · Miami &amp; South Florida</p>
				<h1 id="millwork-hero-title" class="font-display mx-auto mt-4 max-w-5xl text-5xl leading-[0.98] tracking-[-0.025em] text-ink sm:text-6xl lg:text-[5.75rem]">Custom millwork.<br /><span class="italic">Made to belong.</span></h1>
				<p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-slate sm:text-lg">Cabinetry, wall panels and built-ins designed around your rooms — with material, light and every daily detail considered together.</p>
				<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
					<button type="button" class="inquiry-open btn-primary cursor-pointer" data-analytics-event="cta_start_project" data-analytics-location="millwork_hero">Discuss Your Project <span aria-hidden="true">→</span></button>
					<a href="#millwork-work" class="btn-secondary">Explore selected work <span aria-hidden="true">↓</span></a>
				</div>
				<p class="mt-5 text-xs text-stone">One built-in, a complete room, or a wider interior vision.</p>
			</div>
		</section>

		<nav class="millwork-section-nav sticky top-16 z-30 border-y border-sand bg-bone/95 backdrop-blur-sm xl:top-20" aria-label="Millwork page sections">
			<div class="container-editorial flex items-center justify-between gap-5 py-4">
				<div class="flex min-w-0 gap-5 overflow-x-auto whitespace-nowrap text-[10px] font-semibold uppercase tracking-[0.14em] sm:gap-8 sm:text-xs">
					<a href="#millwork-inspiration" class="transition-colors hover:text-coffee">Materials &amp; craft</a>
					<a href="#millwork-work" class="transition-colors hover:text-coffee">Selected work</a>
					<a href="#millwork-process" class="transition-colors hover:text-coffee">The process</a>
				</div>
				<button type="button" class="inquiry-open shrink-0 cursor-pointer border-l border-sand pl-5 text-[10px] font-semibold uppercase tracking-[0.12em] text-coffee sm:text-xs" data-analytics-event="cta_start_project" data-analytics-location="millwork_section_nav">Let’s talk <span aria-hidden="true">↗</span></button>
			</div>
		</nav>

		<section class="border-b border-sand bg-bone" aria-label="Millwork service areas">
			<div class="container-editorial grid divide-y divide-sand py-0 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
				<div class="py-7 sm:px-8 sm:py-9 sm:first:pl-0 millwork-reveal">
					<p class="eyebrow text-stone">01 · Residential</p>
					<p class="mt-3 font-display text-2xl">Rooms with a point of view.</p>
				</div>
				<div class="py-7 sm:px-8 sm:py-9 millwork-reveal">
					<p class="eyebrow text-stone">02 · Hospitality</p>
					<p class="mt-3 font-display text-2xl">Guest-facing details, resolved.</p>
				</div>
				<div class="py-7 sm:py-9 sm:pl-8 millwork-reveal">
					<p class="eyebrow text-stone">03 · Commercial</p>
					<p class="mt-3 font-display text-2xl">Joinery that carries the experience.</p>
				</div>
			</div>
		</section>

		<section class="container-editorial grid gap-14 py-20 lg:grid-cols-12 lg:gap-16 lg:py-32" aria-labelledby="millwork-service">
			<div class="lg:col-span-4 millwork-reveal">
				<Breadcrumbs items={breadcrumbs} />
				<p class="eyebrow mt-7 text-stone">The service</p>
				<h2 id="millwork-service" class="font-display mt-5 text-5xl leading-[0.98]">The quiet structure behind a finished room.</h2>
			</div>
			<div class="lg:col-span-7 lg:col-start-6 millwork-reveal">
				<p class="text-xl leading-relaxed text-graphite">
					Custom millwork is more than cabinetry. It is the way a room holds what matters: books, art, media, glassware, clothing and the daily details of life. We design built-ins as part of the interior architecture, resolving proportion, material, lighting and storage together.
				</p>
				<p class="mt-7 text-lg leading-relaxed text-slate">
					The starting point is always the room and the people who use it. From there, we shape a coherent language for the elements that need to be seen, concealed, lit or simply lived with.
				</p>
				<div class="mt-9 flex flex-wrap gap-x-8 gap-y-3 text-xs font-semibold uppercase tracking-[0.18em] text-stone">
					<span>Proportion</span><span>Material</span><span>Storage</span><span>Light</span>
				</div>
			</div>
		</section>

		<section class="border-b border-sand bg-bone py-20 lg:py-28" aria-labelledby="millwork-inspiration">
			<div class="container-editorial">
				<div class="grid gap-10 lg:grid-cols-12 lg:items-end">
					<div class="lg:col-span-6 millwork-reveal">
						<p class="eyebrow text-stone">Inspiration / concept imagery</p>
						<h2 id="millwork-inspiration" class="font-display mt-5 text-5xl leading-[0.98]">A starting point for the conversation.</h2>
					</div>
					<div class="lg:col-span-5 lg:col-start-8 millwork-reveal">
						<p class="text-lg leading-relaxed text-slate">Six AI-generated studies explore material, light and joinery direction, including new palettes inspired by the studio’s documented work. They are not photographs of Paula Ambrosio projects, a Paula Ambrosio workshop or a representation of the studio team.</p>
					</div>
				</div>
				<div class="mt-12 grid gap-x-5 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
					{conceptImages.map((concept) => (
						<figure class="group millwork-reveal" data-library-file-id={concept.libraryFileId}>
							<div class="overflow-hidden bg-stone/10">
								<img src={concept.src} alt={concept.alt} srcset={conceptSrcSet(concept.src)} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" width="1536" height="1024" loading="lazy" decoding="async" class="aspect-[3/2] h-auto w-full object-cover motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-[1.03]" />
							</div>
							<figcaption class="border-x border-b border-sand p-5">
								<p class="eyebrow text-stone">{concept.label} · AI concept</p>
								<p class="mt-3 text-sm leading-relaxed text-slate">{concept.detail}</p>
							</figcaption>
						</figure>
					))}
				</div>
				<div class="mt-12 flex flex-col items-start justify-between gap-5 border-t border-sand pt-8 sm:flex-row sm:items-center millwork-reveal">
					<p class="max-w-lg font-display text-2xl">A material, a room, an idea.<br />Let’s find the direction that feels like you.</p>
					<button type="button" class="inquiry-open btn-primary cursor-pointer" data-analytics-event="cta_start_project" data-analytics-location="millwork_materials">Explore your possibilities <span aria-hidden="true">→</span></button>
				</div>
			</div>
		</section>

		<section class="border-y border-sand bg-linen py-20 lg:py-28" aria-labelledby="millwork-applications">
			<div class="container-editorial">
				<div class="max-w-2xl millwork-reveal">
					<p class="eyebrow text-stone">Applications</p>
					<h2 id="millwork-applications" class="font-display mt-5 text-5xl leading-[0.98]">One design language, carried through the room.</h2>
					<p class="mt-6 max-w-xl text-lede text-slate">The brief can be focused or expansive. The design work is in making every element feel like it belongs to the same architecture.</p>
				</div>
				<div class="mt-14 grid gap-px bg-sand sm:grid-cols-2 lg:grid-cols-4">
					{[
						{ number: '01', title: 'Media walls', icon: 'television', body: 'Television, display, cable management and storage composed as one architectural elevation.' },
						{ number: '02', title: 'Libraries & display', icon: 'books', body: 'Open shelving and concealed storage with a deliberate balance of objects, books and negative space.' },
						{ number: '03', title: 'Bars & service areas', icon: 'wine', body: 'Cabinetry for bottles, glassware, appliances and the rituals that happen around them.' },
						{ number: '04', title: 'Wardrobes & offices', icon: 'desk', body: 'Built-in systems that make daily routines easier to see, reach and put away.' },
					].map((item) => (
						<div class="bg-bone p-7 transition-colors duration-500 hover:bg-white lg:p-8 millwork-reveal">
							<div class="flex items-center justify-between"><span class="font-display text-4xl text-brass">{item.number}</span><svg viewBox="0 0 1024 1024" fill="currentColor" class="h-8 w-8 text-coffee" aria-hidden="true">{iconPaths(item.icon).map((path) => <path d={path} />)}</svg></div>
							<h3 class="mt-5 font-display text-2xl">{item.title}</h3>
							<p class="mt-3 text-sm leading-relaxed text-slate">{item.body}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="container-editorial grid gap-12 py-20 lg:grid-cols-12 lg:gap-16 lg:py-32" aria-labelledby="millwork-benefits">
			<div class="lg:col-span-5 millwork-reveal">
				<div class="aspect-[4/5] overflow-hidden bg-stone/10">
					<img src={homeKa02.src} alt="HOME KA built-in display shelving with illuminated niches and concealed storage" width={homeKa02.width} height={homeKa02.height} loading="lazy" decoding="async" class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-700 motion-safe:hover:scale-[1.03]" />
				</div>
				<p class="mt-4 text-xs uppercase tracking-[0.16em] text-stone">Existing work · HOME KA</p>
			</div>
			<div class="flex flex-col justify-center lg:col-span-6 lg:col-start-7 millwork-reveal">
				<p class="eyebrow text-stone">Why it matters</p>
				<h2 id="millwork-benefits" class="font-display mt-5 text-5xl leading-[0.98]">Details that make the whole room quieter.</h2>
				<div class="mt-10 divide-y divide-sand border-y border-sand">
					<div class="py-5"><h3 class="flex items-center gap-3 font-display text-2xl"><svg viewBox="0 0 1024 1024" fill="currentColor" class="h-6 w-6 shrink-0 text-coffee" aria-hidden="true">{iconPaths('grid-four').map((path) => <path d={path} />)}</svg>A clear visual rhythm</h3><p class="mt-2 text-sm leading-relaxed text-slate">Open and closed storage are composed together, so the eye knows where to rest and what to find.</p></div>
					<div class="py-5"><h3 class="flex items-center gap-3 font-display text-2xl"><svg viewBox="0 0 1024 1024" fill="currentColor" class="h-6 w-6 shrink-0 text-coffee" aria-hidden="true">{iconPaths('stack').map((path) => <path d={path} />)}</svg>Materials in conversation</h3><p class="mt-2 text-sm leading-relaxed text-slate">Wood, stone, metal, glass and light are considered as one palette rather than a series of late additions.</p></div>
					<div class="py-5"><h3 class="flex items-center gap-3 font-display text-2xl"><svg viewBox="0 0 1024 1024" fill="currentColor" class="h-6 w-6 shrink-0 text-coffee" aria-hidden="true">{iconPaths('ruler').map((path) => <path d={path} />)}</svg>A brief that stays practical</h3><p class="mt-2 text-sm leading-relaxed text-slate">The finished element has to work every day: what it holds, how it opens and how it relates to circulation all matter.</p></div>
				</div>
				<button type="button" class="inquiry-open btn-primary mt-9 cursor-pointer" data-analytics-event="cta_start_project" data-analytics-location="millwork_benefits">Talk through your room <span aria-hidden="true">→</span></button>
			</div>
		</section>

		<section id="millwork-work" class="border-y border-sand bg-graphite py-20 text-bone lg:py-28" aria-labelledby="millwork-work-title">
			<div class="container-editorial">
				<div class="mb-12 flex flex-wrap items-end justify-between gap-6 millwork-reveal">
					<div>
						<p class="eyebrow text-brass">Documented work</p>
						<h2 id="millwork-work-title" class="font-display mt-5 text-5xl leading-[0.98]">Made for the way a room is lived in.</h2>
					</div>
					<p class="max-w-sm text-sm leading-relaxed text-bone/65">A selection of installed millwork and built-ins from residential, hospitality and commercial projects.</p>
				</div>

				<div class="columns-1 gap-6 sm:columns-2" style="column-fill: balance;">
					{gallery.map((item, i) => (
						<figure class="mb-8 break-inside-avoid millwork-reveal" style={`--reveal-delay: ${Math.min(i, 7) * 45}ms`}>
							<button
								type="button"
								class="group relative block w-full cursor-zoom-in overflow-hidden"
								data-lightbox-trigger
								data-full={item.image.src}
								aria-label={`Open ${item.alt} fullscreen, image ${i + 1} of ${gallery.length}`}
							>
								<img src={item.image.src} alt={item.alt} width={item.image.width} height={item.image.height} loading="lazy" decoding="async" class="h-auto w-full motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-[1.03]" />
								<span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true"><span class="absolute bottom-4 left-4 text-xs uppercase tracking-[0.16em] text-bone">Open image</span></span>
							</button>
							<figcaption class="mt-3"><a href={projectUrl(item.project)} class="eyebrow text-bone/60 underline decoration-brass/60 underline-offset-4 transition-colors hover:text-bone" data-analytics-event="cta_view_project" data-analytics-location="millwork_gallery">From {projectTitles[item.project] ?? item.project} <span aria-hidden="true">↗</span></a></figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

		<ProjectLightbox title="Documented Millwork" full={full} />

		<section class="bg-graphite py-20 text-bone lg:py-28" aria-labelledby="millwork-process">
			<div class="container-editorial grid gap-12 lg:grid-cols-12 lg:gap-16">
				<div class="lg:col-span-5 millwork-reveal">
					<p class="eyebrow text-brass">The process</p>
					<h2 id="millwork-process" class="font-display mt-5 text-5xl leading-[0.98]">A considered conversation, from room to detail.</h2>
				</div>
				<div class="lg:col-span-6 lg:col-start-7">
					<div class="divide-y divide-bone/20 border-y border-bone/20">
						{[
							{ number: '01', title: 'Discover', icon: 'chat-circle-text', body: 'We listen to the room, the property and the routines the joinery needs to support.' },
							{ number: '02', title: 'Direct', icon: 'pencil-ruler', body: 'We shape a visual direction across proportion, material, hardware and light.' },
							{ number: '03', title: 'Coordinate', icon: 'users-three', body: 'We bring the design information into the wider conversation with your project team.' },
							{ number: '04', title: 'Refine', icon: 'check-circle', body: 'We stay close to the details that make the finished element feel specific to the room.' },
						].map((step) => (
							<div class="grid grid-cols-[3rem_1fr] gap-5 py-6 millwork-reveal">
								<div class="text-brass"><svg viewBox="0 0 1024 1024" fill="currentColor" class="h-8 w-8" aria-hidden="true">{iconPaths(step.icon).map((path) => <path d={path} />)}</svg><span class="mt-2 block text-[10px] tracking-[0.18em]">{step.number}</span></div>
								<div><h3 class="font-display text-2xl">{step.title}</h3><p class="mt-2 text-sm leading-relaxed text-bone/65">{step.body}</p></div>
							</div>
						))}
					</div>
					<button type="button" class="inquiry-open btn-primary btn-on-dark mt-9 cursor-pointer" data-analytics-event="cta_start_project" data-analytics-location="millwork_process">Start a conversation <span aria-hidden="true">→</span></button>
				</div>
			</div>
		</section>

		<section class="container-editorial grid gap-12 py-20 lg:grid-cols-12 lg:gap-16 lg:py-28" aria-labelledby="millwork-faq">
			<div class="lg:col-span-4 millwork-reveal">
				<p class="eyebrow text-stone">Questions</p>
				<h2 id="millwork-faq" class="font-display mt-5 text-5xl leading-[0.98]">Before the first conversation.</h2>
				<p class="mt-6 text-sm leading-relaxed text-slate">A few practical answers about scope, collaboration and where a millwork brief can begin.</p>
			</div>
			<div class="lg:col-span-7 lg:col-start-6 millwork-reveal"><FAQ faqs={faqs} context="millwork" /></div>
		</section>
	</article>

	<CtaBanner
		title="Discuss a Millwork Project"
		body="Tell us about the room, residence or commercial space you are shaping. We will schedule a confidential discovery session with our design team."
		primaryLabel="Start Your Project"
		primaryAnalyticsEvent="cta_start_project"
		analyticsLocation="millwork_final_cta"
		secondaryLabel="View More Projects"
		secondaryHref="/projects/"
	/>
</Layout>

<style>
	.millwork-scroll-progress { display: none; }
	@supports (animation-timeline: scroll()) {
		.millwork-scroll-progress {
			display: block;
			position: fixed;
			top: 64px;
			left: 0;
			right: 0;
			height: 2px;
			z-index: 40;
			pointer-events: none;
			background: var(--color-coffee);
			transform-origin: left;
			animation: millwork-reading-progress linear;
			animation-timeline: scroll(root block);
		}
		@keyframes millwork-reading-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
		@media (min-width: 1280px) { .millwork-scroll-progress { top: 80px; } }
	}

	.millwork-hero-media {
		height: clamp(250px, 36vw, 590px);
	}
	.millwork-hero-media img {
		object-position: center 58%;
	}
	.millwork-page :is(section, h2)[id] {
		scroll-margin-top: 10rem;
	}
	.millwork-section-nav a:focus-visible,
	.millwork-section-nav button:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
	}
	@media (max-width: 639px) {
		.millwork-hero-media { height: 72vw; max-height: 360px; }
		.millwork-hero-media img { object-position: 64% center; }
	}

	.millwork-reveal {
		transition: opacity 700ms var(--ease-editorial), transform 700ms var(--ease-editorial);
		transition-delay: var(--reveal-delay, 0ms);
	}

	.js .millwork-reveal:not(.is-visible) {
		opacity: 0;
		transform: translateY(18px);
	}

	.js .millwork-reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.millwork-scroll-progress { display: none; animation: none; }
		.js .millwork-reveal:not(.is-visible),
		.js .millwork-reveal.is-visible {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>

<script>
	const revealItems = [...document.querySelectorAll<HTMLElement>('.millwork-reveal')];
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (reducedMotion || !('IntersectionObserver' in window)) {
		for (const item of revealItems) item.classList.add('is-visible');
	} else {
		const observer = new IntersectionObserver((entries, currentObserver) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.classList.add('is-visible');
				currentObserver.unobserve(entry.target);
			}
		}, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });

		for (const item of revealItems) observer.observe(item);
	}
</script>
