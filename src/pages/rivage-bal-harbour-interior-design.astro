---
import { Image, getImage } from 'astro:assets';
import example from '../assets/projects/home-s/web/09.webp';
import millworkDetail from '../assets/projects/home-s/web/06.webp';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import FAQ from '../components/ui/FAQ.astro';
import { faqSchema, schemaScript, serviceSchema, webPageSchema } from '../lib/seo';

const path = '/rivage-bal-harbour-interior-design/';
const city = '/interior-designer-bal-harbour/';
const turnkey = '/turnkey-interior-design-miami/';
const title = 'Rivage Bal Harbour Interior Design | Paula Ambrosio Interior Design';
const heading = 'Interior Design for Rivage Bal Harbour Owners';
const description = 'Interior design for Rivage Bal Harbour owners. Furniture, art and bespoke millwork that turn a finished oceanfront residence into a personal home.';
const breadcrumbs = [{ name: 'Locations', url: '/locations/' }, { name: 'Bal Harbour', url: city }, { name: 'Rivage Bal Harbour', url: path }];
const packages = [
  { name: 'Design + Furniture', text: 'A complete furniture, lighting and art plan with curated selections. We can include pieces by Uultis, a premium Brazilian furniture brand for which Paula serves as Brand Director in the United States, when they suit your home.' },
  { name: 'Design + Furniture + Millwork', text: 'Furnishings and lighting plus bespoke pieces such as media walls, library shelving, bars and display cabinetry.' },
  { name: 'Turnkey Arrival', text: 'We coordinate procurement, receiving, installation and final styling, down to linens and tabletop. If some pieces need more time, we can plan the essentials first.' },
];
const faqs = [
  { question: 'My residence is delivered finished. What does an interior designer add?', answer: 'We make the space work for you with furniture, art, lighting, textiles and custom millwork for the places where you work, relax and entertain.' },
  { question: 'When should I start?', answer: 'Start a few months before closing if you can. Custom furniture and millwork take time to produce. We confirm the schedule after checking scope, lead times and building access.' },
  { question: 'Can you work before I receive the keys?', answer: 'Yes. We start with your floor plan and agree on room priorities, then verify final measurements in person once authorized access is available.' },
  { question: 'Do you coordinate with the building?', answer: 'Yes. We check the association’s requirements and coordinate delivery, elevator reservations and installation within the approved windows.' },
];
const sharePhoto = await getImage({ src: millworkDetail, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 });
---
<Layout ogImage={sharePhoto.src} ogImageAlt="Illuminated stone vanity and custom millwork, a studio portfolio detail" {title} {description} canonical={path}>
  <Fragment slot="head" set:html={schemaScript(webPageSchema({ path, title, description, breadcrumbs }))} />
  <Fragment slot="head" set:html={schemaScript(serviceSchema({ path, name: heading, description, areaServed: ['Bal Harbour'] }))} />
  <Fragment slot="head" set:html={schemaScript(faqSchema(faqs))} />
  <article>
    <section class="border-b border-sand bg-linen py-16 lg:py-24">
      <div class="container-editorial">
        <Breadcrumbs items={breadcrumbs} />
        <div class="mt-8 grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
          <div>
            <p class="eyebrow text-stone">Furniture, art and custom millwork</p>
            <h1 class="font-display mt-4 text-display">{heading}</h1>
            <p class="mt-6 text-lede text-slate">Rivage Bal Harbour was designed for oceanfront living, with generous terraces and finished interiors. We build on that starting point with furniture, art, lighting and bespoke millwork that make the residence yours.</p>
            <a href="/contact/" class="btn-primary mt-8 inline-flex" data-analytics-event="cta_start_project" data-analytics-location="hero">Start Your Rivage Project</a>
          </div>
          <figure>
            <Image src={example} alt="Living area with a walnut television surround, low cabinets and a display niche" widths={[480, 768, 1080]} sizes="(min-width: 1024px) 45vw, calc(100vw - 48px)" format="webp" quality={78} loading="eager" fetchpriority="high" class="block h-auto w-full" />
            <figcaption class="mt-3 text-sm text-slate">Our Boca Raton high-rise project, shown for inspiration. This is not a Rivage residence.</figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section aria-labelledby="interiors-heading" class="container-editorial grid gap-10 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <h2 id="interiors-heading" class="font-display text-4xl">Personal interiors for a finished residence</h2>
        <p class="mt-4 leading-relaxed text-slate">The developer’s residence specifications list finished bedroom wardrobes. Rather than planning a renovation, we start by reviewing what your residence already includes. Then we choose rugs, textiles, decorative lighting and art that work with the existing finishes. Paula Ambrosio Interior Design brings 21 years of experience to that process.</p>
      </div>
      <div>
        <h2 class="font-display text-4xl">Space for family life and entertaining</h2>
        <p class="mt-4 leading-relaxed text-slate">In a generous living room, we plan seating groups that feel close enough for conversation without obstructing the view or the path to the terrace. We size the dining table around how you host, study how daylight reaches art and fabrics, and select bedroom lighting for evening use.</p>
      </div>
    </section>
    <section aria-labelledby="millwork-heading" class="border-y border-sand bg-linen py-16 lg:py-24">
      <div class="container-editorial">
        <h2 id="millwork-heading" class="font-display text-4xl">Bespoke millwork where it adds value</h2>
        <p class="mt-4 max-w-3xl leading-relaxed text-slate">Our in-house team designs and details media walls, home bars, wine displays, libraries and offices to complement your existing finishes. Trusted partners fabricate and install the pieces. Before production we verify dimensions and review access and installation requirements with building management.</p>
      </div>
    </section>
    <section aria-labelledby="packages-heading" class="container-editorial py-16 lg:py-24">
      <h2 id="packages-heading" class="font-display text-4xl">Design, furniture and millwork packages</h2>
      <div class="mt-8 grid gap-8 lg:grid-cols-3">
        {packages.map(({ name, text }) => <div class="border-t border-sand pt-5"><h3 class="font-display text-2xl">{name}</h3><p class="mt-3 leading-relaxed text-slate">{text}</p></div>)}
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
        <li><a href={turnkey} class="underline underline-offset-4">Turnkey Interior Design</a></li>
        <li><a href="/millwork/" class="underline underline-offset-4">Custom Millwork</a></li>
        <li><a href="/design-consultation-miami/" class="underline underline-offset-4">Design Consultation</a></li>
        <li><a href="/penthouse-interior-design-miami-beach/" class="underline underline-offset-4">Penthouse Interior Design</a></li>
        <li><a href={city} class="underline underline-offset-4">Bal Harbour Interior Design</a></li>
      </ul>
    </section>
    <section aria-labelledby="remote-heading" class="border-y border-sand bg-linen py-16 lg:py-24">
      <div class="container-editorial">
        <h2 id="remote-heading" class="font-display text-4xl">For owners abroad and seasonal residents</h2>
        <p class="mt-4 max-w-3xl leading-relaxed text-slate">Share your floor plan and expected closing date before your next trip. We review layouts, selections and 3D views with you remotely, then coordinate local delivery and installation once access and building requirements are confirmed. You can see what is ready before you travel.</p>
      </div>
    </section>
    <section aria-labelledby="faq-heading" class="container-editorial py-16 lg:py-24">
      <h2 id="faq-heading" class="font-display text-3xl">Frequently asked questions</h2>
      <div class="mt-7 max-w-3xl"><FAQ {faqs} context="rivage-bal-harbour" questionHeadings /></div>
    </section>
    <section aria-labelledby="start-heading" class="border-t border-sand bg-linen py-16 lg:py-24">
      <div class="container-editorial">
        <h2 id="start-heading" class="font-display text-4xl">Start Your Rivage Project</h2>
        <p class="mt-4 max-w-3xl leading-relaxed text-slate">Tell us about your residence, your expected closing date and how you want it to feel.</p>
        <a href="/contact/" class="btn-primary mt-7 inline-flex" data-analytics-event="cta_start_project" data-analytics-location="footer">Start Your Rivage Project</a>
        <p class="mt-8 max-w-3xl text-sm text-slate">Paula Ambrosio Interior Design is an independent interior design studio and is not affiliated with the developer, sales team or condominium association of Rivage Bal Harbour. Building names are used for identification only.</p>
      </div>
    </section>
  </article>
</Layout>
