---
const canonical = 'https://www.paulaambrosio.com/home-essence/black-friday/';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<meta name="description" content="Preview the Home Essence Black Friday delivery offers: one 100 mL bottle for $27 or three for $75. Orders are not open yet.">
<link rel="canonical" href={canonical}>
<title>Home Essence | Black Friday Delivery Preview</title>
<style is:global>
:root{--ivory:#f7f1e8;--ink:#29201b;--muted:#5e4d42;--dark:#30211b;--line:#d7c8b8;--serif:Georgia,serif}
*{box-sizing:border-box}body{margin:0;background:var(--ivory);color:var(--ink);font:16px/1.55 Arial,sans-serif}h1,h2,p,figure{margin:0}a{color:inherit}:focus-visible{outline:3px solid #a66c35;outline-offset:4px}
.preview{text-align:center;background:var(--dark);color:#f5e8d8;padding:9px 12px;font-size:11px;font-weight:bold;letter-spacing:.12em;text-transform:uppercase}
.wrap{width:min(1180px,calc(100% - 88px));margin-inline:auto}.brand,.foot{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-block:21px;border-bottom:1px solid var(--line)}.brand a{font:23px var(--serif);text-decoration:none}.brand span,.eyebrow{font-size:11px;font-weight:bold;letter-spacing:.18em;text-transform:uppercase}.eyebrow{color:#825334}
.offer{margin-block:42px 46px;display:grid;grid-template-columns:.98fr 1.02fr;gap:clamp(32px,7.5vw,105px);align-items:center}
h1{font:clamp(72px,8.8vw,128px)/.84 var(--serif);letter-spacing:-.07em;margin:23px 0 20px}.tagline{font:clamp(23px,2.45vw,33px)/1.12 var(--serif)}.desc{margin-top:12px;max-width:35ch;color:var(--muted)}
.deals{display:grid;gap:10px;margin:16px 0 10px}.deal{border:1px solid #cbb2a0;padding:12px}.deal strong{font:38px/1 var(--serif)}.featured{background:#eddbce}.featured small{display:block;color:#9d3429;font-size:10px;letter-spacing:.13em;font-weight:bold}.per{font-size:11px;float:right;margin-top:12px}.intro{grid-column:1;grid-row:1;align-self:end}.order{grid-column:1;grid-row:2;align-self:start}.visual{grid-column:2;grid-row:1/3}.deal p,.shipping,figcaption,.foot{font-size:12px;color:var(--muted)}.deal p{margin:5px 0}.buy{display:inline-flex;align-items:center;justify-content:space-between;gap:10px;min-height:44px;width:100%;border:0;background:var(--dark);color:#fff6e9;padding:0 15px;font-weight:bold;cursor:pointer}.buy:hover{background:#54382a}.single{display:flex;align-items:center;justify-content:space-between;gap:8px}.single strong{font-size:27px}.single .buy{width:auto;white-space:nowrap;background:transparent;color:var(--dark);border:1px solid #99715b}
.visual{position:relative;border:1px solid var(--line);padding:10px}.visual img{display:block;width:100%;height:auto;aspect-ratio:1/1.12;object-fit:contain;background:#ead9c5}.visual figcaption{padding-top:5px}.seal{position:absolute;display:grid;place-content:center;text-align:center;top:5%;right:5%;width:clamp(82px,13vw,140px);aspect-ratio:1;border-radius:50%;background:#9d3429;color:#fff4e3;box-shadow:inset 0 0 0 7px #9d3429,inset 0 0 0 8px #f2d4b8;font-size:clamp(8px,1vw,12px);font-weight:bold;line-height:1.1}.seal strong{font:clamp(26px,4vw,51px) var(--serif)}
.notes{border-top:1px solid var(--line);padding-block:22px;display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;font:25px var(--serif)}.detail{background:#ebdfd0;padding-block:48px}.detail .wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:7vw;align-items:center}.detail img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover}.detail h2{font:clamp(35px,5vw,62px)/1 var(--serif);letter-spacing:-.04em;margin:10px 0 14px}.detail .buy{max-width:290px;margin-top:16px}.foot{flex-wrap:wrap}
dialog{background:var(--ivory);color:var(--ink);width:min(396px,calc(100% - 32px));max-height:90dvh;overflow:auto;border:1px solid var(--line);padding:22px}dialog::backdrop{background:#1b130fcc}dialog h2{font:36px var(--serif);margin-bottom:8px}dl div{display:flex;justify-content:space-between;gap:9px;border-bottom:1px solid var(--line);padding:7px 0}dd{margin:0;white-space:nowrap}.fine{font-size:13px;margin:12px 0;color:var(--muted)}.buy[disabled]{opacity:.55;cursor:not-allowed}.close{min-height:44px;border:0;background:none;color:var(--ink);text-decoration:underline;padding:0;cursor:pointer}
@media(max-width:690px){.wrap{width:calc(100% - 36px)}.brand a{font-size:18px}.brand span{font-size:8px}.offer{grid-template-columns:1fr;gap:17px;margin-block:23px}.visual{grid-column:1;grid-row:2;padding:5px}.visual img{aspect-ratio:1.18}.order{grid-row:3}h1{font-size:clamp(50px,12vw,77px);margin:9px 0 6px}h1 br{display:none}.desc{display:none}.brand{padding-block:13px}.detail{padding-block:24px}.detail .wrap{grid-template-columns:1fr;gap:17px}.detail img{max-height:270px}.notes{font-size:21px}.notes .eyebrow{flex-basis:100%}.single .buy{padding-inline:11px}}
</style>
</head>
<body>
<div class="preview">Delivery preview · No orders or payments</div>
<header class="brand wrap"><a href="#top">Paula Ambrosio Home</a><span>Home Fragrance / 01</span></header>
<main id="top">
<section class="wrap offer" aria-labelledby="offer-title">
<div class="intro"><p class="eyebrow">Black Friday offer</p><h1 id="offer-title">Home <br><em>Essence</em></h1><p class="tagline">Make home unforgettable.</p><p class="desc">A warm, woody room spray with a subtle touch of spice.</p></div>
<figure class="visual"><img src="/images/home-essence/front.webp" width="1024" height="1536" alt="Home Essence room spray in an amber bottle with a gold cap"><div class="seal" aria-label="Black Friday: one bottle for $27">BLACK FRIDAY <strong>$27</strong> ONE BOTTLE</div><figcaption>Campaign image. Packaging shown is a concept.</figcaption></figure>
<div class="order"><div class="deals"><div class="deal featured"><small>BEST VALUE</small><strong>3 for $75</strong><span class="per">$25 EACH</span><p>Three 100 mL bottles. Save $6 vs. three singles.</p><button type="button" class="buy" data-offer="trio">Review the trio <span aria-hidden="true">↗</span></button></div><div class="deal single"><div><strong>1 for $27</strong><p>One 100 mL bottle</p></div><button type="button" class="buy" data-offer="single">Review one</button></div></div><p class="shipping">Delivery only. Shipping is separate. Estimates are not final.</p></div>
</section>
<div class="notes wrap"><span class="eyebrow">Signature notes</span><span>Cardamom</span><span>Amber</span><span>Vetiver</span></div>
<section class="detail"><div class="wrap"><img src="/images/home-essence/signature.webp" width="1122" height="1402" alt="Home Essence in a warm, softly lit setting" loading="lazy"><div><p class="eyebrow">The finishing touch</p><h2>A scent that makes a room feel like home.</h2><p>Warm amber, earthy vetiver and a hint of cardamom. A soft touch of leather gives this woody fragrance depth.</p><button type="button" class="buy" data-offer="trio">Review the trio <span aria-hidden="true">↗</span></button></div></div></section>
</main>
<footer class="foot wrap"><span>Paula Ambrosio Home · Miami, Florida</span><span><a href="/contact/">Contact</a> · <a href="/privacy/">Privacy</a></span></footer>
<dialog aria-labelledby="delivery-title">
<p class="eyebrow">Order review</p><h2 id="delivery-title">Delivery</h2><p id="delivery-items"></p>
<dl><div><dt>Black Friday price</dt><dd id="delivery-price"></dd></div><div><dt>Estimated shipping</dt><dd id="delivery-shipping"></dd></div><div><dt><strong>Estimate before tax</strong></dt><dd><strong id="delivery-total"></strong></dd></div></dl>
<p class="fine">Estimates are for the contiguous U.S. Rates, eligible destinations and delivery timing are not yet confirmed. No pickup.</p>
<button class="buy" disabled type="button">Payment not available in preview</button>
<form method="dialog"><button class="close" autofocus>Back to offers</button></form>
</dialog>
<script>
const choices = { single:{count:1,price:2700,ship:995}, trio:{count:3,price:7500,ship:1495} } as const;
const money = new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'});
const review = document.querySelector('dialog');
const display = (id: string, value: string) => {
  const field = document.getElementById(id);
  if (field) field.textContent = value;
};
document.querySelectorAll<HTMLButtonElement>('button[data-offer]').forEach(button => {
  button.addEventListener('click', () => {
    const offer = button.dataset.offer;
    if (!review || (offer !== 'trio' && offer !== 'single') || review.open) return;
    const {count,price,ship} = choices[offer];
    display('delivery-items', count === 1 ? 'One 100 mL bottle' : 'Three 100 mL bottles');
    display('delivery-price', money.format(price/100));
    display('delivery-shipping', money.format(ship/100));
    display('delivery-total', money.format((price+ship)/100));
    review.showModal();
  });
});
</script>
</body>
</html>
