---
import PaulaProjectGallery from '../components/landings/PaulaProjectGallery.astro';
import head from '../data/landings/change-order-head.html?raw';
import body from '../data/landings/change-order-body.html?raw';
import GoogleConsent from '../components/GoogleConsent.astro';
import OpenAIPixel from '../components/OpenAIPixel.astro';
const offerStart = body.indexOf('<section class="offer ');
const beforeOffer = body.slice(0, offerStart);
const afterOffer = body.slice(offerStart);
---
<!doctype html>
<html lang="pt-BR">
  <head><OpenAIPixel /><Fragment set:html={head} /></head>
  <body><Fragment set:html={beforeOffer} /><PaulaProjectGallery /><Fragment set:html={afterOffer} /><GoogleConsent /></body>
</html>
