---
import PaulaProjectGallery from '../components/landings/PaulaProjectGallery.astro';
import head from '../data/landings/change-order-head.html?raw';
import body from '../data/landings/change-order-body.html?raw';
import GoogleConsent from '../components/GoogleConsent.astro';
import OpenAIPixel from '../components/OpenAIPixel.astro';
import paulaProfile from '../assets/paula-profile.webp';
const correctedBody = body.replace('__CHANGE_ORDER_STUDIO_PORTRAIT__', paulaProfile.src);
const offerStart = correctedBody.indexOf('<section class="offer ');
const beforeOffer = correctedBody.slice(0, offerStart);
const afterOffer = correctedBody.slice(offerStart);
---
<!doctype html>
<html lang="pt-BR">
  <head><OpenAIPixel /><Fragment set:html={head} /></head>
  <body><Fragment set:html={beforeOffer} /><PaulaProjectGallery /><Fragment set:html={afterOffer} /><GoogleConsent /></body>
</html>
<style is:global>
  .paula-video {
    display: grid;
    grid-template-columns: 1fr minmax(220px, 360px);
    gap: 8vw;
    align-items: center;
    background: #fff;
  }
  .paula-video-copy > p:not(.eyebrow) {
    max-width: 470px;
    color: var(--muted);
    margin-top: 28px;
  }
  .paula-video-copy .fine {
    font-size: .68rem;
    line-height: 1.7;
  }
  .paula-video-text-link {
    display: inline-block;
    margin-top: 18px;
    border-bottom: 1px solid var(--ink);
    font-size: .72rem;
    padding-bottom: 5px;
  }
  .paula-video-frame {
    width: min(100%, 360px);
    justify-self: center;
    background: #1b1613;
  }
  .paula-video-frame video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: contain;
  }
  .paula-video-status {
    padding: 9px 12px 11px;
    background: #1b1613;
    color: #d9ccbf;
    font-size: .58rem;
    line-height: 1.4;
  }
  .paula-video-meter {
    position: relative;
    height: 3px;
    margin-top: 7px;
    overflow: hidden;
    background: #493b32;
  }
  .paula-video-meter i {
    position: absolute;
    inset: 0 auto 0 0;
    display: block;
    width: 0;
    transition: width .2s linear;
  }
  .paula-video-buffer {
    background: #806c5c;
  }
  .paula-video-playback {
    background: #ceb297;
  }
  @media (prefers-reduced-motion: reduce) {
    .paula-video-meter i {
      transition: none;
    }
  }
  @media (max-width: 700px) {
    .paula-video {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .paula-video-frame {
      width: min(calc(100vw - 48px), calc(90svh * 9 / 16));
      max-height: 90svh;
      max-height: 90dvh;
    }
    .paula-video-frame video {
      max-height: 90svh;
      max-height: 90dvh;
    }
    .paula-story .story-portrait img {
      aspect-ratio: 2 / 3;
      object-position: 50% top;
    }
  }
</style>
