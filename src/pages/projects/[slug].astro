---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import ProjectGrid from '../../components/projects/FeaturedProjectGrid.astro';
import { webPageSchema, schemaScript, ogFromImage } from '../../lib/seo';
import { getImage } from 'astro:assets';
import type { BreadcrumbEntry } from '../../lib/seo';
import { serviceUrl, locationUrl, projectUrl } from '../../config';
import ProjectLightbox from '../../components/projects/ProjectLightbox.astro';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).filter((p) => !p.data.draft);
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const ogImage = await ogFromImage(project.data.featuredImage);

// The supplied camera originals are prepared once as local WebP files. Vite copies
// these already-optimized files directly, avoiding hundreds of build-time variants.
const sourceImages = import.meta.glob('../../assets/projects/*/web/*.webp', {
	eager: true,
	import: 'default',
	query: '?url',
}) as Record<string, string>;
const sourceGallery = Object.entries(sourceImages)
	.filter(([path]) => path.includes(`/projects/${project.id}/web/`))
	.sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
	.map(([, image]) => image);

const hasOptimizedGallery = sourceGallery.length > 0;
const gallerySources = hasOptimizedGallery
	? sourceGallery
	: await Promise.all(project.data.gallery.map(async (img) => (await getImage({ src: img, width: 1600, quality: 75, format: 'webp' })).src));
const heroSource = hasOptimizedGallery
	? sourceGallery[0]
	: (await getImage({ src: project.data.featuredImage, width: 1920, quality: 75, format: 'webp' })).src;
const heroSlides = hasOptimizedGallery ? [] : gallerySources;
const full = gallerySources;

// §13 project facts row
	const facts = [
	{ label: 'Location', value: project.data.location },
	{ label: 'Property Type', value: project.data.propertyType },
	{ label: 'Category', value: project.data.projectType },
	{ label: 'Year', value: project.data.year ? String(project.data.year) : null },
].filter((f) => f.value);

// §13 SEO subtitle: descriptive context under the visible title
	const subtitle = [project.data.propertyType, project.data.location].filter(Boolean).join(', ');

// Related projects in the same city (excluding this one)
	const related = (await getCollection('projects'))
	.filter((p) => !p.data.draft && p.id !== project.id)
	.filter((p) => project.data.location && p.data.location === project.data.location || p.data.relatedServices?.some((s) => project.data.relatedServices.includes(s)))
	.slice(0, 3);

const breadcrumbs: BreadcrumbEntry[] = [
	{ name: 'Projects', url: '/projects' },
	{ name: project.data.title, url: projectUrl(project.id) },
];
---

<Layout
	title={`${project.data.title} | ${subtitle || 'Interior Design Project'} | Paula Ambrosio Interiors`}
	description={project.data.seoDescription ?? project.data.description}
	canonical={projectUrl(project.id)}
	ogImage={ogImage}
>
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: projectUrl(project.id),
		title: project.data.title,
		description: project.data.seoDescription ?? project.data.description,
		breadcrumbs,
	}))} />

	<article>
		<!-- Project hero carousel -->
		<section class="relative flex min-h-[70vh] items-end bg-ink overflow-hidden" data-hero-carousel>
			{[heroSource, ...heroSlides].map((img, i) => (
				<img
					src={img}
					alt={i === 0 ? (project.data.imageAlt ?? project.data.title) : `${project.data.title}, ${project.data.location ?? 'interior'} ${i + 1}`}
					width="1920"
					height="1280"
					loading={i === 0 ? 'eager' : 'lazy'}
					decoding="async"
					fetchpriority={i === 0 ? 'high' : 'auto'}
					class:list={[
						"absolute inset-0 h-full w-full object-cover opacity-90 transition-opacity duration-1000",
						i === 0 ? 'opacity-100' : 'opacity-0'
					]}
					data-hero-slide
				/>
			))}
			<div class="absolute inset-0 bg-gradient-to-t from-ink/40 via-transparent to-transparent" aria-hidden="true"></div>
			<div class="relative container-editorial pb-14 pt-40 text-bone z-10">
				<Breadcrumbs items={breadcrumbs} tone="light" />
				<h1 class="font-display mt-8 max-w-3xl text-4xl lg:text-6xl">{project.data.title}</h1>
				{subtitle && (
					<p class="mt-4 max-w-2xl text-lg text-bone/80">{subtitle} | Paula Ambrosio Interiors</p>
				)}
			</div>
		</section>

		<!-- Project facts (§13) -->
		{facts.length > 0 && (
			<section class="border-b border-sand bg-bone">
				<dl class="container-editorial grid grid-cols-2 gap-x-8 gap-y-6 py-10 sm:grid-cols-4">
					{facts.map((fact) => (
						<div>
							<dt class="eyebrow text-stone">{fact.label}</dt>
							<dd class="mt-2 text-sm leading-relaxed text-graphite">{fact.value}</dd>
						</div>
					))}
				</dl>
			</section>
		)}

		<!-- Overview + case study body (§13) -->
		<section class="container-editorial grid gap-14 py-20 lg:grid-cols-12 lg:py-28">
			<div class="lg:col-span-4">
				<p class="eyebrow text-stone">Overview</p>
				<p class="mt-4 text-lg leading-relaxed text-graphite">{project.data.description}</p>
				{project.data.services.length > 0 && (
					<div class="mt-10">
						<p class="eyebrow text-stone">Services</p>
						<ul class="mt-4 space-y-2 text-sm text-graphite">
							{project.data.services.map((s) => <li class="border-b border-sand pb-2">{s}</li>)}
						</ul>
					</div>
				)}
				{(project.data.relatedServices.length > 0 || project.data.relatedLocations.length > 0) && (
					<div class="mt-10">
						<p class="eyebrow text-stone">Explore</p>
						<ul class="mt-4 space-y-2 text-sm text-graphite">
							{project.data.relatedServices.map((s) => (
								<li class="border-b border-sand pb-2"><a href={serviceUrl(s)} class="hover:text-stone">{s.replaceAll('-', ' ').replace(' miami', ' Miami').replace(/\b\w/g, (c) => c.toUpperCase())}</a></li>
							))}
							{project.data.relatedLocations.map((l) => (
								<li class="border-b border-sand pb-2"><a href={locationUrl(l)} class="hover:text-stone">Interior Design in {l.replaceAll('-', ' ').replace(/\b\w/g, (c) => c.toUpperCase())}</a></li>
							))}
						</ul>
					</div>
				)}
			</div>
			<div class="prose-editorial lg:col-span-7 lg:col-start-6">
				<Content />
			</div>
		</section>

		<!-- Gallery (§13: 12-25 images when official photography arrives) -->
		{gallerySources.length > 0 && (
			<section class="container-editorial pb-20">
				<div class="columns-1 gap-6 sm:columns-2" style="column-fill: balance;">
					{gallerySources.map((img, i) => (
						<button
							type="button"
							class="group relative mb-6 block w-full cursor-zoom-in overflow-hidden break-inside-avoid"
							data-lightbox-trigger								data-full={full[i]}
								aria-label={`Open image ${i + 1} of ${gallerySources.length} fullscreen`}

						>
							<img
								src={img}
								alt={`${project.data.title}, ${project.data.location ?? 'interior'} detail ${i + 1}`}
								width="1000"
								height="750"
								loading="lazy"
								decoding="async"
								class="w-full object-cover motion-safe:transition-transform motion-safe:duration-700 group-hover:scale-[1.03]"
							/>
							<span
								class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
								aria-hidden="true"
							>
								<svg class="absolute right-4 top-4 h-9 w-9 text-bone drop-shadow-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
							</span>
						</button>
					))}
				</div>
			</section>
		)}


		<!-- Fullscreen lightbox (real-size, uncropped viewing) -->
		{gallerySources.length > 0 && <ProjectLightbox title={project.data.title} full={full} />}

		<!-- Related projects -->
		{related.length > 0 && (
			<section class="bg-linen py-20 lg:py-24">
				<div class="container-editorial">
					<div class="mb-12 flex flex-wrap items-end justify-between gap-6">
						<div>
							<p class="eyebrow text-stone">Continue exploring</p>
							<h2 class="font-display mt-4 text-4xl">More projects</h2>
						</div>
						<a href="/projects" class="eyebrow text-stone underline decoration-brass/60 underline-offset-8 hover:text-ink" data-analytics-event="cta_view_project" data-analytics-location="portfolio">View more projects</a>
					</div>
					<ProjectGrid projects={related} columns={3} />
				</div>
			</section>
		)}
	</article>

	<CtaBanner
		title="Discuss a Similar Project"
		body="Tell us about your residence or property. We will schedule a confidential discovery session with our design team."
		primaryLabel="Start Your Project"
		primaryAnalyticsEvent="cta_start_project"
		analyticsLocation="final_cta"
		secondaryLabel="View More Projects"
		secondaryHref="/projects"
	/>

			<script>
			// Hero carousel auto-slide
			const heroCarousel = document.querySelector('[data-hero-carousel]');
			if (heroCarousel) {
				const slides = heroCarousel.querySelectorAll<HTMLElement>('[data-hero-slide]');
				if (slides.length > 1) {
					let current = 0;
					setInterval(() => {
						slides[current].classList.replace('opacity-100', 'opacity-0');
						current = (current + 1) % slides.length;
						slides[current].classList.replace('opacity-0', 'opacity-100');
					}, 5000);
				}
			}

			const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
			const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]')];
			if (dialog && triggers.length > 0) {
				const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
				const counter = dialog.querySelector<HTMLElement>('[data-lightbox-counter]')!;
				// The grid fallback src is the full-size optimized original. Reuse it so the
				// lightbox shows the uncropped image at (at least) its real size.
				const sources = triggers.map((btn) => {
				const gridImg = btn.querySelector('img');
				return { src: btn.dataset.full ?? gridImg?.getAttribute('src') ?? '', alt: gridImg?.getAttribute('alt') ?? '' };
				});
				const total = sources.length;
				let current = 0;

				const show = (index: number) => {
				current = ((index % total) + total) % total;
				img.src = sources[current].src;
				img.alt = sources[current].alt;
				counter.textContent = `${current + 1} / ${total}`;
				// Preload neighbors for instant navigation
				for (const delta of [-1, 1]) {
					const next = sources[((current + delta) % total + total) % total];
					if (next.src) new Image().src = next.src;
				}
				};

				for (const [i, btn] of triggers.entries()) {
				btn.addEventListener('click', () => {
					show(i);
					dialog.showModal();
				});
				}

				dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
				dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
				dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));

				// Click on empty backdrop closes
				dialog.addEventListener('click', (e) => {
				if (e.target === dialog) dialog.close();
				});

				dialog.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
				if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
				});

				// Touch swipe navigation
				let startX = 0;
				dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
				dialog.addEventListener('touchend', (e) => {
				const dx = e.changedTouches[0].clientX - startX;
				if (Math.abs(dx) > 48) show(dx < 0 ? current + 1 : current - 1);
				}, { passive: true });
			}
		</script>
</Layout>
