---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { webPageSchema, breadcrumbSchema, schemaScript } from '../../lib/seo';
import type { BreadcrumbEntry } from '../../lib/seo';

const projects = (await getCollection('projects'))
	.filter((p) => !p.data.draft)
	.sort(
	(a, b) => (b.data.year ?? 0) - (a.data.year ?? 0),
);

const breadcrumbs: BreadcrumbEntry[] = [{ name: 'Projects', url: '/projects' }];
// Browsing tabs: fine-grained project types grouped into three editorial buckets.
const TABS: { label: string; types: string[] }[] = [
	{ label: 'Residential', types: ['Residential', 'Penthouse'] },
	{ label: 'Commercial', types: ['Commercial', 'Hospitality'] },
	{ label: 'Renders', types: ['Renders'] },
];
const tabs = [
	{ label: 'All', types: null as string[] | null },
	...TABS.filter((tab) => projects.some((project) => tab.types.includes(project.data.projectType ?? ''))),
];
---

<Layout
	title="Interior Design Portfolio | Projects in Miami & South Florida"
	description="Selected residential and hospitality projects and 3D render studies by Paula Ambrosio Interiors, full-service luxury interior design across Miami and South Florida."
	canonical="/projects"
>
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: '/projects',
		title: 'Projects | Paula Ambrosio Interiors',
		description: 'Selected luxury interior design projects across Miami and South Florida.',
		breadcrumbs,
	}))} />

	<section class="container-editorial pt-16 pb-14 lg:pt-24">
		<Breadcrumbs items={breadcrumbs} />
		<p class="eyebrow mt-10 text-stone">Selected Work</p>
		<h1 class="font-display mt-4 max-w-2xl text-display">Projects shaped by architecture, light and material.</h1>
		<p class="mt-6 max-w-xl text-lede text-slate">
			Residences, penthouses and hospitality spaces across Miami and South Florida, each delivered
			from first sketch to final styling.
		</p>
	</section>

	<section class="container-editorial pb-24">
		<div class="mb-12 flex flex-wrap items-center gap-x-8 gap-y-3 border-y border-sand py-5" aria-label="Filter projects by type">
			<p class="eyebrow mr-2 text-stone">View by</p>
			{tabs.map((tab, index) => (
				<button type="button" class:list={['project-filter eyebrow border-b border-transparent pb-1 text-slate transition-colors hover:text-ink', index === 0 && 'is-active border-stone text-ink']} data-filter={tab.types ? tab.types.join(',') : 'All'} aria-pressed={index === 0 ? 'true' : 'false'}>{tab.label}</button>
			))}
		</div>
		<div id="project-grid">
			<ProjectGrid projects={projects} columns={3} />
		</div>
	</section>

	<script>
		const filters = document.querySelectorAll<HTMLButtonElement>('.project-filter');
		const cards = document.querySelectorAll<HTMLElement>('#project-grid article');
		filters.forEach((filter) => filter.addEventListener('click', () => {
			const value = filter.dataset.filter ?? 'All';
			filters.forEach((item) => { item.classList.toggle('is-active', item === filter); item.setAttribute('aria-pressed', item === filter ? 'true' : 'false'); });
			cards.forEach((card) => { const category = card.dataset.category ?? ''; card.hidden = value !== 'All' && !value.split(',').includes(category); });
		}));
	</script>

	<CtaBanner />
</Layout>
