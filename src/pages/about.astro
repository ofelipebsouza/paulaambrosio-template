---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import CtaBanner from '../components/ui/CtaBanner.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { webPageSchema, personSchema, schemaScript } from '../lib/seo';
import type { BreadcrumbEntry } from '../lib/seo';
import paulaProfile from '../assets/paula-profile.webp';

const breadcrumbs: BreadcrumbEntry[] = [{ name: 'About', url: '/about' }];
---

<Layout
	title="About Paula Ambrosio | Founder & Principal Designer"
	description="Paula Ambrosio is an interior designer, entrepreneur and cofounder of Paula Ambrosio Interior Design, a luxury studio in Miami with 21 years in the profession and more than 2,000 completed projects."
	canonical="/about"
>
	<Fragment slot="head" set:html={schemaScript(personSchema())} />
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: '/about',
		title: 'About | Paula Ambrosio Interiors',
		description: 'The studio and principal designer behind Paula Ambrosio Interiors: 21 years, 2,000 projects and a turnkey process built for Miami.',
		breadcrumbs,
	}))} />

	<section class="container-editorial pt-16 pb-14 lg:pt-24">
		<Breadcrumbs items={breadcrumbs} />
		<p class="eyebrow mt-10 text-stone">The Studio</p>
		<h1 class="font-display mt-4 max-w-3xl text-display">
			Design guided by experience, delivered with precision.
		</h1>
	</section>

	<section class="container-editorial grid gap-14 pb-24 lg:grid-cols-12">
		<div class="lg:col-span-4">
			<div class="overflow-hidden border border-sand">
				<Image
					src={paulaProfile}
					alt="Paula Ambrosio, Founder and Principal Designer of Paula Ambrosio Interior Design"
					widths={[400, 600, 800]}
					sizes="(min-width: 1024px) 33vw, 50vw"
					loading="lazy"
					quality={75}
					decoding="async"
					class="aspect-[4/5] w-full object-cover"
				/>
			</div>
			<p class="eyebrow mt-6 text-stone">Paula Ambrosio</p>
			<p class="mt-2 text-lg text-graphite">Principal Designer &amp; Cofounder</p>
			<p class="mt-4 text-sm leading-relaxed text-slate">
				Trilingual in Portuguese, English and Spanish.
			</p>
		</div>
		<div class="prose-editorial lg:col-span-7 lg:col-start-6">
			<h2>Our Story</h2>
			<p>
				Paula Ambrosio is an interior designer, entrepreneur and cofounder of Paula Ambrosio Interior Design, a luxury studio in Miami that she leads alongside her sister and business partner, Amanda Ambrosio. Her career began in Rio de Janeiro with the founding of Studio Decore, now in its twenty-first year of operation. Over 21 years in the profession, she has delivered more than 2,000 projects.
			</p>
			<p>
				Based in the United States for the past 11 years, Paula has built a South Florida practice centered on luxury residential work with turnkey delivery: the client receives a complete home, furnished, styled and ready to live in. That model speaks directly to a client profile that keeps growing in Miami: the buyer who purchases a property from a distance, often from another country, and needs to trust the entire process to a studio that coordinates everything from concept to final installation. While our studio is based in Miami, our projects extend worldwide, serving clients across the United States, Brazil, Europe and beyond.
			</p>

			<h2>How We Work</h2>
			<p>
				The work spans concept development, material selection, specification, procurement, logistics, installation and final styling, with Amanda and Paula combining creativity, technical precision, clear communication and strong project coordination. Our turnkey express model can deliver a fully furnished, move-in-ready residence in as little as 40 days.
			</p>
			<p>
				Whether you are buying a home in Miami, renovating a luxury residence, furnishing a new condo or investing in South Florida property from abroad, we manage the entire process so you can walk into a finished home.
			</p>

			<h2>Hospitality &amp; Commercial</h2>
			<p>
				Beyond residential, the studio develops boutique commercial and hospitality projects, including FF&amp;E specification for hotel work in Miami.
			</p>

			<h2>Partnerships &amp; Product</h2>
			<p>
				Paula is the U.S. brand ambassador for Uultis, the premium furniture brand from Grupo Herval, a role through which she leads catalog curation and editorial content for the American market, including the <em>Vivir la Vida de Miami</em> collection. At Salone del Mobile in Milan in 2026 she launched Via Milano, a relationship program for designers presented to a selected group of professionals at Duomo 21.
			</p>
			<p>
				In parallel she develops her own products: PEDRA, a collection of decorative and functional hardware cut from natural stone, and two outdoor furniture collections, Palm Beach and Mediterranean. She is also a co-owner of X Studio Miami, a content production studio with podcast rooms and an infinity wall.
			</p>

			<h2>Teaching</h2>
			<p>
				Paula creates educational material for other designers on turnkey pricing, contracts and scope change management, sharing the lessons that two decades and 2,000 projects have taught about building a predictable, trust-driven design business.
			</p>

			<h2>Known For</h2>
			<p>
				Timeless, contemporary and sophisticated interiors: personalized spaces that reflect each client's lifestyle while combining beauty, functionality, comfort and lasting design. We work with both American and international clients looking for an experienced interior designer in Miami to manage their residence, vacation home, investment property or complete renovation.
			</p>
		</div>
	</section>

	<CtaBanner />
</Layout>
