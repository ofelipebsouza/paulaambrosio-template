---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import CtaBanner from '../components/ui/CtaBanner.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { webPageSchema, personSchema, schemaScript } from '../lib/seo';
import type { BreadcrumbEntry } from '../lib/seo';
import paulaProfile from '../assets/paula-profile.webp';

const breadcrumbs: BreadcrumbEntry[] = [{ name: 'About', url: '/about' }];
---

<Layout
	title="About Paula Ambrosio | Founder & Principal Designer"
	description="Paula Ambrosio is the founder and principal designer of Paula Ambrosio Interiors, a Miami luxury interior design studio serving residences and hospitality spaces across South Florida."
	canonical="/about"
>
	<Fragment slot="head" set:html={schemaScript(personSchema())} />
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: '/about',
		title: 'About | Paula Ambrosio Interiors',
		description: 'The studio and principal designer behind Paula Ambrosio Interiors.',
		breadcrumbs,
	}))} />

	<section class="container-editorial pt-16 pb-14 lg:pt-24">
		<Breadcrumbs items={breadcrumbs} />
		<p class="eyebrow mt-10 text-stone">The Studio</p>
		<h1 class="font-display mt-4 max-w-3xl text-display">
			Considered interiors, led by a single design vision.
		</h1>
	</section>

	<section class="container-editorial grid gap-14 pb-24 lg:grid-cols-12">
		<div class="lg:col-span-4">
			<div class="overflow-hidden border border-sand">
				<Image
					src={paulaProfile}
					alt="Paula Ambrosio, Founder and Principal Designer of Paula Ambrósio Interior Design"
					widths={[400, 600, 800]}
					sizes="(min-width: 1024px) 33vw, 50vw"
					loading="lazy"
					quality={75}
					decoding="async"
					class="aspect-[4/5] w-full object-cover"
				/>
			</div>
			<p class="eyebrow mt-6 text-stone">Paula Ambrósio</p>
			<p class="mt-2 text-lg text-graphite">Founder &amp; Principal Designer</p>
		</div>
		<div class="prose-editorial lg:col-span-7 lg:col-start-6">
			<p>
				Paula Ambrósio Interior Design is a luxury interior design studio in Miami specializing in high-end residential interior design, home renovations, custom interiors and full-service turnkey projects throughout Miami and South Florida.
			</p>
			<p>
				Our story began 21 years ago in Rio de Janeiro, Brazil, when sisters Paula and Amanda Ambrósio founded Studio Decore. Together, they built a strong foundation in residential interior design, renovations, custom furniture, material selection and complete home transformations.
			</p>
			<p>
				Ten years ago, Paula Ambrósio founded Paula Ambrósio Interior Design in Miami, bringing her international design experience and sophisticated aesthetic to the South Florida market. As the Miami interior design studio expanded, Paula invited Amanda to move to Miami and join her once again, bringing their experience and complementary expertise together under the Paula Ambrósio brand.
			</p>

			<h2>Today</h2>
			<p>
				Paula Ambrósio Interior Design provides full-service luxury interior design in Miami, Miami Beach, Aventura, Sunny Isles, Bal Harbour, Brickell, Coral Gables, Fort Lauderdale, Boca Raton, Palm Beach and throughout South Florida.
			</p>
			<p>
				The studio specializes in luxury residential interior design, home remodeling, condo renovations, kitchen and bathroom design, space planning, custom millwork, custom furniture, lighting design, furniture selection, material and finish selections, procurement, installation, styling and turnkey interior design services.
			</p>

			<h2>Our turnkey approach</h2>
			<p>
				Our turnkey approach allows clients to have one experienced interior design team managing the project from the initial concept through the final installation. From architectural and design decisions to furniture, lighting, accessories and final styling, every detail is carefully coordinated to create a sophisticated, functional and move-in-ready home.
			</p>

			<h2>Known for</h2>
			<p>
				Known for timeless, contemporary and sophisticated interiors, Paula Ambrósio Interior Design creates personalized spaces that reflect each client's lifestyle while combining beauty, functionality, comfort and lasting design.
			</p>
			<p>
				We work with both American and international clients looking for an experienced interior designer in Miami to manage their residence, vacation home, investment property or complete renovation.
			</p>
			<p>
				Whether you are buying a home in Miami, renovating a luxury residence, furnishing a new condo or looking for a turnkey interior designer in South Florida, Paula Ambrósio Interior Design provides a seamless experience from concept to completion.
			</p>
		</div>
	</section>

	<CtaBanner />
</Layout>
