---
/**
 * /admin/ — the studio pipeline.
 *
 * On-demand, session-guarded, `noindex`. The first paint is fully server
 * rendered (the team should never stare at spinner-only KPIs), and a small
 * script keeps it live: metrics, leads, follow-up queue and the Hermes report
 * refresh every 30 seconds.
 *
 * Every value shown here is either authored by the studio or already stored by
 * the API — nothing on this page is indexed, cached or linked from the site.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { readSession } from '../../lib/crm/auth';
import { buildMetrics, responseRate } from '../../lib/crm/metrics';
import {
	BOARD_STATUSES,
	CLOSED_STATUSES,
	LEAD_STATUSES,
	OPEN_STATUSES,
	STATUS_LABELS,
	normalizeStatus,
	type CrmLead,
	type CrmTask,
	type LeadStatus,
} from '../../lib/crm/schema';
import {
	allLeads,
	dailyCounts,
	getReport,
	ledgerCounts,
	listBlocks,
	listTasks,
	storeStatus,
} from '../../lib/crm/store';

export const prerender = false;

if (!readSession(Astro.request)) return Astro.redirect('/admin/login/');

const now = Date.now();
const [leads, tasks, daily, report, ledger, blocks] = await Promise.all([
	allLeads(),
	listTasks(),
	dailyCounts(30),
	getReport(),
	ledgerCounts(14),
	listBlocks(),
]);
const metrics = buildMetrics({ leads, tasks, daily, now });
const storage = storeStatus();
const answered24h = responseRate(leads, 24, now);
const recent = leads.slice(0, 25);
const queue = tasks.filter((task) => task.state === 'open').slice(0, 8);
const chartMax = Math.max(1, ...Object.values(daily));
const chartDays = Object.entries(daily);
const funnelMax = Math.max(1, ...LEAD_STATUSES.map((status) => metrics.byStatus[status]));

const STATUS_COLORS: Record<LeadStatus, string> = {
	novo: 'bg-brass',
	atendimento_ia: 'bg-stone',
	atendimento_humano: 'bg-coffee',
	reuniao_agendada: 'bg-graphite',
	reuniao_realizada: 'bg-slate',
	proposta: 'bg-sand',
	fechado: 'bg-ink',
	perdido: 'bg-mist',
};

/** First paint of the board: the client script re-renders it on every poll. */
const boardColumns = BOARD_STATUSES.map((status) => ({
	status,
	label: STATUS_LABELS[status],
	color: STATUS_COLORS[status],
	items: leads.filter((lead) => normalizeStatus(lead.status) === status).slice(0, 20),
}));

const closedTabs = CLOSED_STATUSES.map((status) => ({
	status,
	label: STATUS_LABELS[status],
	count: leads.filter((lead) => normalizeStatus(lead.status) === status).length,
	items: leads.filter((lead) => normalizeStatus(lead.status) === status).slice(0, 30),
}));

const ledgerTotals = ledger.reduce(
	(acc, day) => {
		for (const [key, value] of Object.entries(day.fields)) {
			acc[key as keyof (typeof day)['fields']] += value;
		}
		return acc;
	},
	{
		attempts: 0,
		accepted: 0,
		rejected_validation: 0,
		rejected_rate: 0,
		honeypot: 0,
		turnstile: 0,
		smtp_failed: 0,
		blocked: 0,
	},
);

const STATUS_OPTIONS = LEAD_STATUSES.map((value) => ({ value, label: STATUS_LABELS[value] }));

/** Queue wording: "due in 5h" for the future, "late 30h" once it passes. */
function dueLabel(ts: number): string {
	if (ts > now) return `due ${relative(ts)}`;
	const hours = Math.max(1, Math.round((now - ts) / 3_600_000));
	return hours < 24 ? `late ${hours}h` : `late ${Math.round(hours / 24)}d`;
}

function fmtDate(ts: number): string {
	return new Date(ts).toLocaleString('en-US', {
		month: 'short',
		day: 'numeric',
		hour: '2-digit',
		minute: '2-digit',
	});
}

function relative(ts: number): string {
	const diff = now - ts;
	const abs = Math.abs(diff);
	const hours = Math.floor(abs / 3_600_000);
	const suffix = diff > 0 ? ' ago' : '';
	const prefix = diff > 0 ? '' : 'in ';
	if (hours < 1) return diff > 0 ? 'just now' : `in ${Math.max(1, Math.round(abs / 60_000))} min`;
	if (hours < 24) return `${prefix}${hours}h${suffix}`;
	return `${prefix}${Math.floor(hours / 24)}d${suffix}`;
}

const kpis = [
	{ key: 'last30', label: 'Leads · 30 days', value: String(metrics.last30), note: `${metrics.total} all time` },
	{
		key: 'awaitingReply',
		label: 'Awaiting reply',
		value: String(metrics.awaitingReply),
		note: `${metrics.open} in pipeline`,
	},
	{
		key: 'responseHours',
		label: 'Avg. first response',
		value: metrics.avgFirstResponseHours === null ? '—' : `${metrics.avgFirstResponseHours.toFixed(1)} h`,
		note: `${Math.round(answered24h * 100)}% answered in 24 h`,
	},
	{
		key: 'conversion',
		label: 'Conversion · won',
		value: `${Math.round(metrics.conversionRate * 100)}%`,
		note: 'of closed leads',
	},
	{ key: 'today', label: 'New today', value: String(metrics.today), note: 'since midnight (UTC)' },
	{
		key: 'overdue',
		label: 'Follow-ups late',
		value: String(metrics.tasksOverdue),
		note: `${metrics.tasksOpen} open tasks`,
	},
];
---

<AdminLayout title="Pipeline">
	<!-- Page head ------------------------------------------------------------ -->
	<div class="flex flex-col gap-6 border-b border-sand/60 pb-8 lg:flex-row lg:items-end lg:justify-between">
		<div>
			<p class="eyebrow text-stone">Studio CRM</p>
			<h1 class="mt-3 font-display text-4xl lg:text-5xl">Pipeline</h1>
			<p class="mt-4 max-w-xl text-sm leading-relaxed text-slate">
				Every inquiry that reaches the studio, in the order it arrived — with follow-ups, conversion and the
				live Hermes report.
			</p>
		</div>

		<div class="flex flex-wrap items-center gap-3">
			<div class="flex border border-sand bg-white" role="group" aria-label="Pipeline view">
				<button
					type="button"
					id="crm-view-board"
					class="eyebrow px-3 py-2 text-ink bg-bone"
					aria-pressed="true"
				>
					Board
				</button>
				<button
					type="button"
					id="crm-view-table"
					class="eyebrow px-3 py-2 text-slate hover:text-ink"
					aria-pressed="false"
				>
					Table
				</button>
			</div>
			<span
				class:list={[
					'eyebrow border px-3 py-2',
					storage.backend === 'upstash' ? 'border-sand bg-white text-stone' : 'border-coffee/40 bg-white text-coffee',
				]}
				title={storage.backend === 'upstash' ? 'Leads are stored in Upstash Redis' : 'In-process storage only'}
			>
				{storage.backend === 'upstash' ? 'Storage · Redis' : 'Storage · in memory'}
			</span>
			<button id="crm-remind" type="button" class="eyebrow border border-sand bg-white px-3 py-2 text-slate transition-colors hover:border-brass hover:text-ink">
				Send reminders
			</button>
			<a href="/api/crm/export/?format=csv" class="eyebrow border border-sand bg-white px-3 py-2 text-slate transition-colors hover:border-brass hover:text-ink">
				Export CSV
			</a>
			<button id="crm-refresh" type="button" class="btn-primary">Refresh</button>
		</div>
	</div>

	<!-- KPI strip ------------------------------------------------------------ -->
	<section aria-label="Key metrics" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
		{kpis.map((kpi) => (
			<div class="border border-sand/70 bg-white p-5">
				<p class="eyebrow text-stone">{kpi.label}</p>
				<p class="mt-3 font-display text-4xl" data-kpi={kpi.key}>{kpi.value}</p>
				<p class="mt-1 text-xs text-mist" data-kpi-note={kpi.key}>{kpi.note}</p>
			</div>
		))}
	</section>

	<!-- Chart + funnel ------------------------------------------------------- -->
	<section class="mt-8 grid items-start gap-6 lg:grid-cols-3">
		<div class="border border-sand/70 bg-white p-6 lg:col-span-2">
			<div class="flex items-baseline justify-between gap-4">
				<p class="eyebrow text-stone">Arrivals · last 30 days</p>
				<p class="text-xs text-mist">peak {chartMax} / day</p>
			</div>
			<div class="mt-6" id="crm-chart">
				<svg viewBox="0 0 600 170" class="h-52 w-full" role="img" aria-label="Daily lead volume">
					{chartDays.map(([day, count], index) => {
						const slot = 600 / chartDays.length;
						const x = index * slot + (slot - 14) / 2;
						const h = (count / chartMax) * 130;
						return <rect x={x} y={140 - h} width="14" height={Math.max(count > 0 ? 2 : 0, h)} class="fill-stone" rx="1"><title>{day}: {count}</title></rect>;
					})}
					<line x1="0" y1="140" x2="600" y2="140" class="stroke-sand" stroke-width="1"></line>
					<text x="0" y="162" class="fill-mist text-[10px]">{chartDays[0]?.[0] ?? ''}</text>
					<text x="600" y="162" text-anchor="end" class="fill-mist text-[10px]">{chartDays[chartDays.length - 1]?.[0] ?? ''}</text>
				</svg>
			</div>
		</div>

		<div class="border border-sand/70 bg-white p-6">
			<p class="eyebrow text-stone">Pipeline by status</p>
			<ul class="mt-6 space-y-4" id="crm-funnel">
				{LEAD_STATUSES.map((status) => {
					const count = metrics.byStatus[status];
					return (
						<li>
							<div class="flex items-baseline justify-between gap-3">
								<span class="eyebrow text-slate">{STATUS_LABELS[status]}</span>
								<span class="font-display text-2xl">{count}</span>
							</div>
							<div class="mt-2 h-1.5 w-full bg-sand/30">
								<div class={`h-full ${STATUS_COLORS[status]}`} style={`width:${(count / funnelMax) * 100}%`} />
							</div>
						</li>
					);
				})}
			</ul>
			<p class="mt-6 border-t border-sand/60 pt-4 text-xs leading-relaxed text-mist">
				Moving a lead out of <em>New</em> records its first response and closes its follow-up tasks.
			</p>
		</div>
	</section>

	<!-- Hermes + queue ------------------------------------------------------- -->
	<section class="mt-6 grid gap-6 lg:grid-cols-2">
		<div class="border border-sand/70 bg-white p-6">
			<div class="flex items-baseline justify-between gap-4">
				<p class="eyebrow text-stone">Hermes · live report</p>
				<p class="text-xs text-mist" id="crm-report-time" data-generated-at={report?.generatedAt ?? 0}>
					{report ? `generated ${relative(report.generatedAt)}` : 'no report yet'}
				</p>
			</div>

			<div id="crm-report">
				{report ? (
					<>
						<p class="mt-5 text-base leading-relaxed text-graphite" id="crm-report-summary">{report.summary}</p>
						{report.highlights.length > 0 && (
							<ul class="mt-5 space-y-2" id="crm-report-highlights">
								{report.highlights.map((item) => (
									<li class="flex gap-3 text-sm text-slate">
										<span class="mt-2 h-1 w-1 shrink-0 rotate-45 bg-brass" aria-hidden="true"></span>
										<span>{item}</span>
									</li>
								))}
							</ul>
						)}
						{report.actions.length > 0 && (
							<div class="mt-6 border-t border-sand/60 pt-4">
								<p class="eyebrow text-stone">Suggested actions</p>
								<ol class="mt-3 space-y-2" id="crm-report-actions">
									{report.actions.map((item, index) => (
										<li class="text-sm text-graphite">
											<span class="mr-2 font-display text-lg text-stone">{index + 1}.</span>{item}
										</li>
									))}
								</ol>
							</div>
						)}
					</>
				) : (
					<p class="mt-5 text-sm leading-relaxed text-mist">
						Waiting for Hermes. The moment the agent posts a report it appears here — until then the
						KPIs above are computed directly from the pipeline.
					</p>
				)}
			</div>
		</div>

		<div class="border border-sand/70 bg-white p-6">
			<div class="flex items-baseline justify-between gap-4">
				<p class="eyebrow text-stone">Follow-up queue</p>
				<p class="text-xs text-mist"><span id="crm-queue-overdue">{metrics.tasksOverdue}</span> late</p>
			</div>

			<ul class="mt-5 space-y-1" id="crm-queue">
				{queue.length === 0 && (
					<li class="py-6 text-sm text-mist">Nothing waiting. Every lead has been answered.</li>
				)}
				{queue.map((task: CrmTask) => (
					<li class="flex items-start justify-between gap-4 border-b border-sand/50 py-3 last:border-0" data-task={task.id}>
						<div class="min-w-0">
							<p class="truncate text-sm text-graphite">{task.title}</p>
							<p class:list={['mt-1 text-xs', task.dueAt <= now ? 'text-coffee' : 'text-mist']}>
								{dueLabel(task.dueAt)}
							</p>
						</div>
						<div class="flex shrink-0 gap-2">
							<button type="button" class="eyebrow border border-sand px-2 py-1 text-slate transition-colors hover:border-brass hover:text-ink" data-task-open={task.leadId}>
								Open
							</button>
							<button type="button" class="eyebrow border border-sand px-2 py-1 text-slate transition-colors hover:border-brass hover:text-ink" data-task-done={task.id}>
								Done
							</button>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- Board ---------------------------------------------------------------- -->
	<section id="crm-board" class="mt-6" aria-label="Pipeline board">
		<div class="flex items-baseline justify-between gap-4 border-b border-sand/60 pb-4">
			<p class="eyebrow text-stone">Board · drag a card to move it, or use its menu</p>
			<p class="text-xs text-mist"><span id="crm-board-open">{metrics.open}</span> open</p>
		</div>

		<div class="mt-5 flex gap-4 overflow-x-auto pb-4" id="crm-columns">
			{boardColumns.map((column) => (
				<div class="flex w-64 shrink-0 flex-col" data-column={column.status}>
					<div class="flex items-center justify-between border border-sand/70 bg-white px-4 py-3">
						<span class="flex items-center gap-2">
							<span class={`h-2 w-2 ${column.color}`} aria-hidden="true"></span>
							<span class="eyebrow text-slate">{column.label}</span>
						</span>
						<span class="font-display text-xl" data-column-count={column.status}>{column.items.length}</span>
					</div>
					<div class="mt-3 flex min-h-24 flex-col gap-3" data-dropzone={column.status}>
						{column.items.map((lead) => (
							<article
								class="cursor-grab border border-sand/70 bg-white p-4 transition-colors hover:border-brass active:cursor-grabbing"
								data-card={lead.id}
								data-card-status={normalizeStatus(lead.status)}
								draggable="true"
								tabindex="0"
								aria-label={`${lead.name} — ${STATUS_LABELS[normalizeStatus(lead.status)]}`}
							>
								<div class="flex items-start justify-between gap-2">
									<p class="text-sm font-medium text-ink">{lead.name}</p>
									{lead.geo?.country && <span class="text-xs text-mist">{lead.geo.country}</span>}
								</div>
								<p class="mt-1 line-clamp-2 text-xs text-slate">{lead.service || lead.location || '—'}</p>
								<div class="mt-3 flex items-center justify-between gap-2">
									<span class="text-[10px] uppercase tracking-wider text-mist">{relative(lead.createdAt)}</span>
									<label class="sr-only" for={`move-${lead.id}`}>Move {lead.name}</label>
									<select
										id={`move-${lead.id}`}
										data-card-move={lead.id}
										class="border border-sand bg-bone px-1.5 py-1 text-[11px] focus:border-brass focus:outline-none"
									>
										{LEAD_STATUSES.map((value) => (
											<option value={value} selected={value === normalizeStatus(lead.status)}>
												{STATUS_LABELS[value]}
											</option>
										))}
									</select>
								</div>
								{normalizeStatus(lead.status) === 'atendimento_ia' && (
									<button
										type="button"
										class="eyebrow mt-3 w-full border border-sand px-2 py-1.5 text-slate transition-colors hover:border-brass hover:text-ink"
										data-transfer-human={lead.id}
									>
										Transfer to human
									</button>
								)}
							</article>
						))}
						{column.items.length === 0 && (
							<p class="border border-dashed border-sand/70 px-4 py-6 text-center text-xs text-mist">
								Drop a lead here
							</p>
						)}
					</div>
				</div>
			))}
		</div>

		<div class="mt-4 flex flex-wrap gap-3 border-t border-sand/60 pt-4" id="crm-closed-tabs">
			{closedTabs.map((tab) => (
				<button
					type="button"
					class="eyebrow border border-sand bg-white px-3 py-2 text-slate transition-colors hover:border-brass hover:text-ink"
					data-closed-tab={tab.status}
					aria-expanded="false"
				>
					{tab.label} · {tab.count}
				</button>
			))}
		</div>
		<div class="mt-3 hidden space-y-2" id="crm-closed-list"></div>
	</section>

	<!-- Leads ---------------------------------------------------------------- -->
	<section id="crm-leads-section" class="mt-6 border border-sand/70 bg-white hidden">
		<div class="flex flex-col gap-4 border-b border-sand/60 p-6 lg:flex-row lg:items-center lg:justify-between">
			<div>
				<p class="eyebrow text-stone">Leads</p>
				<p class="mt-2 text-sm text-slate"><span id="crm-lead-count">{metrics.total}</span> in the pipeline</p>
			</div>

			<div class="flex flex-col gap-3 sm:flex-row">
				<label class="sr-only" for="crm-search">Search leads</label>
				<input
					id="crm-search"
					type="search"
					placeholder="Search name, email, service…"
					class="w-full border border-sand bg-white px-4 py-2.5 text-sm placeholder:text-mist focus:border-brass focus:outline-none sm:w-72"
				/>
				<label class="sr-only" for="crm-filter">Filter by status</label>
				<select
					id="crm-filter"
					class="border border-sand bg-white px-4 py-2.5 text-sm focus:border-brass focus:outline-none"
				>
					<option value="">All statuses</option>
					{STATUS_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}
				</select>
			</div>
		</div>

		<div class="overflow-x-auto">
			<table class="w-full min-w-[720px] text-left text-sm">
				<thead>
					<tr class="border-b border-sand/60">
						<th class="eyebrow px-6 py-4 text-slate">Received</th>
						<th class="eyebrow px-6 py-4 text-slate">Lead</th>
						<th class="eyebrow px-6 py-4 text-slate">Service</th>
						<th class="eyebrow px-6 py-4 text-slate">Location</th>
						<th class="eyebrow px-6 py-4 text-slate">Status</th>
						<th class="eyebrow px-6 py-4 text-slate">Source</th>
						<th class="eyebrow px-6 py-4 text-slate">First reply</th>
					</tr>
				</thead>
				<tbody id="crm-leads" class="divide-y divide-sand/50">
					{recent.length === 0 && (
						<tr><td colspan="7" class="px-6 py-10 text-center text-sm text-mist">
							No leads yet. The first inquiry will appear here as soon as it arrives.
						</td></tr>
					)}
					{recent.map((lead: CrmLead) => (
						<tr
							class="cursor-pointer transition-colors hover:bg-bone focus-visible:bg-bone"
							data-lead-row={lead.id}
							tabindex="0"
							aria-label={`Open ${lead.name}`}
						>
							<td class="whitespace-nowrap px-6 py-4 text-slate">{fmtDate(lead.createdAt)}</td>
							<td class="px-6 py-4">
								<p class="text-graphite">{lead.name}</p>
								<p class="text-xs text-mist">{lead.email}</p>
							</td>
							<td class="px-6 py-4 text-slate">{lead.service || '—'}</td>
							<td class="px-6 py-4 text-slate">{lead.location || '—'}</td>
							<td class="px-6 py-4">
								<select
									data-lead-status={lead.id}
									class="border border-sand bg-white px-2 py-1.5 text-xs focus:border-brass focus:outline-none"
									aria-label={`Status for ${lead.name}`}
								>
									{STATUS_OPTIONS.map((option) => (
										<option value={option.value} selected={option.value === lead.status}>{option.label}</option>
									))}
								</select>
							</td>
							<td class="px-6 py-4 text-xs text-mist">
								{lead.form === 'project_inquiry' ? 'Modal' : 'Contact page'}
							</td>
							<td class="whitespace-nowrap px-6 py-4 text-slate">
								{lead.firstResponseAt ? relative(lead.firstResponseAt) : '—'}
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<p class="border-t border-sand/60 px-6 py-4 text-xs text-mist" id="crm-leads-foot">
			Showing the {recent.length} most recent of {metrics.total}.
		</p>
	</section>

	<!-- Lead detail ---------------------------------------------------------- -->
	<dialog
		id="crm-lead-dialog"
		class="fixed inset-0 m-auto max-h-[85vh] w-full max-w-2xl border border-sand bg-white p-0 shadow-2xl backdrop:bg-ink/40"
	>
		<div class="max-h-[85vh] overflow-y-auto p-6 lg:p-8">
			<div class="flex items-start justify-between gap-4">
				<div>
					<p class="eyebrow text-stone">Lead</p>
					<h2 class="mt-2 font-display text-3xl" id="crm-dialog-name">—</h2>
				</div>
				<button type="button" class="eyebrow text-slate hover:text-ink" id="crm-dialog-close">Close</button>
			</div>

			<dl class="mt-6 grid gap-4 sm:grid-cols-2" id="crm-dialog-meta"></dl>

			<div class="mt-6 border-t border-sand/60 pt-5">
				<p class="eyebrow text-stone">Origin</p>
				<dl class="mt-3 grid gap-4 sm:grid-cols-2" id="crm-dialog-origin"></dl>
				<div class="mt-4 flex flex-wrap gap-2" id="crm-dialog-flags"></div>
			</div>

			<div class="mt-6 border-t border-sand/60 pt-5">
				<p class="eyebrow text-stone">Message</p>
				<p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-graphite" id="crm-dialog-message"></p>
			</div>

			<div class="mt-6 flex flex-wrap gap-3">
				<select id="crm-dialog-status" class="border border-sand bg-white px-3 py-2 text-sm focus:border-brass focus:outline-none" aria-label="Change status">
					{STATUS_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}
				</select>
				<button type="button" id="crm-dialog-responded" class="btn-secondary">Mark as answered</button>
				<a id="crm-dialog-mail" href="#" class="btn-secondary">Reply by email</a>
				<button type="button" id="crm-dialog-block-ip" class="btn-secondary">Block IP</button>
				<button type="button" id="crm-dialog-block-domain" class="btn-secondary">Block domain</button>
			</div>

			<div class="mt-6 border-t border-sand/60 pt-5">
				<p class="eyebrow text-stone">Notes</p>
				<form id="crm-note-form" class="mt-3 flex flex-col gap-3 sm:flex-row">
					<label class="sr-only" for="crm-note">Add a note</label>
					<input id="crm-note" type="text" maxlength="600" placeholder="What happened on this lead?"
						class="w-full border border-sand bg-white px-4 py-2.5 text-sm placeholder:text-mist focus:border-brass focus:outline-none" />
					<button type="submit" class="btn-primary shrink-0">Add</button>
				</form>
				<ul class="mt-4 space-y-3" id="crm-dialog-notes"></ul>
			</div>

			<div class="mt-6 border-t border-sand/60 pt-5">
				<p class="eyebrow text-stone">Timeline</p>
				<ol class="mt-3 space-y-2" id="crm-dialog-timeline"></ol>
			</div>
		</div>
	</dialog>

	<!-- Submission ledger ---------------------------------------------------- -->
	<section class="mt-6 grid gap-6 lg:grid-cols-2">
		<div class="border border-sand/70 bg-white p-6">
			<div class="flex items-baseline justify-between gap-4">
				<p class="eyebrow text-stone">Submission ledger · 14 days</p>
				<p class="text-xs text-mist">what the server did</p>
			</div>
			<p class="mt-3 text-xs leading-relaxed text-mist">
				Ground truth for reconciliation: compare <strong class="font-normal text-slate">Accepted</strong> with
				Vercel Analytics → Custom Events → <code class="text-slate">form_success</code>, and
				<strong class="font-normal text-slate">Attempts</strong> with <code class="text-slate">form_submit</code>.
				Honeypot hits answer 200 but store no lead; blocks never reach the platform's count either.
			</p>
			<div class="mt-5 overflow-x-auto">
				<table class="w-full min-w-[560px] text-left text-xs">
					<thead>
						<tr class="border-b border-sand/60">
							<th class="eyebrow py-2 pr-3 text-slate">Day</th>
							<th class="eyebrow py-2 pr-3 text-slate">Attempts</th>
							<th class="eyebrow py-2 pr-3 text-slate">Accepted</th>
							<th class="eyebrow py-2 pr-3 text-slate">Validation</th>
							<th class="eyebrow py-2 pr-3 text-slate">Rate</th>
							<th class="eyebrow py-2 pr-3 text-slate">Honeypot</th>
							<th class="eyebrow py-2 pr-3 text-slate">Blocked</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-sand/40">
						{ledger.map((day) => (
							<tr data-ledger-day={day.day}>
								<td class="py-2 pr-3 text-graphite">{day.day}</td>
								<td class="py-2 pr-3 text-slate" data-ledger="attempts">{day.fields.attempts}</td>
								<td class="py-2 pr-3 text-slate" data-ledger="accepted">{day.fields.accepted}</td>
								<td class="py-2 pr-3 text-mist" data-ledger="rejected_validation">{day.fields.rejected_validation}</td>
								<td class="py-2 pr-3 text-mist" data-ledger="rejected_rate">{day.fields.rejected_rate}</td>
								<td class="py-2 pr-3 text-mist" data-ledger="honeypot">{day.fields.honeypot}</td>
								<td class="py-2 pr-3 text-coffee" data-ledger="blocked">{day.fields.blocked}</td>
							</tr>
						))}
					</tbody>
					<tfoot>
						<tr class="border-t border-sand/60 font-medium" id="crm-ledger-totals">
							<td class="py-2 pr-3 text-slate">Total</td>
							<td class="py-2 pr-3 text-ink">{ledgerTotals.attempts}</td>
							<td class="py-2 pr-3 text-ink">{ledgerTotals.accepted}</td>
							<td class="py-2 pr-3 text-slate">{ledgerTotals.rejected_validation}</td>
							<td class="py-2 pr-3 text-slate">{ledgerTotals.rejected_rate}</td>
							<td class="py-2 pr-3 text-slate">{ledgerTotals.honeypot}</td>
							<td class="py-2 pr-3 text-ink">{ledgerTotals.blocked}</td>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>

		<div class="border border-sand/70 bg-white p-6">
			<div class="flex items-baseline justify-between gap-4">
				<p class="eyebrow text-stone">Security · blocklist</p>
				<p class="text-xs text-mist"><span id="crm-block-count">{blocks.length}</span> rules</p>
			</div>
			<p class="mt-3 text-xs leading-relaxed text-mist">
				A blocked IP, address or domain is answered like a success and never reaches the pipeline.
				Rules are exact matches — add one from any lead's dialog.
			</p>

			<form id="crm-block-form" class="mt-5 flex flex-wrap gap-2">
				<label class="sr-only" for="crm-block-type">Rule type</label>
				<select id="crm-block-type" class="border border-sand bg-white px-3 py-2 text-sm focus:border-brass focus:outline-none">
					<option value="ip">IP</option>
					<option value="email">Email</option>
					<option value="domain">Domain</option>
				</select>
				<label class="sr-only" for="crm-block-value">Value to block</label>
				<input
					id="crm-block-value"
					type="text"
					placeholder="203.0.113.9 · name@host · host.com"
					class="min-w-40 flex-1 border border-sand bg-white px-3 py-2 text-sm placeholder:text-mist focus:border-brass focus:outline-none"
				/>
				<button type="submit" class="btn-primary">Block</button>
			</form>

			<ul class="mt-5 space-y-2" id="crm-block-list">
				{blocks.map((rule) => (
					<li class="flex items-center justify-between gap-3 border-b border-sand/50 py-2 last:border-0" data-block={rule.type}>
						<div class="min-w-0">
							<p class="truncate text-sm text-graphite">{rule.value}</p>
							<p class="text-xs text-mist">
								{rule.type} · {rule.hits} hit{rule.hits === 1 ? '' : 's'}
								{rule.reason ? ` · ${rule.reason}` : ''}
							</p>
						</div>
						<button
							type="button"
							class="eyebrow shrink-0 border border-sand px-2 py-1 text-slate transition-colors hover:border-brass hover:text-ink"
							data-block-remove={rule.type}
							data-block-value={rule.value}
						>
							Remove
						</button>
					</li>
				))}
				{blocks.length === 0 && <li class="py-4 text-sm text-mist">No rules yet.</li>}
			</ul>
		</div>
	</section>

	<p class="mt-6 text-xs text-mist" id="crm-status-line" role="status" aria-live="polite">
		Last updated just now · refreshing every 30 s.
	</p>
</AdminLayout>

<script>
	type LeadStatusValue =
		| 'novo'
		| 'atendimento_ia'
		| 'atendimento_humano'
		| 'reuniao_agendada'
		| 'reuniao_realizada'
		| 'proposta'
		| 'fechado'
		| 'perdido';

	const STATUS_LABELS: Record<LeadStatusValue, string> = {
		novo: 'New',
		atendimento_ia: 'AI handling',
		atendimento_humano: 'Human handling',
		reuniao_agendada: 'Meeting scheduled',
		reuniao_realizada: 'Meeting held',
		proposta: 'Proposal sent',
		fechado: 'Won',
		perdido: 'Lost',
	};

	const BOARD_COLUMNS: LeadStatusValue[] = [
		'novo',
		'atendimento_ia',
		'atendimento_humano',
		'reuniao_agendada',
		'reuniao_realizada',
		'proposta',
	];

	const COLUMN_COLORS: Record<LeadStatusValue, string> = {
		novo: 'bg-brass',
		atendimento_ia: 'bg-stone',
		atendimento_humano: 'bg-coffee',
		reuniao_agendada: 'bg-graphite',
		reuniao_realizada: 'bg-slate',
		proposta: 'bg-sand',
		fechado: 'bg-ink',
		perdido: 'bg-mist',
	};

	/** Legacy records may still say `em_contato` — count them where they belong. */
	const normalize = (value: unknown): LeadStatusValue => {
		const status = String(value ?? 'novo');
		if (status === 'em_contato') return 'atendimento_humano';
		return (STATUS_LABELS[status as LeadStatusValue] ? status : 'novo') as LeadStatusValue;
	};

	const esc = (value: unknown): string =>
		String(value ?? '').replace(/[&<>"']/g, (char) =>
			({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] as string,
		);

	const fmtDate = (ts: number): string =>
		new Date(ts).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
	const relative = (ts: number): string => {
		const diff = Date.now() - ts;
		const abs = Math.abs(diff);
		const hours = Math.floor(abs / 3_600_000);
		if (hours < 1) return diff > 0 ? 'just now' : `in ${Math.max(1, Math.round(abs / 60_000))} min`;
		if (hours < 24) return diff > 0 ? `${hours}h ago` : `in ${hours}h`;
		const days = Math.floor(hours / 24);
		return diff > 0 ? `${days}d ago` : `in ${days}d`;
	};

	const $ = <T extends HTMLElement>(selector: string): T | null => document.querySelector<T>(selector);
	const statusLine = $<HTMLElement>('#crm-status-line');
	const setStatus = (message: string): void => {
		if (statusLine) statusLine.textContent = message;
	};

	let search = '';
	let filter = '';
	let currentLeadId: string | null = null;
	let leads: Array<Record<string, unknown>> = [];
	/** The record currently open in the dialog — used by the block buttons. */
	let currentLead: Record<string, unknown> | null = null;

	/* ---------------------------------------------------------------- API */

	async function getJson(path: string, init?: RequestInit): Promise<Record<string, unknown> | null> {
		try {
			const response = await fetch(path, { headers: { Accept: 'application/json' }, ...init });
			if (response.status === 401) {
				window.location.href = '/admin/login/';
				return null;
			}
			if (!response.ok) return null;
			return (await response.json()) as Record<string, unknown>;
		} catch {
			return null;
		}
	}

	async function refresh(): Promise<void> {
		const [metricsRes, leadsRes, tasksRes, reportRes] = await Promise.all([
			getJson('/api/crm/metrics/'),
			getJson(`/api/crm/leads/?limit=500${search ? `&q=${encodeURIComponent(search)}` : ''}${filter ? `&status=${filter}` : ''}`),
			getJson('/api/crm/tasks/'),
			getJson('/api/crm/report/'),
		]);

		if (metricsRes?.metrics) {
			renderMetrics(metricsRes.metrics as Record<string, unknown>, metricsRes.storage as { backend?: string });
			if (Array.isArray(metricsRes.ledger)) {
				renderLedger(metricsRes.ledger as Array<Record<string, unknown>>);
			}
		}
		if (leadsRes?.leads) {
			leads = (leadsRes.leads as Array<Record<string, unknown>>) ?? [];
			renderBoard();
			renderLeads();
		}
		if (tasksRes) renderQueue(tasksRes);
		if (reportRes) renderReport(reportRes.report ?? null);
		setStatus(`Last updated ${new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })} · refreshing every 30 s.`);
	}

	/* ----------------------------------------------------------- Rendering */

	function renderMetrics(metrics: Record<string, unknown>, storage?: { backend?: string }): void {
		const answered = Number(metrics.answeredWithin24h ?? 0);
		const values: Record<string, { value: string; note: string }> = {
			last30: { value: String(metrics.last30 ?? 0), note: `${metrics.total ?? 0} all time` },
			awaitingReply: { value: String(metrics.awaitingReply ?? 0), note: `${metrics.open ?? 0} in pipeline` },
			responseHours: {
				value: metrics.avgFirstResponseHours === null || metrics.avgFirstResponseHours === undefined
					? '—'
					: `${(Number(metrics.avgFirstResponseHours) || 0).toFixed(1)} h`,
				note: `${Math.round(answered * 100)}% answered in 24 h`,
			},
			conversion: { value: `${Math.round(Number(metrics.conversionRate ?? 0) * 100)}%`, note: 'of closed leads' },
			today: { value: String(metrics.today ?? 0), note: 'since midnight (UTC)' },
			overdue: { value: String(metrics.tasksOverdue ?? 0), note: `${metrics.tasksOpen ?? 0} open tasks` },
		};

		for (const [key, entry] of Object.entries(values)) {
			const el = document.querySelector<HTMLElement>(`[data-kpi="${key}"]`);
			if (el) el.textContent = entry.value;
			const note = document.querySelector<HTMLElement>(`[data-kpi-note="${key}"]`);
			if (note) note.textContent = entry.note;
		}

		const count = $('crm-lead-count');
		if (count) count.textContent = String(metrics.total ?? 0);

		renderChart((metrics.daily ?? {}) as Record<string, number>);
		renderFunnel((metrics.byStatus ?? {}) as Record<string, number>);
	}

	function renderChart(daily: Record<string, number>): void {
		const host = $('#crm-chart');
		if (!host) return;
		const entries = Object.entries(daily);
		if (!entries.length) return;
		const max = Math.max(1, ...entries.map(([, count]) => count));
		const slot = 600 / entries.length;

		const bars = entries
			.map(([day, count], index) => {
				const x = index * slot + (slot - 14) / 2;
				const h = (count / max) * 130;
				const height = Math.max(count > 0 ? 2 : 0, h);
				return `<rect x="${x}" y="${140 - height}" width="14" height="${height}" class="fill-stone" rx="1"><title>${esc(day)}: ${count}</title></rect>`;
			})
			.join('');

		host.innerHTML = `<svg viewBox="0 0 600 170" class="h-52 w-full" role="img" aria-label="Daily lead volume">
			${bars}
			<line x1="0" y1="140" x2="600" y2="140" class="stroke-sand" stroke-width="1"></line>
			<text x="0" y="162" class="fill-mist text-[10px]">${esc(entries[0][0])}</text>
			<text x="600" y="162" text-anchor="end" class="fill-mist text-[10px]">${esc(entries[entries.length - 1][0])}</text>
		</svg>`;
	}

	function renderFunnel(byStatus: Record<string, number>): void {
		const list = $('#crm-funnel');
		if (!list) return;
		const entries = Object.entries(STATUS_LABELS) as [LeadStatusValue, string][];
		const max = Math.max(1, ...entries.map(([key]) => Number(byStatus[key] ?? 0)));

		list.innerHTML = entries
			.map(([key, label]) => {
				const count = Number(byStatus[key] ?? 0);
				return `<li>
					<div class="flex items-baseline justify-between gap-3">
						<span class="eyebrow text-slate">${esc(label)}</span>
						<span class="font-display text-2xl">${count}</span>
					</div>
					<div class="mt-2 h-1.5 w-full bg-sand/30">
						<div class="h-full ${COLUMN_COLORS[key]}" style="width:${(count / max) * 100}%"></div>
					</div>
				</li>`;
			})
			.join('');
	}

	/* ------------------------------------------------------------- Board */

	function renderBoard(): void {
		const byStatus = new Map<LeadStatusValue, Array<Record<string, unknown>>>();
		for (const status of Object.keys(STATUS_LABELS) as LeadStatusValue[]) byStatus.set(status, []);
		for (const lead of leads) byStatus.get(normalize(lead.status))?.push(lead);

		let openCount = 0;
		for (const status of BOARD_COLUMNS) openCount += byStatus.get(status)?.length ?? 0;
		const openEl = $('crm-board-open');
		if (openEl) openEl.textContent = String(openCount);

		for (const status of BOARD_COLUMNS) {
			const zone = document.querySelector<HTMLElement>(`[data-dropzone="${status}"]`);
			const counter = document.querySelector<HTMLElement>(`[data-column-count="${status}"]`);
			if (!zone) continue;
			const items = byStatus.get(status) ?? [];
			if (counter) counter.textContent = String(items.length);

			const cards = items
				.slice(0, 20)
				.map((lead) => {
					const id = esc(lead.id);
					const country = lead.geo && typeof lead.geo === 'object' && (lead.geo as { country?: string }).country
						? esc((lead.geo as { country?: string }).country)
						: '';
					const summary = esc(String(lead.service || lead.location || '—'));
					const options = (Object.entries(STATUS_LABELS) as [LeadStatusValue, string][])
						.map(
							([value, label]) =>
								`<option value="${value}"${value === status ? ' selected' : ''}>${esc(label)}</option>`,
						)
						.join('');
					const transfer =
						status === 'atendimento_ia'
							? `<button type="button" class="eyebrow mt-3 w-full border border-sand px-2 py-1.5 text-slate transition-colors hover:border-brass hover:text-ink" data-transfer-human="${id}">Transfer to human</button>`
							: '';
					return `<article class="cursor-grab border border-sand/70 bg-white p-4 transition-colors hover:border-brass active:cursor-grabbing" data-card="${id}" data-card-status="${status}" draggable="true" tabindex="0" aria-label="${esc(lead.name)} — ${esc(STATUS_LABELS[status])}">
						<div class="flex items-start justify-between gap-2">
							<p class="text-sm font-medium text-ink">${esc(lead.name)}</p>
							${country ? `<span class="text-xs text-mist">${country}</span>` : ''}
						</div>
						<p class="mt-1 line-clamp-2 text-xs text-slate">${summary}</p>
						<div class="mt-3 flex items-center justify-between gap-2">
							<span class="text-[10px] uppercase tracking-wider text-mist">${esc(relative(Number(lead.createdAt)))}</span>
							<label class="sr-only" for="move-${id}">Move ${esc(lead.name)}</label>
							<select id="move-${id}" data-card-move="${id}" class="border border-sand bg-bone px-1.5 py-1 text-[11px] focus:border-brass focus:outline-none">${options}</select>
						</div>
						${transfer}
					</article>`;
				})
				.join('');

			zone.innerHTML =
				cards ||
				`<p class="border border-dashed border-sand/70 px-4 py-6 text-center text-xs text-mist">Drop a lead here</p>`;
		}

		// Won / Lost tabs reflect the same data without leaving the board.
		for (const status of ['fechado', 'perdido'] as LeadStatusValue[]) {
			const tab = document.querySelector<HTMLElement>(`[data-closed-tab="${status}"]`);
			if (tab) {
				const wasOpen = tab.getAttribute('aria-expanded') === 'true';
				tab.textContent = `${STATUS_LABELS[status]} · ${byStatus.get(status)?.length ?? 0}`;
				if (wasOpen) renderClosedList(status);
			}
		}
	}

	function renderClosedList(status: LeadStatusValue): void {
		const host = $('#crm-closed-list');
		if (!host) return;
		const items = leads.filter((lead) => normalize(lead.status) === status).slice(0, 30);
		host.classList.remove('hidden');
		host.innerHTML = items.length
			? items
					.map(
						(lead) =>
							`<button type="button" class="flex w-full items-center justify-between gap-3 border border-sand/70 bg-white px-4 py-3 text-left transition-colors hover:border-brass" data-lead-row="${esc(lead.id)}">
								<span class="text-sm text-graphite">${esc(lead.name)}</span>
								<span class="text-xs text-mist">${esc(String(lead.service || lead.location || '—'))} · ${esc(relative(Number(lead.createdAt)))}</span>
							</button>`,
					)
					.join('')
			: `<p class="border border-dashed border-sand/70 px-4 py-6 text-center text-xs text-mist">Nothing here yet.</p>`;
	}

	/* ------------------------------------------------------------ Ledger */

	function renderLedger(days: Array<Record<string, unknown>>): void {
		const totals: Record<string, number> = {};
		for (const day of days) {
			const fields = (day.fields ?? {}) as Record<string, number>;
			const row = document.querySelector<HTMLElement>(`[data-ledger-day="${String(day.day)}"]`);
			if (row) {
				for (const [key, value] of Object.entries(fields)) {
					const cell = row.querySelector<HTMLElement>(`[data-ledger="${key}"]`);
					if (cell) cell.textContent = String(value);
				}
			}
			for (const [key, value] of Object.entries(fields)) totals[key] = (totals[key] ?? 0) + value;
		}
		// Totals live in the footer; read them from the computed sum.
		const footer = document.querySelector<HTMLElement>('#crm-ledger-totals');
		if (footer) {
			for (const [key, value] of Object.entries(totals)) {
				const cell = footer.querySelector<HTMLElement>(`[data-ledger="${key}"]`);
				if (cell) cell.textContent = String(value);
			}
		}
	}

	function renderLeads(): void {
		const body = $('crm-leads');
		const foot = $('crm-leads-foot');
		if (!body) return;

		if (!leads.length) {
			body.innerHTML = `<tr><td colspan="7" class="px-6 py-10 text-center text-sm text-mist">No leads match this filter.</td></tr>`;
		} else {
			body.innerHTML = leads
				.slice(0, 100)
				.map((lead) => {
					const status = normalize(lead.status);
					const options = (Object.entries(STATUS_LABELS) as [LeadStatusValue, string][])
						.map(
							([value, label]) =>
								`<option value="${value}"${value === status ? ' selected' : ''}>${esc(label)}</option>`,
						)
						.join('');
					const first = lead.firstResponseAt ? relative(Number(lead.firstResponseAt)) : '—';
					return `<tr class="cursor-pointer transition-colors hover:bg-bone" data-lead-row="${esc(lead.id)}">
						<td class="whitespace-nowrap px-6 py-4 text-slate">${esc(fmtDate(Number(lead.createdAt)))}</td>
						<td class="px-6 py-4">
							<p class="text-graphite">${esc(lead.name)}</p>
							<p class="text-xs text-mist">${esc(lead.email)}</p>
						</td>
						<td class="px-6 py-4 text-slate">${esc(lead.service || '—')}</td>
						<td class="px-6 py-4 text-slate">${esc(lead.location || '—')}</td>
						<td class="px-6 py-4">
							<select data-lead-status="${esc(lead.id)}" class="border border-sand bg-white px-2 py-1.5 text-xs focus:border-brass focus:outline-none" aria-label="Status for ${esc(lead.name)}">${options}</select>
						</td>
						<td class="px-6 py-4 text-xs text-mist">${lead.form === 'project_inquiry' ? 'Modal' : 'Contact page'}</td>
						<td class="whitespace-nowrap px-6 py-4 text-slate">${esc(first)}</td>
					</tr>`;
				})
				.join('');
		}

		if (foot) foot.textContent = `Showing ${Math.min(leads.length, 100)} of ${leads.length} matching leads.`;
	}

	function renderQueue(payload: Record<string, unknown>): void {
		const list = $('#crm-queue');
		const overdueEl = $('crm-queue-overdue');
		const tasks = (payload.tasks as Array<Record<string, unknown>>) ?? [];
		const open = tasks.filter((task) => task.state === 'open').slice(0, 8);
		const overdue = Number(payload.overdue ?? 0);

		if (overdueEl) overdueEl.textContent = String(overdue);
		if (!list) return;

		if (!open.length) {
			list.innerHTML = `<li class="py-6 text-sm text-mist">Nothing waiting. Every lead has been answered.</li>`;
			return;
		}

		const now = Date.now();
		list.innerHTML = open
			.map((task) => {
				const due = Number(task.dueAt ?? 0);
				const late = due <= now;
				return `<li class="flex items-start justify-between gap-4 border-b border-sand/50 py-3 last:border-0" data-task="${esc(task.id)}">
					<div class="min-w-0">
						<p class="truncate text-sm text-graphite">${esc(task.title)}</p>							<p class="mt-1 text-xs ${late ? 'text-coffee' : 'text-mist'}">${late ? `late ${Math.max(1, Math.round((now - due) / 3_600_000))}h` : esc(relative(due))}</p>
					</div>
					<div class="flex shrink-0 gap-2">
						<button type="button" class="eyebrow border border-sand px-2 py-1 text-slate transition-colors hover:border-brass hover:text-ink" data-task-open="${esc(task.leadId)}">Open</button>
						<button type="button" class="eyebrow border border-sand px-2 py-1 text-slate transition-colors hover:border-brass hover:text-ink" data-task-done="${esc(task.id)}">Done</button>
					</div>
				</li>`;
			})
			.join('');
	}

	function renderReport(report: Record<string, unknown> | null): void {
		const host = $('#crm-report');
		const time = $<HTMLElement>('#crm-report-time');
		if (!host) return;

		if (!report) {
			host.innerHTML = `<p class="mt-5 text-sm leading-relaxed text-mist">Waiting for Hermes. The moment the agent posts a report it appears here — until then the KPIs above are computed directly from the pipeline.</p>`;
			if (time) time.textContent = 'no report yet';
			return;
		}

		const generated = Number(report.generatedAt ?? Date.now());
		const summary = String(report.summary ?? '');
		const highlights = (report.highlights as string[]) ?? [];
		const actions = (report.actions as string[]) ?? [];

		let html = `<p class="mt-5 text-base leading-relaxed text-graphite">${esc(summary)}</p>`;
		if (highlights.length) {
			html += `<ul class="mt-5 space-y-2">${highlights
				.map(
					(item) =>
						`<li class="flex gap-3 text-sm text-slate"><span class="mt-2 h-1 w-1 shrink-0 rotate-45 bg-brass" aria-hidden="true"></span><span>${esc(item)}</span></li>`,
				)
				.join('')}</ul>`;
		}
		if (actions.length) {
			html += `<div class="mt-6 border-t border-sand/60 pt-4"><p class="eyebrow text-stone">Suggested actions</p>
				<ol class="mt-3 space-y-2">${actions
					.map(
						(item, index) =>
							`<li class="text-sm text-graphite"><span class="mr-2 font-display text-lg text-stone">${index + 1}.</span>${esc(item)}</li>`,
					)
					.join('')}</ol></div>`;
		}

		host.innerHTML = html;
		if (time) time.textContent = `generated ${relative(generated)}`;
	}

	/* ---------------------------------------------------------- Lead dialog */

	const dialog = $<HTMLDialogElement>('#crm-lead-dialog');

	async function openLead(id: string): Promise<void> {
		const payload = await getJson(`/api/crm/leads/${encodeURIComponent(id)}/`);
		if (!payload?.lead || !dialog) return;

		const lead = payload.lead as Record<string, unknown>;
		currentLeadId = String(lead.id);
		currentLead = lead;

		const name = $('#crm-dialog-name');
		if (name) name.textContent = String(lead.name ?? 'Lead');

		const meta = $('#crm-dialog-meta');
		if (meta) {
			const rows: Array<[string, string]> = [
				['Email', String(lead.email ?? '')],
				['Phone', String(lead.phone || '—')],
				['Service', String(lead.service || '—')],
				['Location', String(lead.location || '—')],
				['Budget', String(lead.budget || '—')],
				['Timeline', String(lead.timeline || '—')],
				['Received', fmtDate(Number(lead.createdAt))],
				['Source', `${lead.form === 'project_inquiry' ? 'Modal' : 'Contact page'} · ${String(lead.page ?? '/')}`],
				['Status', STATUS_LABELS[lead.status as LeadStatusValue] ?? String(lead.status)],
				['First reply', lead.firstResponseAt ? relative(Number(lead.firstResponseAt)) : 'not yet'],
			];
			meta.innerHTML = rows
				.map(
					([label, value]) =>
						`<div><dt class="eyebrow text-stone">${esc(label)}</dt><dd class="mt-1.5 text-sm text-graphite">${esc(value)}</dd></div>`,
				)
				.join('');
		}

		const message = $('#crm-dialog-message');
		if (message) message.textContent = String(lead.message ?? '');

		/* Origin — enrichment captured server-side, shown only here. */
		const origin = $('#crm-dialog-origin');
		if (origin) {
			const geo = (lead.geo ?? {}) as { country?: string; city?: string; tz?: string };
			const utm = (lead.utm ?? {}) as Record<string, string>;
			const utmText = [utm.source, utm.medium, utm.campaign].filter(Boolean).join(' / ');
			const device = String(lead.userAgent ?? '');
			const rows: Array<[string, string]> = [
				['IP', String(lead.ip || '—')],
				['Country', [geo.country, geo.city].filter(Boolean).join(' · ') || '—'],
				['Timezone', geo.tz || '—'],
				['Device', device ? device.slice(0, 120) : '—'],
				['Landing', String(lead.landing || lead.page || '/')],
				['UTM', utmText || '—'],
			];
			origin.innerHTML = rows
				.map(
					([label, value]) =>
						`<div><dt class="eyebrow text-stone">${esc(label)}</dt><dd class="mt-1.5 break-all text-sm text-graphite">${esc(value)}</dd></div>`,
				)
				.join('');
		}

		const flags = $('#crm-dialog-flags');
		if (flags) {
			const list = (lead.flags as string[]) ?? [];
			flags.innerHTML = list.length
				? list
						.map(
							(flag) =>
								`<span class="eyebrow border border-coffee/40 bg-coffee/5 px-2 py-1 text-coffee">${esc(flag.replace(/_/g, ' '))}</span>`,
						)
						.join('')
				: '<span class="text-xs text-mist">No review flags.</span>';
		}

		const status = $<HTMLSelectElement>('#crm-dialog-status');
		if (status) status.value = String(lead.status ?? 'novo');

		const mail = $<HTMLAnchorElement>('#crm-dialog-mail');
		if (mail) {
			// Only an address may go into a mailto: — nothing else from the record.
			const address = String(lead.email ?? '').replace(/[^\w.@+-]/g, '');
			mail.href = `mailto:${address}?subject=${encodeURIComponent('Re: your project inquiry')}`;
			mail.toggleAttribute('aria-disabled', !address);
		}

		const notes = $('#crm-dialog-notes');
		const noteList = (lead.notes as Array<{ ts: number; text: string }>) ?? [];
		if (notes) {
			notes.innerHTML = noteList.length
				? noteList
						.map(
							(note) =>
								`<li class="border-l-2 border-sand pl-3 text-sm text-graphite"><span class="block text-xs text-mist">${esc(fmtDate(note.ts))}</span>${esc(note.text)}</li>`,
						)
						.join('')
				: `<li class="text-sm text-mist">No notes yet.</li>`;
		}

		const timeline = $('#crm-dialog-timeline');
		const events = (payload.events as Array<{ ts: number; type: string; detail: string }>) ?? [];
		if (timeline) {
			timeline.innerHTML = events.length
				? events
						.map(
							(event) =>
								`<li class="flex gap-3 text-sm"><span class="w-28 shrink-0 text-xs text-mist">${esc(fmtDate(event.ts))}</span><span class="text-graphite">${esc(event.detail)}</span></li>`,
						)
						.join('')
				: `<li class="text-sm text-mist">No events recorded.</li>`;
		}

		// showModal() throws if the dialog is already open (double click).
		if (!dialog.open) dialog.showModal();
	}

	/* ------------------------------------------------------------- Actions */

	async function patchLead(id: string, body: Record<string, unknown>): Promise<boolean> {
		const payload = await getJson(`/api/crm/leads/${encodeURIComponent(id)}/`, {
			method: 'PATCH',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(body),
		});
		if (payload?.ok) {
			await refresh();
			return true;
		}
		setStatus('That change could not be saved. Try again.');
		return false;
	}

	async function patchTask(id: string, state: string): Promise<void> {
		await getJson('/api/crm/tasks/', {
			method: 'PATCH',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ id, state }),
		});
		await refresh();
	}

	/* ------------------------------------------------------------ Wiring up */

	let debounce: ReturnType<typeof setTimeout> | undefined;
	const searchInput = $<HTMLInputElement>('#crm-search');
	const filterInput = $<HTMLSelectElement>('#crm-filter');

	searchInput?.addEventListener('input', () => {
		clearTimeout(debounce);
		debounce = setTimeout(() => {
			search = searchInput.value.trim();
			void refresh();
		}, 300);
	});

	filterInput?.addEventListener('change', () => {
		filter = filterInput.value;
		void refresh();
	});

	$<HTMLButtonElement>('#crm-refresh')?.addEventListener('click', () => void refresh());

	$<HTMLButtonElement>('#crm-remind')?.addEventListener('click', async () => {
		setStatus('Sending follow-up reminders…');
		const result = await getJson('/api/crm/cron/followups/', { method: 'POST' });
		if (result?.ok) {
			setStatus(`Reminders: ${result.overdue ?? 0} overdue, ${result.reminded ?? 0} emailed.`);
			await refresh();
		} else {
			setStatus('Reminders could not be sent (check CRON_SECRET).');
		}
	});

	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;

		const openButton = target.closest<HTMLElement>('[data-task-open]');
		if (openButton) {
			void openLead(openButton.dataset.taskOpen ?? '');
			return;
		}

		const doneButton = target.closest<HTMLElement>('[data-task-done]');
		if (doneButton) {
			void patchTask(doneButton.dataset.taskDone ?? '', 'done');
			return;
		}

		const row = target.closest<HTMLElement>('[data-lead-row]');
		if (row && !target.closest('select')) {
			void openLead(row.dataset.leadRow ?? '');
		}
	});

	// Rows are reachable by keyboard: Enter/Space opens the same detail panel.
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Enter' && event.key !== ' ') return;
		const row = (event.target as HTMLElement).closest<HTMLElement>('[data-lead-row]');
		if (!row || (event.target as HTMLElement).closest('select')) return;
		event.preventDefault();
		void openLead(row.dataset.leadRow ?? '');
	});

	document.addEventListener('change', (event) => {
		const target = event.target as HTMLElement;
		const statusSelect = target.closest<HTMLSelectElement>('[data-lead-status]');
		if (statusSelect) {
			void patchLead(statusSelect.dataset.leadStatus ?? '', { status: statusSelect.value });
			return;
		}
		// The card's own <select> — keyboard and touch way to move a card.
		const cardMove = target.closest<HTMLSelectElement>('[data-card-move]');
		if (cardMove) {
			void patchLead(cardMove.dataset.cardMove ?? '', { status: cardMove.value });
			return;
		}
		if (target.id === 'crm-dialog-status' && currentLeadId) {
			void patchLead(currentLeadId, { status: (target as HTMLSelectElement).value }).then(() =>
				openLead(currentLeadId ?? ''),
			);
		}
	});

	$<HTMLButtonElement>('#crm-dialog-responded')?.addEventListener('click', async () => {
		if (!currentLeadId) return;
		const ok = await patchLead(currentLeadId, { responded: true });
		if (ok) await openLead(currentLeadId);
	});

	$<HTMLFormElement>('#crm-note-form')?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const input = $<HTMLInputElement>('#crm-note');
		if (!currentLeadId || !input?.value.trim()) return;
		const ok = await patchLead(currentLeadId, { note: input.value.trim() });
		if (ok) {
			input.value = '';
			await openLead(currentLeadId);
		}
	});

	$<HTMLButtonElement>('#crm-dialog-close')?.addEventListener('click', () => dialog?.close());
	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});

	/* ---------------------------------------------------- View toggle */

	const boardBtn = $<HTMLButtonElement>('#crm-view-board');
	const tableBtn = $<HTMLButtonElement>('#crm-view-table');
	const boardSection = $('#crm-board');
	const tableSection = $('#crm-leads-section');

	function setView(view: 'board' | 'table'): void {
		const isBoard = view === 'board';
		boardSection?.classList.toggle('hidden', !isBoard);
		tableSection?.classList.toggle('hidden', isBoard);
		boardBtn?.setAttribute('aria-pressed', String(isBoard));
		tableBtn?.setAttribute('aria-pressed', String(!isBoard));
		boardBtn?.classList.toggle('bg-bone', isBoard);
		boardBtn?.classList.toggle('text-ink', isBoard);
		boardBtn?.classList.toggle('text-slate', !isBoard);
		tableBtn?.classList.toggle('bg-bone', !isBoard);
		tableBtn?.classList.toggle('text-ink', !isBoard);
		tableBtn?.classList.toggle('text-slate', isBoard);
	}

	boardBtn?.addEventListener('click', () => setView('board'));
	tableBtn?.addEventListener('click', () => setView('table'));

	/* ------------------------------------------------ Drag & drop board */

	let dragId: string | null = null;

	document.addEventListener('dragstart', (event) => {
		const card = (event.target as HTMLElement).closest<HTMLElement>('[data-card]');
		if (!card) return;
		dragId = card.dataset.card ?? null;
		card.classList.add('opacity-50');
		// Firefox needs dataTransfer to enter drag mode; the value is never read.
		event.dataTransfer?.setData('text/plain', dragId);
		if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
	});

	document.addEventListener('dragend', (event) => {
		const card = (event.target as HTMLElement).closest<HTMLElement>('[data-card]');
		card?.classList.remove('opacity-50');
		document.querySelectorAll('[data-dropzone]').forEach((zone) => zone.classList.remove('border-brass', 'bg-bone'));
		dragId = null;
	});

	document.addEventListener('dragover', (event) => {
		const zone = (event.target as HTMLElement).closest<HTMLElement>('[data-dropzone]');
		if (!zone || !dragId) return;
		event.preventDefault();
		if (event.dataTransfer) event.dataTransfer.dropEffect = 'move';
		zone.classList.add('border-brass', 'bg-bone');
	});

	document.addEventListener('dragleave', (event) => {
		const zone = (event.target as HTMLElement).closest<HTMLElement>('[data-dropzone]');
		if (zone && !zone.contains(event.relatedTarget as Node)) {
			zone.classList.remove('border-brass', 'bg-bone');
		}
	});

	document.addEventListener('drop', (event) => {
		const zone = (event.target as HTMLElement).closest<HTMLElement>('[data-dropzone]');
		if (!zone || !dragId) return;
		event.preventDefault();
		zone.classList.remove('border-brass', 'bg-bone');
		const next = zone.dataset.dropzone;
		const id = dragId;
		dragId = null;
		if (!next || !id) return;
		if (normalize(currentStatusOf(id)) === next) return;
		// Optimistic: move it now, let patchLead repaint on success or roll back.
		moveCardDom(id, next as LeadStatusValue);
		void patchLead(id, { status: next });
	});

	function currentStatusOf(id: string): unknown {
		return leads.find((lead) => String(lead.id) === id)?.status ?? 'novo';
	}

	function moveCardDom(id: string, status: LeadStatusValue): void {
		const card = document.querySelector<HTMLElement>(`[data-card="${CSS.escape(id)}"]`);
		const zone = document.querySelector<HTMLElement>(`[data-dropzone="${status}"]`);
		if (!card || !zone) return;
		card.dataset.cardStatus = status;
		const select = card.querySelector<HTMLSelectElement>('select');
		if (select) select.value = status;
		zone.prepend(card);
		// Refresh re-renders every column anyway; this keeps counts honest meanwhile.
		for (const column of BOARD_COLUMNS) {
			const count = document.querySelector<HTMLElement>(`[data-column-count="${column}"]`);
			if (count) count.textContent = String(document.querySelectorAll(`[data-dropzone="${column}"] [data-card]`).length);
		}
	}

	/* ------------------------------------------------------ Board clicks */

	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;

		const transfer = target.closest<HTMLElement>('[data-transfer-human]');
		if (transfer) {
			const id = transfer.dataset.transferHuman ?? '';
			setStatus('Transferring to the studio…');
			void patchLead(id, { status: 'atendimento_humano', assignedTo: 'studio' }).then((ok) => {
				if (ok) setStatus('Lead transferred to a human handler.');
			});
			return;
		}

		const closedTab = target.closest<HTMLElement>('[data-closed-tab]');
		if (closedTab) {
			const status = closedTab.dataset.closedTab as LeadStatusValue;
			const open = closedTab.getAttribute('aria-expanded') === 'true';
			document.querySelectorAll('[data-closed-tab]').forEach((tab) => tab.setAttribute('aria-expanded', 'false'));
			if (open) {
				$('#crm-closed-list')?.classList.add('hidden');
			} else {
				closedTab.setAttribute('aria-expanded', 'true');
				renderClosedList(status);
			}
			return;
		}

		const card = target.closest<HTMLElement>('[data-card]');
		if (card && !target.closest('select') && !target.closest('button')) {
			void openLead(card.dataset.card ?? '');
		}
	});

	// Cards are focusable: Enter/Space opens the same detail panel as a row.
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Enter' && event.key !== ' ') return;
		const card = (event.target as HTMLElement).closest<HTMLElement>('[data-card]');
		if (!card || (event.target as HTMLElement).closest('select')) return;
		event.preventDefault();
		void openLead(card.dataset.card ?? '');
	});

	/* ------------------------------------------------------- Blocklist */

	async function saveBlock(body: Record<string, unknown>): Promise<boolean> {
		const payload = await getJson('/api/crm/blocks/', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(body),
		});
		if (payload?.ok) {
			setStatus(`Blocked ${String(body.value)}. New submissions from it will be refused silently.`);
			return true;
		}
		setStatus('That rule was not saved. IP, email and domain formats are checked.');
		return false;
	}

	$<HTMLFormElement>('#crm-block-form')?.addEventListener('submit', async (event) => {
		event.preventDefault();
		const type = $<HTMLSelectElement>('#crm-block-type')?.value ?? 'ip';
		const input = $<HTMLInputElement>('#crm-block-value');
		const value = input?.value.trim() ?? '';
		if (!value) return;
		if (await saveBlock({ type, value })) {
			if (input) input.value = '';
			window.location.reload();
		}
	});

	document.addEventListener('click', async (event) => {
		const remove = (event.target as HTMLElement).closest<HTMLElement>('[data-block-remove]');
		if (!remove) return;
		const body = { type: remove.dataset.blockRemove, value: remove.dataset.blockValue };
		const payload = await getJson('/api/crm/blocks/', {
			method: 'DELETE',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(body),
		});
		if (payload?.ok) {
			setStatus(`Removed the rule for ${String(body.value)}.`);
			window.location.reload();
		}
	});

	// One-click blocking from the lead dialog: the IP or the email's domain.
	$<HTMLButtonElement>('#crm-dialog-block-ip')?.addEventListener('click', async () => {
		const ip = String(currentLead?.ip ?? '');
		if (!ip) return setStatus('This lead has no IP recorded.');
		if (await saveBlock({ type: 'ip', value: ip, reason: 'from lead dialog' })) dialog?.close();
	});

	$<HTMLButtonElement>('#crm-dialog-block-domain')?.addEventListener('click', async () => {
		const email = String(currentLead?.email ?? '');
		const domain = email.slice(email.lastIndexOf('@') + 1).trim().toLowerCase();
		if (!domain || !domain.includes('.')) return setStatus('This lead has no email domain.');
		if (await saveBlock({ type: 'domain', value: domain, reason: 'from lead dialog' })) dialog?.close();
	});

	/* --------------------------------------------------------------- Start */

	void refresh();
	setInterval(() => void refresh(), 30_000);
</script>
