---
/**
 * /journal/[slug]/ — Single Journal article page.
 *
 * Pre-rendered at build time with support for both Markdown collection articles
 * and published articles stored in Redis.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import { articleSchema, webPageSchema, schemaScript } from '../../lib/seo';
import { brandedOg } from '../../lib/og';
import type { BreadcrumbEntry } from '../../lib/seo';
import { listJournalPosts } from '../../lib/journal/store';
import { estimateReadingTime } from '../../lib/journal/schema';

export async function getStaticPaths() {
	// 1. Static posts from content collection
	const staticPosts = (await getCollection('journal')).filter((p) => !p.data.draft);
	const staticPaths = staticPosts.map((post) => ({
		params: { slug: post.id },
		props: { post, isDynamic: false as const, dynamicData: null },
	}));

	// 2. Published posts from Redis
	let dynamicPaths: any[] = [];
	try {
		const redisPosts = await listJournalPosts({ status: 'published', limit: 100 });
		dynamicPaths = redisPosts.map((dp) => ({
			params: { slug: dp.id },
			props: { post: null, isDynamic: true as const, dynamicData: dp },
		}));
	} catch {
		// Fallback
	}

	return [...staticPaths, ...dynamicPaths];
}

const { post, isDynamic, dynamicData } = Astro.props;

let title = '';
let excerpt = '';
let category = '';
let author = 'Paula Ambrosio';
let publishedDate = new Date();
let updatedDate: Date | undefined;
let featuredImage: any = null;
let imageAlt = '';
let renderedContentHtml = '';
let readingTime = 3;
let seoTitle: string | undefined;
let seoDescription: string | undefined;
let StaticContent: any = null;

if (!isDynamic && post) {
	const rendered = await render(post);
	StaticContent = rendered.Content;
	title = post.data.title;
	excerpt = post.data.excerpt;
	category = post.data.category;
	author = post.data.author;
	publishedDate = post.data.date;
	updatedDate = post.data.updatedDate;
	featuredImage = post.data.featuredImage;
	imageAlt = post.data.imageAlt ?? post.data.title;
	seoTitle = post.data.seoTitle;
	seoDescription = post.data.seoDescription;
	const rawContent = post.body ?? '';
	const wordCount = rawContent.split(/\s+/).filter(Boolean).length;
	readingTime = Math.max(1, Math.ceil(wordCount / 200));
} else if (dynamicData) {
	title = dynamicData.title;
	excerpt = dynamicData.excerpt;
	category = dynamicData.category;
	author = dynamicData.author;
	publishedDate = new Date(dynamicData.publishedAt);
	updatedDate = new Date(dynamicData.updatedAt);
	featuredImage = dynamicData.featuredImage;
	imageAlt = dynamicData.imageAlt || dynamicData.title;
	seoTitle = dynamicData.seoTitle;
	seoDescription = dynamicData.seoDescription;
	readingTime = estimateReadingTime(dynamicData.content);

	const paragraphs = dynamicData.content
		.split(/\n\n+/)
		.map((p) => `<p class="mb-6 leading-relaxed">${p.replace(/\n/g, '<br />')}</p>`)
		.join('');
	renderedContentHtml = paragraphs;
}

const slug = Astro.params.slug;
const ogImage = brandedOg('journal', slug);
const breadcrumbs: BreadcrumbEntry[] = [
	{ name: 'Journal', url: '/journal' },
	{ name: title, url: `/journal/${slug}` },
];

const formattedDate = publishedDate.toLocaleDateString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});
---

<Layout
	title={seoTitle ?? title}
	description={seoDescription ?? excerpt}
	canonical={`/journal/${slug}`}
	ogType="article"
	ogImage={ogImage}
	ogImageAlt={imageAlt}
>
	<Fragment slot="head" set:html={schemaScript(articleSchema({
		image: ogImage,
		path: `/journal/${slug}`,
		title,
		description: seoDescription ?? excerpt,
		datePublished: publishedDate,
		dateModified: updatedDate,
		author,
	}))} />
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: `/journal/${slug}`,
		title: `${title} | Paula Ambrosio Interiors`,
		description: seoDescription ?? excerpt,
		breadcrumbs,
	}))} />

	<article class="container-editorial pt-16 pb-20 lg:pt-24">
		<Breadcrumbs items={breadcrumbs} />

		<header class="mt-10 max-w-3xl">
			<p class="eyebrow text-stone">{category}</p>
			<h1 class="font-display mt-4 text-display leading-tight">{title}</h1>
			<p class="mt-6 text-lg leading-relaxed text-slate">{excerpt}</p>
			<div class="mt-8 flex flex-wrap items-center gap-6 border-y border-sand py-4 text-xs uppercase tracking-widest text-mist">
				<span>{author}</span>
				<span aria-hidden="true">&middot;</span>
				<time datetime={publishedDate.toISOString()}>{formattedDate}</time>
				<span aria-hidden="true">&middot;</span>
				<span>{readingTime} min read</span>
			</div>
		</header>

		<div class="my-14 overflow-hidden bg-sand">
			{typeof featuredImage === 'string' ? (
				<img
					src={featuredImage}
					alt={imageAlt}
					loading="eager"
					decoding="async"
					class="aspect-[16/9] w-full object-cover"
				/>
			) : (
				<Image
					src={featuredImage}
					alt={imageAlt}
					widths={[800, 1400]}
					sizes="(min-width: 1024px) 75vw, 100vw"
					loading="eager"
					decoding="async"
					class="aspect-[16/9] w-full object-cover"
				/>
			)}
		</div>

		<div class="prose-editorial mx-auto max-w-3xl text-graphite">
			{isDynamic ? (
				<div set:html={renderedContentHtml} />
			) : (
				StaticContent && <StaticContent />
			)}
		</div>
	</article>

	<CtaBanner />
</Layout>
