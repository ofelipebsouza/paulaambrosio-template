---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import { articleSchema, webPageSchema, schemaScript } from '../../lib/seo';
import { brandedOg } from '../../lib/og';
import type { BreadcrumbEntry } from '../../lib/seo';
import { serviceUrl, locationUrl } from '../../config';

export async function getStaticPaths() {
	const posts = (await getCollection('journal')).filter((p) => !p.data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const ogImage = brandedOg('journal', post.id);

const breadcrumbs: BreadcrumbEntry[] = [
	{ name: 'Journal', url: '/journal' },
	{ name: post.data.title, url: `/journal/${post.id}` },
];

// Estimate reading time from rendered content (rough: 200 words/min)
const rawContent = post.body ?? '';
const wordCount = rawContent.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const formatRelatedLabel = (value: string | undefined) =>
	value?.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) ?? '';

const formattedDate = post.data.date.toLocaleDateString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});
---

<Layout
	title={post.data.seoTitle ?? post.data.title}
	description={post.data.seoDescription ?? post.data.excerpt}
	canonical={`/journal/${post.id}`}
	ogType="article"
	ogImage={ogImage}
	ogImageAlt={post.data.imageAlt}
>
	<Fragment slot="head" set:html={schemaScript(articleSchema({
		image: ogImage,
		path: `/journal/${post.id}`,
		title: post.data.title,
		description: post.data.seoDescription ?? post.data.excerpt,
		datePublished: post.data.date,
		dateModified: post.data.updatedDate,
		author: post.data.author,
	}))} />
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: `/journal/${post.id}`,
		title: post.data.title,
		description: post.data.seoDescription ?? post.data.excerpt,
		breadcrumbs,
	}))} />

	<article>
		<!-- Article Header -->
		<header class="container-editorial pt-16 lg:pt-24">
			<Breadcrumbs items={breadcrumbs} />

			<!-- Category badge -->
			<div class="mt-10 flex items-center gap-3">
				<span class="eyebrow text-stone">{post.data.category}</span>
			</div>

			<!-- Title -->
			<h1 class="font-display mt-5 max-w-4xl text-3xl leading-tight lg:text-5xl lg:leading-tight">
				{post.data.title}
			</h1>

			<!-- Guarantees a valid h1→h2→h3 outline even when an article opens
			     with an h3 subheading (sr-only — no visual change). -->
			<h2 class="sr-only">In this article</h2>

			<!-- Excerpt -->
			{post.data.excerpt && (
				<p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate">
					{post.data.excerpt}
				</p>
			)}

			<!-- Article meta: author · date · reading time -->
			<div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-b border-sand/60 py-5 text-sm">
				<!-- Author -->
				<div class="flex items-center gap-2.5">						<div class="flex h-9 w-9 items-center justify-center rounded-full bg-coffee/10 text-xs font-bold uppercase tracking-wide text-coffee-deep">
						{post.data.author.split(' ').map((n: string) => n[0]).join('')}
					</div>
					<div>
						<p class="font-medium text-ink text-[0.8rem] leading-tight">{post.data.author}</p>
						<p class="text-[0.65rem] uppercase tracking-widest text-stone">Author</p>
					</div>
				</div>

				<!-- Separator -->
				<span class="hidden sm:block h-5 w-px bg-sand/80"></span>

				<!-- Date -->
				<div class="flex items-center gap-1.5 text-graphite">
					<svg viewBox="0 0 20 20" class="h-4 w-4 text-stone" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<rect x="3" y="4" width="14" height="14" rx="2"></rect>
						<path d="M3 8h14M7 2v4M13 2v4"></path>
					</svg>
					<time datetime={post.data.date.toISOString()} class="text-[0.8rem]">
						{formattedDate}
					</time>
				</div>

				<!-- Separator -->
				<span class="hidden sm:block h-5 w-px bg-sand/80"></span>

				<!-- Reading time -->
				<div class="flex items-center gap-1.5 text-graphite">
					<svg viewBox="0 0 20 20" class="h-4 w-4 text-stone" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<circle cx="10" cy="10" r="8"></circle>
						<path d="M10 6v4l3 2"></path>
					</svg>
					<span class="text-[0.8rem]">{readingTime} min read</span>
				</div>
			</div>
		</header>

		<!-- Hero Image -->
		<div class="container-editorial mt-10">
			<div class="overflow-hidden rounded-sm">
				<Image
					src={post.data.featuredImage}
					alt={post.data.imageAlt ?? post.data.title}
					widths={[768, 1200, 1600]}
					sizes="(min-width: 80rem) 80rem, 100vw"
					loading="eager"
					quality={70}
					decoding="async"
					class="aspect-[16/9] w-full object-cover transition-transform duration-700 hover:scale-[1.02]"
				/>
			</div>
			{post.data.imageAlt && (
				<p class="mt-3 text-center text-xs text-stone italic">{post.data.imageAlt}</p>
			)}
		</div>

		<!-- Article Body -->
		<div class="prose-editorial container-editorial max-w-3xl py-12 lg:py-16">
			<Content />
		</div>

		<!-- Continue Exploring -->
		{(post.data.relatedProjects?.length || post.data.relatedServices?.length) && (
			<aside class="container-editorial max-w-3xl pb-16">
				<div class="border-t border-sand pt-8 text-sm">
					<p class="eyebrow text-stone">Continue exploring</p>
					<ul class="mt-4 space-y-2 text-graphite">
						{post.data.relatedServices?.filter(Boolean).map((s) => (
							<li><a class="underline decoration-brass/60 underline-offset-4" href={serviceUrl(s)}>{formatRelatedLabel(s)}</a></li>
						))}
						{post.data.relatedProjects?.filter(Boolean).map((p) => (
							<li><a class="underline decoration-brass/60 underline-offset-4" href={`/projects/${p}`}>{formatRelatedLabel(p)}</a></li>
						))}
					</ul>
				</div>
			</aside>
		)}
	</article>

	<CtaBanner />
</Layout>
