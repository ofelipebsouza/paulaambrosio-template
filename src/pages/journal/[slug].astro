---
/**
 * /journal/[slug]/ — Single Journal article page.
 *
 * Rendered on-demand (SSR) so articles created via Admin or Hermes
 * are visible immediately or upon scheduled release time.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import { articleSchema, webPageSchema, schemaScript } from '../../lib/seo';
import { brandedOg } from '../../lib/og';
import type { BreadcrumbEntry } from '../../lib/seo';
import { getJournalPost, incrementPostViews } from '../../lib/journal/store';
import { estimateReadingTime } from '../../lib/journal/schema';
import { readSession } from '../../lib/crm/auth';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/journal/');

// 1. Check static markdown collections first
const staticPosts = await getCollection('journal');
const staticPost = staticPosts.find((p) => p.id === slug && !p.data.draft);

let title = '';
let excerpt = '';
let category = '';
let author = 'Paula Ambrosio';
let publishedDate = new Date();
let updatedDate: Date | undefined;
let featuredImage: any = null;
let imageAlt = '';
let renderedContentHtml = '';
let readingTime = 3;
let isDynamic = false;
let seoTitle: string | undefined;
let seoDescription: string | undefined;

let StaticContent: any = null;

if (staticPost) {
	const rendered = await render(staticPost);
	StaticContent = rendered.Content;
	title = staticPost.data.title;
	excerpt = staticPost.data.excerpt;
	category = staticPost.data.category;
	author = staticPost.data.author;
	publishedDate = staticPost.data.date;
	updatedDate = staticPost.data.updatedDate;
	featuredImage = staticPost.data.featuredImage;
	imageAlt = staticPost.data.imageAlt ?? staticPost.data.title;
	seoTitle = staticPost.data.seoTitle;
	seoDescription = staticPost.data.seoDescription;
	const rawContent = staticPost.body ?? '';
	const wordCount = rawContent.split(/\s+/).filter(Boolean).length;
	readingTime = Math.max(1, Math.ceil(wordCount / 200));
} else {
	// 2. Check dynamic Redis store
	const dynamicPost = await getJournalPost(slug);
	if (!dynamicPost) {
		return Astro.rewrite('/404');
	}

	// Check publication status: scheduled or draft require active session
	const isStaff = Boolean(readSession(Astro.request));
	const isDue = dynamicPost.status === 'published' || (dynamicPost.status === 'scheduled' && (dynamicPost.scheduledFor ?? 0) <= Date.now());

	if (!isDue && !isStaff) {
		return Astro.rewrite('/404');
	}

	title = dynamicPost.title;
	excerpt = dynamicPost.excerpt;
	category = dynamicPost.category;
	author = dynamicPost.author;
	publishedDate = new Date(dynamicPost.publishedAt);
	updatedDate = new Date(dynamicPost.updatedAt);
	featuredImage = dynamicPost.featuredImage;
	imageAlt = dynamicPost.imageAlt || dynamicPost.title;
	seoTitle = dynamicPost.seoTitle;
	seoDescription = dynamicPost.seoDescription;
	readingTime = estimateReadingTime(dynamicPost.content);
	isDynamic = true;

	// Simple paragraphs / markdown line breaks rendering
	const paragraphs = dynamicPost.content
		.split(/\n\n+/)
		.map((p) => `<p class="mb-6 leading-relaxed">${p.replace(/\n/g, '<br />')}</p>`)
		.join('');
	renderedContentHtml = paragraphs;

	// Count view in background
	void incrementPostViews(slug);
}

const ogImage = brandedOg('journal', slug);
const breadcrumbs: BreadcrumbEntry[] = [
	{ name: 'Journal', url: '/journal' },
	{ name: title, url: `/journal/${slug}` },
];

const formattedDate = publishedDate.toLocaleDateString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});
---

<Layout
	title={seoTitle ?? title}
	description={seoDescription ?? excerpt}
	canonical={`/journal/${slug}`}
	ogType="article"
	ogImage={ogImage}
	ogImageAlt={imageAlt}
>
	<Fragment slot="head" set:html={schemaScript(articleSchema({
		image: ogImage,
		path: `/journal/${slug}`,
		title,
		description: seoDescription ?? excerpt,
		datePublished: publishedDate,
		dateModified: updatedDate,
		author,
	}))} />
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: `/journal/${slug}`,
		title: `${title} | Paula Ambrosio Interiors`,
		description: seoDescription ?? excerpt,
		breadcrumbs,
	}))} />

	<article class="container-editorial pt-16 pb-20 lg:pt-24">
		<Breadcrumbs items={breadcrumbs} />

		<header class="mt-10 max-w-3xl">
			<p class="eyebrow text-stone">{category}</p>
			<h1 class="font-display mt-4 text-display leading-tight">{title}</h1>
			<p class="mt-6 text-lg leading-relaxed text-slate">{excerpt}</p>
			<div class="mt-8 flex flex-wrap items-center gap-6 border-y border-sand py-4 text-xs uppercase tracking-widest text-mist">
				<span>{author}</span>
				<span aria-hidden="true">&middot;</span>
				<time datetime={publishedDate.toISOString()}>{formattedDate}</time>
				<span aria-hidden="true">&middot;</span>
				<span>{readingTime} min read</span>
			</div>
		</header>

		<div class="my-14 overflow-hidden bg-sand">
			{typeof featuredImage === 'string' ? (
				<img
					src={featuredImage}
					alt={imageAlt}
					loading="eager"
					decoding="async"
					class="aspect-[16/9] w-full object-cover"
				/>
			) : (
				<Image
					src={featuredImage}
					alt={imageAlt}
					widths={[800, 1400]}
					sizes="(min-width: 1024px) 75vw, 100vw"
					loading="eager"
					decoding="async"
					class="aspect-[16/9] w-full object-cover"
				/>
			)}
		</div>

		<div class="prose-editorial mx-auto max-w-3xl text-graphite">
			{isDynamic ? (
				<div set:html={renderedContentHtml} />
			) : (
				StaticContent && <StaticContent />
			)}
		</div>
	</article>

	<CtaBanner />
</Layout>
