---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import { articleSchema, webPageSchema, schemaScript } from '../../lib/seo';
import type { BreadcrumbEntry } from '../../lib/seo';

export async function getStaticPaths() {
	const posts = (await getCollection('journal')).filter((p) => !p.data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const breadcrumbs: BreadcrumbEntry[] = [
	{ name: 'Journal', url: '/journal' },
	{ name: post.data.title, url: `/journal/${post.id}` },
];
---

<Layout
	title={post.data.seoTitle ?? post.data.title}
	description={post.data.seoDescription ?? post.data.excerpt}
	canonical={`/journal/${post.id}`}
	ogType="article"
	ogImage={post.data.featuredImage.src}
>
	<Fragment slot="head" set:html={schemaScript(articleSchema({
		path: `/journal/${post.id}`,
		title: post.data.title,
		description: post.data.seoDescription ?? post.data.excerpt,
		datePublished: post.data.date,
		dateModified: post.data.updatedDate,
		author: post.data.author,
		image: post.data.featuredImage.src,
	}))} />
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: `/journal/${post.id}`,
		title: post.data.title,
		description: post.data.seoDescription ?? post.data.excerpt,
		breadcrumbs,
	}))} />

	<article>
		<header class="container-editorial pt-16 lg:pt-24">
			<Breadcrumbs items={breadcrumbs} />
			<p class="eyebrow mt-10 text-stone">{post.data.category}</p>
			<h1 class="font-display mt-4 max-w-3xl text-4xl lg:text-6xl">{post.data.title}</h1>
			<p class="mt-6 text-sm uppercase tracking-widest text-mist">
				By {post.data.author} ·
				<time datetime={post.data.date.toISOString()}>
					{post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
				</time>
			</p>
		</header>

		<div class="container-editorial mt-12">
			<Image
				src={post.data.featuredImage}
				alt={post.data.imageAlt ?? post.data.title}
				widths={[768, 1200, 1600]}
				sizes="(min-width: 80rem) 80rem, 100vw"
				loading="eager"
				priority={true}
				quality={60}
				decoding="async"
				class="aspect-[16/9] w-full object-cover"
			/>
		</div>

		<div class="prose-editorial container-editorial max-w-3xl py-16 lg:py-20">
			<Content />
		</div>

		{(post.data.relatedProjects?.length || post.data.relatedServices?.length) && (
			<aside class="container-editorial max-w-3xl pb-16">
				<div class="border-t border-sand pt-8 text-sm">
					<p class="eyebrow text-stone">Continue exploring</p>
					<ul class="mt-4 space-y-2 text-graphite">
						{post.data.relatedServices?.map((s) => (
							<li><a class="underline decoration-brass/60 underline-offset-4" href={`/services/${s}`}>{s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())}</a></li>
						))}
						{post.data.relatedProjects?.map((p) => (
							<li><a class="underline decoration-brass/60 underline-offset-4" href={`/projects/${p}`}>{p.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())}</a></li>
						))}
					</ul>
				</div>
			</aside>
		)}
	</article>

	<CtaBanner />
</Layout>
