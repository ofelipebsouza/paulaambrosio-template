---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { webPageSchema, schemaScript } from '../lib/seo';
import type { BreadcrumbEntry } from '../lib/seo';

const breadcrumbs: BreadcrumbEntry[] = [{ name: 'Privacy', url: '/privacy' }];
---

<Layout
	title="Privacy Policy"
	description="How Paula Ambrosio Interiors collects, uses and protects information submitted through this website."
	canonical="/privacy"
>
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: '/privacy',
		title: 'Privacy Policy | Paula Ambrosio Interiors',
		description: 'Privacy policy for the Paula Ambrosio Interiors website.',
		breadcrumbs,
	}))} />

	<article class="container-editorial max-w-3xl pt-16 pb-24 lg:pt-24">
		<Breadcrumbs items={breadcrumbs} />
		<h1 class="font-display mt-10 text-4xl">Privacy Policy</h1>
		<p class="mt-4 text-sm uppercase tracking-widest text-mist">
			Last updated: <time datetime="2026-09-12">September 12, 2026</time>
		</p>

		<div class="prose-editorial mt-12">
			<h2>Information we collect</h2>
			<p>
				When you submit an inquiry through this website, we collect the information you provide,
				your name, contact details and details about your project. We use this information solely
				to respond to your inquiry and to communicate about our services.
			</p>
			<h2>How information is used</h2>
			<p>
				Inquiry information is used to schedule consultations and respond to your request. We do
				not sell or share your personal information with third parties for their own marketing.
			</p>
			<h2>Analytics</h2>
			<p>
				We may use privacy-respecting analytics to understand how visitors use this site. No
				advertising trackers are loaded.
			</p>
			<h2>Contact</h2>
			<p>
				For any privacy question, contact
				<a href="mailto:info@paulaambrosio.com">info@paulaambrosio.com</a>.
			</p>
		</div>
	</article>
</Layout>
