---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { webPageSchema, schemaScript } from '../../lib/seo';
import type { BreadcrumbEntry } from '../../lib/seo';
import { locationUrl } from '../../config';

const locations = (await getCollection('locations')).filter((l) => !l.data.draft);

const breadcrumbs: BreadcrumbEntry[] = [{ name: 'Locations', url: '/locations' }];
---

<Layout
	title="Luxury Interior Design South Florida | Paula Ambrosio Interiors"
	description="Explore Paula Ambrosio Interiors' luxury interior design services across Miami and selected South Florida communities."
	canonical="/locations"
>
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: '/locations',
		title: 'Luxury Interior Design Across South Florida',
		description: 'Miami-based. International perspective. Local project expertise.',
		breadcrumbs,
	}))} />

	<section class="container-editorial pt-16 pb-14 lg:pt-24">
		<Breadcrumbs items={breadcrumbs} />
		<p class="eyebrow mt-10 text-stone">Locations</p>
		<h1 class="font-display mt-4 max-w-2xl text-display">
			Luxury Interior Design Across South Florida
		</h1>
		<p class="mt-6 max-w-xl text-lede text-slate">
			Miami-based. International perspective. Local project expertise.
		</p>
	</section>

	<section class="container-editorial pb-24">
		<ul class="grid gap-px overflow-hidden border border-sand bg-sand md:grid-cols-2">
			{locations.map((location) => (
				<li class="bg-bone">
					<a href={locationUrl(location.id)} class="group flex h-full flex-col p-8 transition-colors hover:bg-linen lg:p-10">
						<span class="font-display text-2xl lg:text-3xl">{location.data.title}</span>
						<p class="mt-3 max-w-md text-sm leading-relaxed text-slate">{location.data.introduction}</p>
						<span aria-hidden="true" class="eyebrow mt-8 text-stone">Explore {location.data.title} →</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<CtaBanner
		title="Begin Your Project"
		body="Tell us about your residence or property. We will schedule a confidential discovery session with our design team."
		primaryLabel="Request a Private Consultation"
		secondaryLabel="Explore Our Work"
		secondaryHref="/projects"
	/>
</Layout>
