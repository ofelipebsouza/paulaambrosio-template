---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';
import { webPageSchema, schemaScript } from '../lib/seo';
import type { BreadcrumbEntry } from '../lib/seo';
import floridaDesignPhoto from '../assets/projects/home-aa/web/01.webp';
import homebodyPhoto from '../assets/projects/home-aa/web/03.webp';
import coastalMinimalismPhoto from '../assets/projects/home-s/web/01.webp';
import etherealGeometryPhoto from '../assets/projects/home-dr/web/01.webp';
import studioPortrait from '../assets/paula-profile.webp';

const breadcrumbs: BreadcrumbEntry[] = [{ name: 'Press', url: '/press' }];

const articles: { title: string; publication: string; description: string; image: string; width: number; height: number; url: string; imageAlt?: string; imageCaption?: string }[] = [
	{
		title: 'Featured in Florida Design Miami | Volume 22.3 (2026)',
		publication: 'Florida Design',
		description: 'Explore our studio’s sponsored magazine feature on a warm modern turnkey residence, with original project photography.',
		image: floridaDesignPhoto.src,
		width: floridaDesignPhoto.width,
		height: floridaDesignPhoto.height,
		url: '/press/florida-design-miami-22-3/',
	},
	{
		title: 'The Details That Define a Luxury Home, From Custom Millwork to Curated Furniture',
		publication: 'Homebody Magazine · Sponsored feature',
		description: 'An exploration of the studio’s approach to custom cabinetry, thoughtful materials, lighting and fully coordinated interiors. November 2026.',
		image: homebodyPhoto.src,
		width: homebodyPhoto.width,
		height: homebodyPhoto.height,
		imageAlt: 'Custom oak cabinetry with an illuminated glass display and stone coffee station',
		imageCaption: 'Representative studio portfolio photograph: Gabriel Matarazzo (GABBA Visuals).',
		url: 'https://www.homebodymagazine.com/the-sanctuary/the-details-that-define-a-luxury-home-from-custom-millwork-to-curated-furniture',
	},
	{
		title: 'A Study in Coastal Minimalism — SM Residence by Paula Ambrosio',
		publication: 'The Architectural Authority',
		description: 'A featured Boca Raton residence that brings together quiet material palettes, modern cabinetry and light-filled interiors.',
		image: coastalMinimalismPhoto.src,
		width: coastalMinimalismPhoto.width,
		height: coastalMinimalismPhoto.height,
		imageAlt: 'Pale kitchen island and integrated cabinetry in a Boca Raton residence',
		imageCaption: 'Project photography: MCA Estudio.',
		url: 'https://www.thearchitecturalauthority.com/article/a-study-in-coastal-minimalism-sm-residence-by-paula-ambrosio',
	},
	{
		title: 'Ethereal Geometry – D&R Project by Paula Ambrosio',
		publication: 'The Architectural Authority',
		description: 'A project feature exploring the balance of sculptural architecture, custom millwork and layered lighting in a Boca Raton home.',
		image: etherealGeometryPhoto.src,
		width: etherealGeometryPhoto.width,
		height: etherealGeometryPhoto.height,
		imageAlt: 'Double height foyer with a curved white staircase and pale stone flooring',
		imageCaption: 'Project photography: GABBA Visuals.',
		url: 'https://www.thearchitecturalauthority.com/article/ethereal-geometry-dr-project-by-paula-ambrosio',
	},
	{
		title: 'DCOTA Welcomes 300+ Professional Designers and Enthusiasts to WINTER MARKET 2024',
		publication: 'Miami Living Magazine',
		description: 'Coverage of the 2024 DCOTA Winter Market, where Paula joined a Brazilian design panel moderated by Florida Design’s editorial director.',
		image: studioPortrait.src,
		width: studioPortrait.width,
		height: studioPortrait.height,
		imageAlt: 'Portrait of the studio cofounders, Paula and Amanda Ambrosio',
		imageCaption: 'Studio portrait of the cofounders; not event photography.',
		url: 'https://www.miamilivingmagazine.com/post/dcota-welcomes-300-professional-designers-and-enthusiasts-to-winter-market-2024',
	},
	{
		title: 'A Trajetória de Uma Brasileira nos EUA',
		publication: 'Ruxone',
		description: 'The journey of a Brazilian designer who turned challenges into achievements in the United States.',
		image: 'https://framerusercontent.com/images/cGOQZQKGMW5AU6XUjE3GzZi6IE.png?width=279&height=450',
		width: 279,
		height: 450,
		url: 'https://ruxone.com.br/paula-ambrosio-a-trajetoria-de-uma-brasileira-que-transformou-desafios-em-conquistas-nos-estados-unidos/',
	},
	{
		title: 'Host Up: Receba em Grande Estilo',
		publication: 'Hotmart',
		description: 'Paula Ambrosio featured as a reference in luxury hospitality design and hosting.',
		image: 'https://framerusercontent.com/images/OgYsofq5sjqJlqlwOqIJVp5uQ.png?width=279&height=450',
		width: 279,
		height: 450,
		url: 'https://hotmart.com/pt-br/marketplace/produtos/host-up-receba-em-grande-estilo/N95610430C',
	},
	{
		title: 'Turnkey Contemporary Marvel in Boca Raton',
		publication: 'Dwell',
		description: 'A turnkey contemporary residence in Boca Raton with sleek features and loft, designed by Paula Ambrosio Interior Design.',
		image: 'https://framerusercontent.com/images/lnIhFjlj0IlQ30z3Lh2tr9uj4A.png?width=279&height=450',
		width: 279,
		height: 450,
		url: 'https://www.dwell.com/home/turnkey-contemporary-marvel-in-boca-raton-with-sleek-features-and-loft-9ab9ca10',
	},
];
---

<Layout
	title="Press & Publications | Paula Ambrosio Interior Design"
	description="Paula Ambrosio Interior Design featured in Florida Design, Dwell, and international publications. Luxury interior design press coverage from Miami."
	canonical="/press"
>
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: '/press',
		title: 'Press | Paula Ambrosio Interior Design',
		description: 'Press coverage and publications featuring Paula Ambrosio Interior Design.',
		breadcrumbs,
	}))} />

	<section class="container-editorial pt-16 pb-14 lg:pt-24">
		<Breadcrumbs items={breadcrumbs} />
		<p class="eyebrow mt-10 text-stone">Press</p>
		<h1 class="font-display mt-4 max-w-2xl text-display">
			Featured in
		</h1>
		<p class="mt-6 max-w-xl text-lede text-slate">
			Our work and story have been recognized by leading design publications and media outlets across the United States and Brazil.
		</p>
	</section>

	<section class="container-editorial pb-24">
		<h2 class="sr-only">Featured press coverage</h2>
		<div class="columns-2 gap-x-4 sm:gap-x-8 lg:columns-3">
			{articles.map((article) => (
				<a
					href={article.url}
					target={article.url.startsWith('/') ? undefined : '_blank'}
					rel={article.url.startsWith('/') ? undefined : 'noopener noreferrer'}
					class="group mb-4 block break-inside-avoid bg-linen transition-colors hover:bg-sand sm:mb-8"
				>
					<div class="overflow-hidden">
						<img
							src={article.image}
							alt={article.imageAlt ?? article.title}
							width={article.width}
							height={article.height}
							class="h-auto w-full transition-transform duration-700 group-hover:scale-[1.03]"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<div class="p-4 sm:p-5">
						<p class="eyebrow text-stone">{article.publication}</p>
						<h3 class="font-display mt-2 text-lg leading-snug">{article.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate">{article.description}</p>
						{article.imageCaption && <p class="mt-3 text-xs leading-relaxed text-slate">{article.imageCaption}</p>}
					</div>
				</a>
			))}
		</div>
	</section>

	<CtaBanner />
</Layout>
