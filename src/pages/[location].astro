---
import { getCollection } from 'astro:content';
import LocationPage from '../components/locations/LocationPage.astro';
import { locationUrl } from '../config';

export async function getStaticPaths() {
  const locations = (await getCollection('locations')).filter((l) => !l.data.draft && l.id !== 'coral-gables');
  return locations.map((location) => ({
    params: { location: locationUrl(location.id).replace(/^\//, '') },
    props: { location },
  }));
}
const { location } = Astro.props;
---
<LocationPage location={location} />
