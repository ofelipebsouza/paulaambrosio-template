---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/projects/ProjectGrid.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';
import { webPageSchema, schemaScript } from '../lib/seo';
import { serviceUrl, locationUrl } from '../config';
import { HOME_OG } from '../lib/og';
import paulaProfile from '../assets/paula-profile.webp';

const allProjects = (await getCollection('projects')).filter((p) => !p.data.draft);

const heroSlides = allProjects.filter((p) => p.data.projectType !== 'Renders').slice(0, 9).map((p) => ({
	src: p.data.featuredImage,
	alt: p.data.imageAlt ?? p.data.title,
}));

const featuredProjects = allProjects
	.sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));

const latestJournal = (await getCollection('journal'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const processSteps = [
	{ label: 'Discovery',               desc: 'A confidential conversation to understand your vision, lifestyle and goals.' },
	{ label: 'Concept & Design',        desc: 'Mood boards, spatial concepts and the creative direction that will guide the project.' },
	{ label: 'Design Development',      desc: 'Detailed drawings, material selections, custom specifications and finish schedules.' },
	{ label: 'Procurement & Coordination', desc: 'Every piece sourced, ordered and tracked, managed with precision.' },
	{ label: 'Installation',            desc: 'Our team orchestrates delivery, trade coordination and white-glove installation.' },
	{ label: 'Reveal',                  desc: 'Your home, complete. Every detail considered and every element in place.' },
];
---

<Layout
	title="Luxury Interior Design in Miami | Paula Ambrosio Interiors"
	description="Paula Ambrosio Interiors is a Miami luxury interior design studio creating full-service and turnkey interiors for residences, penthouses and hospitality spaces across South Florida."
	canonical="/"
	ogImage={HOME_OG}
	ogImageAlt={allProjects[0]?.data.imageAlt}
>
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: '/',
		title: 'Paula Ambrosio Interiors | Luxury Interior Design in Miami',
		description: 'Full-service and turnkey luxury interior design for Miami and South Florida.',
	}))} />

	<!-- 1. Hero: crossfade carousel, title sits below -->
	<section class="bg-bone pb-20 text-center lg:pb-28">
		<div id="hero-carousel" class="relative w-full overflow-hidden min-h-[80vw] sm:min-h-0 sm:aspect-[16/10] lg:aspect-[21/8]">
			{heroSlides.map((slide, i) => (
				<div
					class="hero-slide absolute inset-0 transition-opacity duration-[1400ms] ease-in-out"
					style={`opacity: ${i === 0 ? '1' : '0'};`}
					aria-hidden={i !== 0 ? 'true' : undefined}
				>
					<Image
						src={slide.src}
						alt={slide.alt}
						widths={[768, 1200, 1600]}
						sizes="100vw"
						loading={i === 0 ? 'eager' : 'lazy'}
						fetchpriority={i === 0 ? 'high' : 'auto'}
						quality={60}
						decoding="async"
						class="h-full w-full object-cover"
					/>
				</div>
			))}

			<!-- Gradient fade into bone background -->
			<div class="pointer-events-none absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-bone via-bone/70 to-transparent lg:h-64"></div>

			<!-- Dot indicators -->
			<div class="absolute bottom-5 left-1/2 -translate-x-1/2 flex items-center gap-2.5 z-10" role="tablist" aria-label="Select image">
				{heroSlides.map((_, i) => (
					<button
						type="button"
						role="tab"
						aria-selected={i === 0 ? 'true' : 'false'}
						aria-label={`Image ${i + 1}`}
						data-index={i}
						class="hero-dot block h-1 rounded-full bg-bone/50 transition-all duration-500 ease-in-out"
						style={`width: ${i === 0 ? '1.75rem' : '0.5rem'}; opacity: ${i === 0 ? '1' : '0.5'};`}
					></button>
				))}
			</div>
		</div>

		<div class="container-editorial relative">
			<h1 class="font-display mx-auto max-w-4xl text-4xl leading-[1.08] tracking-[0.04em] text-ink uppercase sm:text-5xl lg:text-6xl">
				Luxury Interior Design in Miami
			</h1>
			<p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate">
				Turnkey luxury interiors for residences across South Florida, delivered in as little as 40 days.
			</p>
			<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
				<button type="button" class="inquiry-open btn-primary" data-analytics-event="cta_start_project" data-analytics-location="hero">Start Your Project</button>
				<a href="/services" class="btn-secondary" data-analytics-event="cta_explore_services" data-analytics-location="hero">Explore Our Services</a>
			</div>
		</div>
	</section>

	<!-- 2. Intro -->
	<section class="container-editorial py-24 lg:py-32">
		<div class="mx-auto max-w-3xl text-center fade-up">
			<div class="ornament-divider mb-8">
				<span class="ornament-divider-diamond"></span>
			</div>
			<p class="eyebrow text-stone mb-6 tracking-widest">Full-Service &amp; Turnkey Interior Design</p>
			<p class="font-display text-2xl leading-relaxed text-graphite lg:text-[1.85rem]">
				For 21 years and more than 2,000 completed projects, Paula Ambrosio Interior Design has delivered luxury interiors that are as functional as they are beautiful. From our Miami studio, sisters Paula and Amanda Ambrosio serve clients across South Florida and around the world through a turnkey process that transforms an empty residence into a move-in-ready home in as little as 40 days.
			</p>
			<div class="ornament-divider mt-8">
				<span class="ornament-divider-diamond"></span>
			</div>
		</div>
	</section>

	<!-- 3. Services -->
	<section class="bg-bone py-28 lg:py-36 border-t border-sand">
		<div class="container-editorial">
			<div class="text-center mb-20 fade-up">
				<div class="ornament-divider mb-8">
					<span class="ornament-divider-diamond"></span>
				</div>
				<p class="eyebrow text-stone tracking-widest">What We Do</p>
				<h2 class="font-display mt-5 text-4xl lg:text-5xl leading-tight">A complete design service, from concept to keys in hand.</h2>
				<p class="mx-auto mt-6 max-w-2xl leading-relaxed text-slate">
					From luxury residences to turnkey estates and hospitality spaces, we deliver every project as a singular, fully realized vision with precision.
				</p>
			</div>

			<div class="grid gap-6 lg:grid-cols-3 fade-up stagger-children">
				<!-- Residential -->
				<a href={serviceUrl('luxury-residential-interior-design-miami')} class="group relative flex flex-col bg-linen p-10 lg:p-12 transition-all duration-500 hover:bg-graphite hover:text-bone" data-analytics-event="service_open" data-analytics-service="luxury-residential-interior-design-miami" data-analytics-location="services">
					<span class="font-display block text-6xl leading-none text-brass/30 transition-colors duration-500 group-hover:text-brass/60 select-none">01</span>
					<p class="eyebrow text-stone mt-4 transition-colors duration-500 group-hover:text-bone/60">Residential</p>
					<h3 class="font-display mt-3 text-3xl leading-snug">Luxury Residential Interior Design</h3>
					<p class="mt-5 flex-1 leading-relaxed text-slate transition-colors duration-500 group-hover:text-bone/70">
						From waterfront residences and penthouses to custom homes and extensive renovations, spaces defined by natural light, exceptional craftsmanship and understated luxury.
					</p>
					<span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold tracking-widest uppercase text-coffee transition-colors duration-500 group-hover:text-brass group-hover:translate-x-1">
						Explore residential
						<svg class="h-4 w-4 transition-transform duration-500 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
					</span>
				</a>

				<!-- Turnkey -->
				<a href={serviceUrl('turnkey-interior-design-miami')} class="group relative flex flex-col bg-linen p-10 lg:p-12 transition-all duration-500 hover:bg-graphite hover:text-bone" data-analytics-event="cta_turnkey" data-analytics-location="services" data-analytics-service="turnkey-interior-design-miami">
					<span class="font-display block text-6xl leading-none text-brass/30 transition-colors duration-500 group-hover:text-brass/60 select-none">02</span>
					<p class="eyebrow text-stone mt-4 transition-colors duration-500 group-hover:text-bone/60">Turnkey</p>
					<h3 class="font-display mt-3 text-3xl leading-snug">Arrive. Everything Is Ready.</h3>
					<p class="mt-5 flex-1 leading-relaxed text-slate transition-colors duration-500 group-hover:text-bone/70">
						Design, furnishings, lighting, custom pieces, procurement, installation and final styling, delivered as one fully resolved residence, ready for arrival.
					</p>
					<span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold tracking-widest uppercase text-coffee transition-colors duration-500 group-hover:text-brass group-hover:translate-x-1">
						Discover turnkey
						<svg class="h-4 w-4 transition-transform duration-500 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
					</span>
				</a>

				<!-- Hospitality -->
				<a href={serviceUrl('hospitality-interior-design-miami')} class="group relative flex flex-col bg-linen p-10 lg:p-12 transition-all duration-500 hover:bg-graphite hover:text-bone" data-analytics-event="service_open" data-analytics-service="hospitality-interior-design-miami" data-analytics-location="services">
					<span class="font-display block text-6xl leading-none text-brass/30 transition-colors duration-500 group-hover:text-brass/60 select-none">03</span>
					<p class="eyebrow text-stone mt-4 transition-colors duration-500 group-hover:text-bone/60">Hospitality</p>
					<h3 class="font-display mt-3 text-3xl leading-snug">Hospitality Interior Design</h3>
					<p class="mt-5 flex-1 leading-relaxed text-slate transition-colors duration-500 group-hover:text-bone/70">
						Boutique hotels, private lounges, wellness retreats and upscale beauty destinations, environments designed around experience, flow and identity.
					</p>
					<span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold tracking-widest uppercase text-coffee transition-colors duration-500 group-hover:text-brass group-hover:translate-x-1">
						Explore hospitality
						<svg class="h-4 w-4 transition-transform duration-500 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
					</span>
				</a>
			</div>
		</div>
	</section>

	<!-- 4. Selected projects -->
	<section class="bg-linen py-28 lg:py-36 border-t border-sand">
		<div class="container-editorial">
			<div class="mb-16 flex flex-wrap items-end justify-between gap-6 fade-up">
				<div>
					<p class="eyebrow text-stone">Projects</p>
					<h2 class="font-display mt-5 text-4xl">Recent work</h2>
				</div>
				<a href="/projects" class="eyebrow text-stone underline decoration-brass/60 underline-offset-8 hover:text-ink transition-colors">View all projects</a>
			</div>
			<div class="fade-up">
				<ProjectGrid projects={featuredProjects} columns={3} />
			</div>
		</div>
	</section>

	<!-- 5. Turnkey dark positioning -->
	<section class="bg-graphite py-28 text-bone lg:py-36">
		<div class="container-editorial grid gap-12 lg:grid-cols-12 fade-up">
			<div class="lg:col-span-5">
				<p class="eyebrow text-brass">Turnkey Interior Design</p>
				<h2 class="font-display mt-5 text-4xl lg:text-5xl leading-tight">Turnkey is not decorating. It's logistics.</h2>
				<a href={serviceUrl('turnkey-interior-design-miami')} class="btn-primary mt-10" data-analytics-event="cta_turnkey" data-analytics-location="turnkey" data-analytics-service="turnkey-interior-design-miami">Discover turnkey design</a>
			</div>
			<div class="lg:col-span-6 lg:col-start-7 flex flex-col justify-center">
				<div class="ornament-divider mb-8 justify-start">
					<span class="ornament-divider-diamond" style="background:var(--color-brass);"></span>
				</div>
				<p class="text-lg leading-relaxed text-bone/80">
					What seems like magic is logistics. Opening the door to a finished home requires schedule, specification and coordination we execute with precision. For international buyers and second-home owners in Miami, our turnkey process delivers a fully resolved residence, furnished, styled and ready to live in, in as little as 40 days.
				</p>
			</div>
		</div>
	</section>

	<!-- 7. Locations -->
	<section class="container-editorial py-28 lg:py-36">
		<div class="mb-16 flex flex-wrap items-end justify-between gap-6 fade-up">
			<div>
				<p class="eyebrow text-stone">Locations</p>
				<h2 class="font-display mt-5 text-4xl">Serving Miami and South Florida</h2>
			</div>
			<a href="/locations" class="eyebrow text-stone underline decoration-brass/60 underline-offset-8 hover:text-ink transition-colors">All locations</a>
		</div>
		<ul class="grid grid-cols-2 gap-px bg-sand sm:grid-cols-3 lg:grid-cols-4 fade-up stagger-children">
			{['Miami', 'Miami Beach', 'Sunny Isles Beach', 'Aventura', 'Bal Harbour', 'Boca Raton', 'Palm Beach'].map((loc) => (
				<li class="bg-bone">
					<a
						href={locationUrl(loc.toLowerCase().replace(/\s+/g, '-'))}
						class="group flex h-full min-h-[8rem] flex-col justify-between p-7 transition-colors duration-300 hover:bg-linen"
					>
						<span class="font-display text-xl transition-colors duration-300 group-hover:text-coffee">{loc}</span>
						<span aria-hidden="true" class="mt-6 eyebrow text-brass transition-transform duration-500 group-hover:translate-x-1.5">→</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<!-- 8. About Paula -->
	<section class="container-editorial py-28 lg:py-36 border-t border-sand">
		<div class="grid items-center gap-16 lg:grid-cols-12">
			<div class="lg:col-span-5 fade-up">
				<div class="relative overflow-hidden border border-sand">
					<Image
						src={paulaProfile}
						alt="Paula Ambrosio, Founder and Principal Designer of Paula Ambrosio Interiors"
						widths={[400, 600, 800]}
						sizes="(min-width: 1024px) 33vw, 50vw"
						loading="lazy"
						quality={75}
						decoding="async"
						class="aspect-[4/5] w-full object-cover"
					/>
				</div>
			</div>

			<div class="lg:col-span-6 lg:col-start-7 fade-up">
				<p class="eyebrow text-stone">About Paula</p>
				<h2 class="font-display mt-5 text-4xl leading-tight lg:text-5xl">Design guided by experience, delivered with precision.</h2>
				<div class="mt-6 h-px w-12 bg-brass/50"></div>
				<p class="mt-8 leading-relaxed text-slate">
					Paula Ambrosio Interior Design is a luxury interior design studio in Miami specializing in high-end residential interior design, home renovations, custom interiors and full-service turnkey projects throughout Miami and South Florida.
				</p>
				<p class="mt-5 leading-relaxed text-slate">
					Our story began 21 years ago in Rio de Janeiro, Brazil, when sisters Paula and Amanda Ambrosio founded Studio Decore. Ten years ago, Paula founded Paula Ambrosio Interior Design in Miami, bringing her international design experience and sophisticated aesthetic to the South Florida market.
				</p>
				<a href="/about" class="btn-secondary mt-10">Meet Paula</a>
			</div>
		</div>
	</section>

	<!-- 9. Process -->
	<section class="bg-graphite py-28 text-bone lg:py-36">
		<div class="container-editorial">
			<div class="fade-up">
				<p class="eyebrow text-brass">The Process</p>
				<h2 class="font-display mt-5 max-w-xl text-4xl lg:text-5xl">From first conversation to final reveal.</h2>
			</div>
			<ol class="mt-16 grid gap-0 sm:grid-cols-2 lg:grid-cols-3 fade-up stagger-children">
				{processSteps.map((step, i) => (
					<li class="border-t border-bone/15 pt-8 pb-10 pr-10 group">
						<span class="font-display text-[2.5rem] leading-none text-brass/60 select-none transition-colors duration-300 group-hover:text-brass">
							{String(i + 1).padStart(2, '0')}
						</span>
						<p class="eyebrow mt-5 text-bone/90">{step.label}</p>
						<p class="mt-3 text-sm leading-relaxed text-bone/55">{step.desc}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- 10. Journal -->
	<section class="bg-linen py-28 lg:py-36">
		<div class="container-editorial">
			<div class="mb-16 flex flex-wrap items-end justify-between gap-6 fade-up">
				<div>
					<p class="eyebrow text-stone">Journal</p>
					<h2 class="font-display mt-5 text-4xl">Notes on design</h2>
				</div>
				<a href="/journal" class="eyebrow text-stone underline decoration-brass/60 underline-offset-8 hover:text-ink transition-colors">Read the journal</a>
			</div>
			<div class="grid gap-10 md:grid-cols-3 fade-up stagger-children">
				{latestJournal.map((post) => {
					const d = post.data.date;
					const formatted = d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
					return (
						<article class="group">
							<a href={`/journal/${post.id}`} class="block overflow-hidden bg-sand">
								<Image
									src={post.data.featuredImage}
									alt={post.data.imageAlt ?? post.data.title}
									widths={[400, 800]}
									sizes="(min-width: 768px) 33vw, 100vw"
									loading="lazy"
									quality={55}
									decoding="async"
									class="aspect-[3/2] w-full object-cover transition-transform duration-700 ease-editorial group-hover:scale-[1.04]"
								/>
							</a>
							<div class="mt-6 flex items-center gap-3">
								<p class="eyebrow text-stone">{post.data.category}</p>
								<span class="block h-px w-4 bg-sand flex-shrink-0" aria-hidden="true"></span>
								<p class="text-[0.65rem] uppercase tracking-widest text-mist font-medium">{formatted}</p>
							</div>
							<h3 class="font-display mt-3 text-2xl leading-snug">
								<a href={`/journal/${post.id}`} class="transition-colors duration-300 hover:text-stone">{post.data.title}</a>
							</h3>
						</article>
					);
				})}
			</div>
		</div>
	</section>

	<CtaBanner />
</Layout>

<script>
	// Hero crossfade carousel
	const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
	const dots   = document.querySelectorAll<HTMLButtonElement>('.hero-dot');
	let current  = 0;
	let timer: ReturnType<typeof setInterval>;

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function goTo(index: number) {
		// Fade out current
		slides[current].style.opacity = '0';
		slides[current].setAttribute('aria-hidden', 'true');
		dots[current].style.width   = '0.5rem';
		dots[current].style.opacity = '0.5';
		dots[current].setAttribute('aria-selected', 'false');

		current = index;

		// Fade in next
		slides[current].style.opacity = '1';
		slides[current].removeAttribute('aria-hidden');
		dots[current].style.width   = '1.75rem';
		dots[current].style.opacity = '1';
		dots[current].setAttribute('aria-selected', 'true');
	}

	function advance() {
		goTo((current + 1) % slides.length);
	}

	function startTimer() {
		clearInterval(timer);
		if (!reduced) timer = setInterval(advance, 4000);
	}

	// Dot click → jump to slide and reset timer
	dots.forEach((dot, i) => {
		dot.addEventListener('click', () => {
			if (i === current) return;
			goTo(i);
			startTimer();
		});
	});

	startTimer();


	// Scroll-reveal: add .is-visible when element enters viewport
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					if (entry.target.classList.contains('stagger-children')) {
						(entry.target as HTMLElement).querySelectorAll(':scope > *').forEach((child) => {
							(child as HTMLElement).style.opacity = '';
							(child as HTMLElement).style.transform = '';
						});
					}
					observer.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.1, rootMargin: '0px 0px -40px 0px' },
	);

	document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
</script>
