---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';
import { webPageSchema, schemaScript } from '../../lib/seo';
import type { BreadcrumbEntry } from '../../lib/seo';
import { spaceUrl } from '../../config';

const spaces = (await getCollection('spaces')).filter((s) => !s.data.draft);

const breadcrumbs: BreadcrumbEntry[] = [{ name: 'Spaces', url: '/spaces' }];
---

<Layout
	title="Spaces | Room-by-Room Interior Design | Paula Ambrosio Interiors"
	description="Explore our interiors room by room: closets, living rooms, home theaters, game rooms and laundry rooms, photographed in completed Paula Ambrosio Interiors projects across Miami and South Florida."
	canonical="/spaces"
>
	<Fragment slot="head" set:html={schemaScript(webPageSchema({
		path: '/spaces',
		title: 'Spaces | Paula Ambrosio Interiors',
		description: 'Room-by-room interior design inspiration from our projects across Miami and South Florida.',
		breadcrumbs,
	}))} />

	<section class="container-editorial pt-16 pb-14 lg:pt-24">
		<Breadcrumbs items={breadcrumbs} />
		<p class="eyebrow mt-10 text-stone">By Space</p>
		<h1 class="font-display mt-4 max-w-2xl text-display">One room at a time.</h1>
		<p class="mt-6 max-w-xl text-lede text-slate">
			Rooms drawn from across our portfolio. Each photograph belongs to a
			completed project, credited and linked below. Browse by the space you are dreaming about.
		</p>
	</section>

	<section class="container-editorial pb-24">
		<h2 class="sr-only">All spaces</h2>
		<div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
			{spaces.map((space) => (
				<a href={spaceUrl(space.id)} class="group block">
					<div class="overflow-hidden">
						<img
							src={space.data.heroImage.src}
							alt={space.data.heroAlt ?? space.data.title}
							width="1000"
							height="750"
							loading="lazy"
							decoding="async"
							class="aspect-[4/3] w-full object-cover motion-safe:transition-transform motion-safe:duration-700 group-hover:scale-[1.03]"
						/>
					</div>
					<p class="eyebrow mt-5 text-stone">By Space</p>
					<h3 class="font-display mt-2 text-2xl">{space.data.title}</h3>
					<p class="mt-3 text-sm leading-relaxed text-graphite">{space.data.intro}</p>
					<span class="eyebrow mt-4 inline-block text-stone underline decoration-brass/60 underline-offset-4 transition-colors group-hover:text-ink">
						Explore <span aria-hidden="true">↗</span>
					</span>
				</a>
			))}
		</div>
	</section>

	<CtaBanner />
</Layout>
