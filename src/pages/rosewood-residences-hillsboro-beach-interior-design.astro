---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';
import FAQ from '../components/ui/FAQ.astro';
import living from '../assets/projects/hillsboro-beach-penthouse/web/living-room.webp';
import corridor from '../assets/projects/hillsboro-beach-penthouse/web/entry-to-kitchen.webp';
import dining from '../assets/projects/hillsboro-beach-penthouse/web/living-to-dining.webp';
import primary from '../assets/projects/hillsboro-beach-penthouse/web/primary-bedroom.webp';
import kids from '../assets/projects/hillsboro-beach-penthouse/web/childrens-bunk-room.webp';
import { MESSAGING, locationUrl, projectUrl, serviceUrl } from '../config';
import { faqSchema, schemaScript, serviceSchema, webPageSchema } from '../lib/seo';

const path = '/rosewood-residences-hillsboro-beach-interior-design/';
const heading = 'Interior Design for Rosewood Residences Hillsboro Beach Owners';
const title = 'Rosewood Residences Hillsboro Beach Interior Design | Paula Ambrosio Interior Design';
const description = 'Turnkey interior design for Rosewood Residences Hillsboro Beach owners. Plan before key handover and coordinate furnishings, installation and styling.';
const city = locationUrl('hillsboro-beach');
const project = projectUrl('hillsboro-beach-penthouse');
const turnkey = serviceUrl('turnkey-interior-design-miami');
const breadcrumbs = [{ name: 'Locations', url: '/locations/' }, { name: 'Hillsboro Beach', url: city }, { name: 'Rosewood Residences Interior Design', url: path }];
const stages = [
  ['Before the keys', 'Share the floor plan, your anticipated handover window and your target move-in date. We develop layouts, material and furniture selections, and 3D views. Once you approve the scope, we identify long-lead items, confirm what can be ordered and plan storage or staging as needed.'],
  ['At handover', 'When authorized access begins, we verify site dimensions and any assumptions that could not be checked from the plans. We confirm building requirements, delivery times and elevator reservations before scheduling the installation sequence.'],
  ['After access is confirmed', 'We coordinate approved deliveries, furniture and custom pieces, then arrange installation and final styling. If your project includes construction, independent contractors handle that work and its schedule is coordinated separately.'],
];
const gallery = [
  { src: corridor, label: 'Entry corridor and kitchen', alt: 'Studio 3D rendering of the entry corridor with an illuminated mirror niche and a view toward the kitchen' },
  { src: dining, label: 'Living room and dining', alt: 'Studio 3D rendering of the living room looking toward the dining table and kitchen' },
  { src: primary, label: 'Primary bedroom', alt: 'Studio 3D rendering of the primary bedroom with an upholstered bed, pendants and wood paneling' },
  { src: kids, label: 'Children’s room', alt: 'Studio 3D rendering of the children’s room with built-in blue bunk beds and reading lights' },
];
const faqs = [
  { question: 'Can you start before I have the keys?', answer: 'Yes. We can start with the floor plan, room priorities, 3D views and selections. We confirm dimensions on site and review building requirements when access is available.' },
  { question: 'Can my unit be ready on the day I receive the keys?', answer: 'Same-day readiness is not guaranteed. Installation depends on when the building allows access, approvals, deliveries and the scope of work. Starting early helps us aim for the earliest feasible move-in date. We confirm your project schedule after those details are known.' },
  { question: 'Can I manage my part of the project from out of town?', answer: 'Yes. We can review designs and selections virtually and coordinate local deliveries, installation and styling as agreed in your project scope.' },
];
---
<Layout {title} {description} canonical={path}>
  <Fragment slot="head" set:html={schemaScript(webPageSchema({ path, title, description, breadcrumbs }))} />
  <Fragment slot="head" set:html={schemaScript(serviceSchema({ path, name: heading, description, areaServed: ['Hillsboro Beach'] }))} />
  <Fragment slot="head" set:html={schemaScript(faqSchema(faqs))} />
  <article>
    <section class="border-b border-sand bg-linen py-16 lg:py-24">
      <div class="container-editorial">
        <Breadcrumbs items={breadcrumbs} />
        <p class="eyebrow mt-10 text-stone">Hillsboro Beach, Florida</p>
        <h1 class="font-display mt-4 max-w-5xl text-display">{heading}</h1>
        <p class="mt-6 max-w-3xl text-lede text-slate">Start planning before key handover. We design, furnish and coordinate installation for your oceanfront residence so it feels like your home from your first stay.</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/contact/" class="btn-primary" data-analytics-event="cta_start_project" data-analytics-location="hero">Plan Your Rosewood Residence</a>
          <a href={MESSAGING.whatsapp} class="btn-secondary" target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
        </div>
        <figure class="mt-10">
          <Image src={living} alt="Studio 3D rendering of a cream sectional, pale wood and an Atlantic Ocean view" widths={[480, 768, 1080, 1440]} sizes="(min-width: 1320px) 1240px, calc(100vw - 48px)" format="webp" quality={78} loading="eager" fetchpriority="high" decoding="async" class="h-auto w-full" />
          <figcaption class="mt-3 text-sm text-slate">Studio 3D rendering of a penthouse design study at Rosewood Residences Hillsboro Beach. Not a photograph of a completed installation.</figcaption>
        </figure>
      </div>
    </section>

    <section id="handover-timeline" class="container-editorial py-16 lg:py-24">
      <p class="eyebrow text-stone">Turnkey interior design</p>
      <h2 class="font-display mt-4 text-4xl">Your timeline from floor plan to move-in</h2>
      <p class="mt-5 max-w-3xl leading-relaxed text-slate">Start as soon as you have a floor plan and an estimated handover date. We work backward from your preferred move-in date so we can complete as many decisions and orders as possible before the keys arrive.</p>
      <ol class="mt-8 grid gap-8 lg:grid-cols-3">
        {stages.map(([label, copy], i) => <li class="border-t border-sand pt-5"><span class="eyebrow text-stone">{String(i + 1).padStart(2, '0')}</span><h3 class="font-display mt-2 text-2xl">{label}</h3><p class="mt-3 leading-relaxed text-slate">{copy}</p></li>)}
      </ol>
      <p class="mt-8 max-w-3xl border-l border-sand pl-5 leading-relaxed text-slate"><strong>When will it be ready?</strong> We build a project-specific schedule once the scope, furnishings, building access and approvals are confirmed. We aim for the earliest feasible move-in; receiving keys alone does not guarantee same-day installation.</p>
      <p class="mt-5 max-w-3xl leading-relaxed text-slate">Explore our <a href={turnkey} class="underline underline-offset-4">turnkey interior design service</a>, including furniture sourcing, custom millwork, delivery coordination and final styling as agreed for your project.</p>
    </section>

    <section class="border-y border-sand bg-linen py-16 lg:py-24">
      <div class="container-editorial">
        <p class="eyebrow text-stone">Inside the design studio</p>
        <h2 class="font-display mt-4 text-4xl">A Rosewood penthouse in 3D</h2>
        <p class="mt-5 max-w-3xl leading-relaxed text-slate">Our design study takes its cues from the oceanfront light. Pale wood connects the main rooms, a low sofa leaves the view open, and the bedrooms balance softness and storage for everyday life.</p>
        <div class="mt-8 grid gap-8 sm:grid-cols-2">
          {gallery.map((item) => <figure><Image src={item.src} alt={item.alt} widths={[480, 768, 1080]} sizes="(min-width: 768px) 45vw, calc(100vw - 48px)" format="webp" quality={77} loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" /><figcaption class="mt-3 text-sm text-slate">{item.label} · Studio 3D rendering</figcaption></figure>)}
        </div>
        <a href={project} class="btn-secondary mt-8 inline-flex">See the Full Rosewood Design Study</a>
      </div>
    </section>

    <section class="container-editorial py-16 lg:py-24">
      <h2 class="font-display text-3xl">Questions from owners</h2>
      <div class="mt-7 max-w-3xl"><FAQ {faqs} context="rosewood-owners" /></div>
      <p class="mt-8 max-w-3xl text-sm text-slate">Paula Ambrosio Interior Design is an independent studio serving owners in <a href={city} class="underline underline-offset-4">Hillsboro Beach</a>. We are not affiliated with Rosewood Residences or the developer.</p>
    </section>
  </article>
  <CtaBanner title="Let’s plan your Rosewood residence" body="Share your floor plan, estimated handover date and the rooms you want ready for your first stay." primaryLabel="Start Your Project" secondaryLabel="View the 3D Design Study" secondaryHref={project} />
</Layout>
