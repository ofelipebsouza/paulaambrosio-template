---
import { Image } from 'astro:assets';
import homeAA from '../../assets/projects/home-aa/web/01.webp';
import homeKA from '../../assets/projects/home-ka/web/01.webp';
import salon from '../../assets/projects/commercial-hs/web/01.webp';
const projects = [
  { image: homeAA, title: 'HOME A&A', slug: 'home-aa', pt: 'Madeira, pedra e tons neutros em uma residência.', en: 'Wood, stone and neutral tones in a private residence.', alt: 'Sala de estar do projeto HOME A&A, de Paula Ambrosio Interiors', altEn: 'Living room in HOME A&A by Paula Ambrosio Interiors' },
  { image: homeKA, title: 'HOME KA', slug: 'home-ka', pt: 'Luz natural e espaços de convivência integrados.', en: 'Natural light and connected living spaces.', alt: 'Espaço de convivência do projeto HOME KA, de Paula Ambrosio Interiors', altEn: 'Living space in HOME KA by Paula Ambrosio Interiors' },
  { image: salon, title: 'COMMERCIAL HS', slug: 'commercial-hs', pt: 'Vegetação e materiais naturais em um salão em Miami.', en: 'Greenery and natural materials in a Miami salon.', alt: 'Salão do projeto COMMERCIAL HS, de Paula Ambrosio Interiors', altEn: 'Salon in COMMERCIAL HS by Paula Ambrosio Interiors' },
];
---
<section class="paula-project-gallery" aria-labelledby="paula-projects-title">
  <div class="gallery-heading">
    <p class="gallery-eyebrow" data-project-pt="DO PORTFÓLIO DE PAULA" data-project-en="FROM PAULA’S PORTFOLIO">DO PORTFÓLIO DE PAULA</p>
    <h2 id="paula-projects-title" data-project-pt="Conheça os espaços que Paula projeta." data-project-en="Explore the spaces Paula designs.">Conheça os espaços que Paula projeta.</h2>
    <p data-project-pt="Fotografias de projetos do estúdio, já publicados no portfólio. Explore cada ambiente e conheça o trabalho por trás dos materiais." data-project-en="Photographs of studio projects already published in the portfolio. Explore each space and the work behind Paula’s educational materials.">Fotografias de projetos do estúdio, já publicados no portfólio. Explore cada ambiente e conheça o trabalho por trás dos materiais.</p>
  </div>
  <div class="gallery-grid">
    {projects.map(project => <a class="gallery-project" href={`/projects/${project.slug}/`}>
      <Image src={project.image} alt={project.alt} data-project-alt-pt={project.alt} data-project-alt-en={project.altEn} widths={[400, 700, 1000]} sizes="(max-width: 650px) 90vw, 30vw" loading="lazy" quality={80} />
      <h3>{project.title}</h3>
      <p data-project-pt={project.pt} data-project-en={project.en}>{project.pt}</p>
    </a>)}
  </div>
  <a class="gallery-all" href="/projects/" data-project-pt="Ver o portfólio completo →" data-project-en="Explore the full portfolio →">Ver o portfólio completo →</a>
</section>
<style>
.paula-project-gallery{padding:clamp(48px,7vw,110px) max(5vw,24px);background:#f7f4ee;color:#282521}.gallery-heading{max-width:750px;margin-bottom:36px}.gallery-eyebrow{font-size:11px;letter-spacing:.16em;margin-bottom:18px}.gallery-heading h2{font-family:Georgia,serif;font-size:clamp(34px,4vw,58px);font-weight:400;line-height:1.12;letter-spacing:-.02em;margin:0 0 20px}.gallery-heading>p:last-child{max-width:620px;line-height:1.75;font-size:16px}.gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.gallery-project{text-decoration:none;color:inherit;display:block}.gallery-project img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover}.gallery-project h3{display:flex;justify-content:space-between;gap:12px;font-family:inherit;font-weight:500;font-size:14px;letter-spacing:.07em;margin:20px 0 10px}.gallery-project p{font-size:14px;line-height:1.6;margin:0}.gallery-all{display:inline-block;color:inherit;margin-top:32px;text-underline-offset:5px}.gallery-project:focus-visible,.gallery-all:focus-visible{outline:2px solid currentColor;outline-offset:6px}@media(max-width:650px){.gallery-grid{grid-template-columns:1fr;gap:32px}}
</style>
<script>
 const updateProjectLanguage = () => {
   const english = document.documentElement.lang.startsWith('en');
   document.querySelectorAll<HTMLElement>('[data-project-pt]').forEach(el => { el.textContent = (english ? el.dataset.projectEn : el.dataset.projectPt) || ''; });
   document.querySelectorAll<HTMLElement>('[data-project-alt-pt]').forEach(el => { el.setAttribute('alt', (english ? el.dataset.projectAltEn : el.dataset.projectAltPt) || ''); });
 };
 updateProjectLanguage();
 new MutationObserver(updateProjectLanguage).observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
</script>
