---
interface Props {
	faqs: { question: string; answer: string }[];
}
const { faqs } = Astro.props;
---

<div class="divide-y divide-sand border-y border-sand">
	{faqs.map((faq) => (
		<details class="group py-5">
			<summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-lg marker:hidden [&::-webkit-details-marker]:hidden">
				{faq.question}
				<span aria-hidden="true" class="text-brass transition-transform duration-300 group-open:rotate-45">+</span>
			</summary>
			<p class="mt-3 max-w-2xl text-sm leading-relaxed text-graphite">{faq.answer}</p>
		</details>
	))}
</div>
