---
interface Props {
	title?: string;
	body?: string;
	primaryLabel?: string;
	primaryHref?: string;
	secondaryLabel?: string;
	secondaryHref?: string;
	primaryAnalyticsEvent?: string;
	analyticsLocation?: string;
}
const {
	title = 'Begin Your Project',
	body = 'Tell us about your residence or property. We will schedule a confidential discovery session with our design team.',
	primaryLabel = 'Start Your Project',
	secondaryLabel = 'Explore Our Work',
	secondaryHref = '/projects',
	primaryAnalyticsEvent = 'cta_start_project',
	analyticsLocation = 'final_cta',
} = Astro.props;
const secondaryAnalyticsEvent = secondaryHref === '/services'
	? 'cta_explore_services'
	: secondaryHref === '/contact'
		? 'cta_contact'
		: secondaryHref.startsWith('/projects')
			? 'cta_view_project'
			: undefined;
---

<section class="bg-linen">
	<!-- Ornamental top divider -->
	<div class="container-editorial pt-14 pb-0">
		<div class="ornament-divider">
			<span class="ornament-divider-diamond"></span>
		</div>
	</div>

	<div class="container-editorial py-16 text-center lg:py-24">
		<p class="eyebrow text-stone mb-5 tracking-widest">Ready to Begin?</p>
		<h2 class="font-display mx-auto max-w-2xl text-4xl lg:text-5xl leading-tight">{title}</h2>
		<p class="mx-auto mt-5 max-w-xl text-lede text-slate">{body}</p>
		<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
			<button
				type="button"
				class="inquiry-open btn-primary cursor-pointer"
				data-analytics-event={primaryAnalyticsEvent}
				data-analytics-location={analyticsLocation}
			>{primaryLabel}</button>
			<a
				href={secondaryHref}
				class="btn-secondary"
				data-analytics-event={secondaryAnalyticsEvent}
				data-analytics-location={analyticsLocation}
			>{secondaryLabel}</a>
		</div>
	</div>
</section>
