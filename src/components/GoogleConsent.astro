---
import { GOOGLE_TRACKING } from '../lib/google-tracking/config';
const configured = GOOGLE_TRACKING.enabled && /^GTM-[A-Z0-9]{6,}$/.test(GOOGLE_TRACKING.containerId) && /^[1-9]\d*$/.test(GOOGLE_TRACKING.reviewedVersion);
---
{configured && (
 <div id="paula-consent-root" hidden>
  <button id="paula-consent-open" type="button" class="fixed bottom-3 left-3 z-40 border border-sand bg-white px-3 py-2 text-xs text-ink">Privacy choices</button>
  <section id="paula-consent-panel" hidden aria-labelledby="paula-consent-title" class="fixed bottom-3 left-3 right-3 z-50 max-w-lg border border-sand bg-white p-5 shadow-lg">
   <h2 id="paula-consent-title" class="font-display text-2xl text-ink">Your privacy choices</h2>
   <p class="mt-2 text-sm text-slate">Optional Google tools help us understand website use and measure advertising. You can use our forms without allowing either. No contact-form details are sent to these tools. <a href="/privacy/" class="underline">Privacy policy</a></p>
   <label class="mt-3 flex gap-2 text-sm"><input id="paula-consent-analytics" type="checkbox" /> Website analytics</label>
   <label class="mt-2 flex gap-2 text-sm"><input id="paula-consent-ads" type="checkbox" /> Advertising measurement</label>
   <p class="mt-2 text-xs text-slate">Personalized advertising stays off. You can change these choices at any time.</p>
   <div class="mt-4 flex flex-wrap gap-2">
    <button id="paula-consent-reject" type="button" class="btn-secondary">Reject optional</button>
    <button id="paula-consent-save" type="button" class="btn-secondary">Save choices</button>
    <button id="paula-consent-close" type="button" class="btn-secondary">Close</button>
    <button id="paula-consent-accept" type="button" class="btn-secondary">Accept optional</button>
   </div>
   <button id="paula-consent-reload" type="button" hidden class="mt-3 underline text-sm">Reload after finishing your form</button>
   <p id="paula-consent-status" role="status" class="mt-2 text-xs text-slate"></p>
  </section>
 </div>
)}
<script>
 import { restoreConsent, savedConsent, saveConsent, reloadRecommended, trackingAvailable, trackGoogleEvent } from '../lib/google-tracking/browser';
 const root = document.querySelector<HTMLElement>('#paula-consent-root');
 if (root && trackingAvailable()) {
  root.hidden = false;
  const panel = document.querySelector<HTMLElement>('#paula-consent-panel')!;
  const analytics = document.querySelector<HTMLInputElement>('#paula-consent-analytics')!;
  const advertising = document.querySelector<HTMLInputElement>('#paula-consent-ads')!;
  const status = document.querySelector<HTMLElement>('#paula-consent-status')!;
  const current = savedConsent();
  if (current) { analytics.checked = current.analytics; advertising.checked = current.advertising; }
  panel.hidden = Boolean(current);
  restoreConsent();
  trackGoogleEvent('page_view');
  document.querySelector('#paula-consent-open')?.addEventListener('click', () => { panel.hidden = false; analytics.focus(); });
  const save = () => {
   const ok = saveConsent({ analytics: analytics.checked, advertising: advertising.checked });
   if (ok && !reloadRecommended()) { trackGoogleEvent('page_view'); panel.hidden = true; document.querySelector<HTMLButtonElement>('#paula-consent-open')?.focus(); }
   else if (ok) {
    status.textContent = 'Reduced permissions saved. Site measurement events are paused. Reload when your form is finished to unload tools already loaded.';
    document.querySelector<HTMLButtonElement>('#paula-consent-reload')!.hidden = false;
   }
   else status.textContent = 'These choices could not be saved. Site measurement events are paused, but tools already loaded may remain. Please check your browser storage settings before continuing.';
  };
  document.querySelector('#paula-consent-reload')?.addEventListener('click', () => location.reload());
  document.querySelector('#paula-consent-close')?.addEventListener('click', () => { panel.hidden = true; document.querySelector<HTMLButtonElement>('#paula-consent-open')?.focus(); });
  document.querySelector('#paula-consent-save')?.addEventListener('click', save);
  document.querySelector('#paula-consent-reject')?.addEventListener('click', () => { analytics.checked = false; advertising.checked = false; save(); });
  document.querySelector('#paula-consent-accept')?.addEventListener('click', () => { analytics.checked = true; advertising.checked = true; save(); });
 }
</script>
