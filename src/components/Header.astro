---
import { SITE, NAV_LEFT, NAV_RIGHT, NAV_LINKS, SOCIAL_LINKS } from '../config';
import InstagramIcon from '../assets/icons/instagram.svg?raw';
import HouzzIcon from '../assets/icons/houzz.svg?raw';
import LinkedinIcon from '../assets/icons/linkedin.svg?raw';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

const socialIcons = [InstagramIcon, HouzzIcon, LinkedinIcon];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-sand/60 bg-bone/95 backdrop-blur-sm">
	<div class="container-editorial">
		<div class="grid h-16 grid-cols-[1fr_auto_1fr] items-center gap-4 lg:h-20">

			<!-- Desktop: left nav / Mobile: hamburger -->
			<nav aria-label="Primary" class="hidden lg:block">
				<ul class="flex items-center justify-start gap-5 xl:gap-8">
					{NAV_LEFT.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={isActive(link.href) ? 'page' : undefined}
								class:list={[
									'eyebrow py-2 transition-colors duration-300 hover:text-ink',
									isActive(link.href) ? 'text-ink' : 'text-slate',
								]}
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<!-- Mobile hamburger -->
			<div class="lg:hidden">
				<button
					type="button"
					class="menu-open flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-ink/15 transition-colors hover:border-ink/30"
					aria-label="Open navigation menu"
					aria-controls="mobile-menu"
					aria-expanded="false"
				>
					<span class="relative block h-3 w-5" aria-hidden="true">
						<span class="absolute left-0 top-0 h-px w-full bg-ink"></span>
						<span class="absolute bottom-0 left-0 h-px w-full bg-ink"></span>
					</span>
				</button>
			</div>

			<!-- Centered wordmark -->
			<a href="/" class="justify-self-center text-center leading-none" aria-label={`${SITE.name} — Home`}>
				<span class="font-display block text-xl tracking-[0.12em] whitespace-nowrap text-ink lg:text-2xl">
					PAULA&nbsp;AMBROSIO
				</span>
				<span class="mt-1 block text-[0.5rem] font-medium tracking-[0.42em] text-stone uppercase">
					Interior&nbsp;Design
				</span>
			</a>

			<!-- Desktop: right nav / Mobile: inquiry shortcut -->
			<nav aria-label="Secondary" class="hidden lg:block">
				<ul class="flex items-center justify-end gap-5 xl:gap-8">
					{NAV_RIGHT.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={isActive(link.href) ? 'page' : undefined}
								class:list={[
									'eyebrow py-2 transition-colors duration-300 hover:text-ink',
									isActive(link.href) ? 'text-ink' : 'text-slate',
								]}
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<!-- Mobile: inquiry shortcut (paper plane → opens the form modal) -->
			<button
				type="button"
				class="inquiry-open flex h-10 w-10 cursor-pointer items-center justify-center justify-self-end rounded-full border border-ink/15 transition-colors hover:border-ink/30 lg:hidden"
				aria-label="Open project inquiry form"
				aria-haspopup="dialog"
			>
				<svg viewBox="0 0 24 24" class="h-4 w-4 text-ink" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M22 2 15 22 11 13 2 9 22 2z"></path>
					<path d="M22 2 11 13"></path>
				</svg>
			</button>
		</div>
	</div>
</header><!-- Fullscreen navigation menu — native <dialog>: focus is trapped, Esc closes, a11y for free -->
<dialog id="mobile-menu" class="menu-sheet m-0 h-dvh max-h-none w-screen max-w-none border-none bg-bone p-0 backdrop:bg-transparent lg:hidden">
	<div class="container-editorial">
		<div class="grid h-16 grid-cols-[1fr_auto_1fr] items-center">
			<button type="button" class="menu-close flex h-10 w-10 cursor-pointer items-center justify-center" aria-label="Close navigation menu">
				<svg viewBox="0 0 20 20" class="h-5 w-5 text-ink" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<path d="M4 4l12 12M16 4L4 16" stroke-linecap="round"></path>
				</svg>
			</button>
			<a href="/" class="justify-self-center text-center leading-none" aria-label={`${SITE.name} — Home`}>
				<span class="font-display block text-lg tracking-[0.12em] whitespace-nowrap text-ink">PAULA&nbsp;AMBROSIO</span>
				<span class="mt-1 block text-[0.5rem] font-medium tracking-[0.42em] text-stone uppercase">Interior&nbsp;Design</span>
			</a>
		</div>
	</div>

	<nav aria-label="Mobile" class="container-editorial mt-4 flex flex-col items-center gap-6">
		{NAV_LINKS.map((link) => (
			<a href={link.href} class="menu-link eyebrow text-graphite transition-colors hover:text-ink">
				{link.label}
			</a>
		))}
	</nav>

	<div class="absolute inset-x-0 bottom-10">
		<p class="font-display text-center text-2xl text-ink">Let&rsquo;s get social</p>
		<div class="mt-5 flex items-center justify-center gap-4">
			{SOCIAL_LINKS.map(({ label, href }, i) => (
				<a
					href={href}
					class="menu-link flex h-11 w-11 items-center justify-center rounded-full bg-coffee text-bone transition-colors hover:bg-coffee-deep"
					aria-label={`${SITE.name} on ${label}`}
					rel="noopener noreferrer"
				>
					<Fragment set:html={socialIcons[i].replace('<svg ', '<svg class="h-4.5 w-4.5 fill-current" ')} />
				</a>
			))}
		</div>
	</div>
</dialog>

<!-- Project inquiry sheet — fullscreen, integrated with the menu language -->
<dialog id="inquiry-modal" class="inquiry-sheet m-0 h-dvh max-h-none w-screen max-w-none border-none bg-bone p-0 backdrop:bg-transparent">
	<div class="h-full overflow-y-auto">
		<div class="sticky top-0 z-10 border-b border-sand/60 bg-bone">
			<div class="container-editorial">					<div class="grid h-16 grid-cols-[1fr_auto_1fr] items-center lg:h-20">
						<span aria-hidden="true"></span>
						<a href="/" class="justify-self-center text-center leading-none" aria-label={`${SITE.name} — Home`}>
							<span class="font-display block text-lg tracking-[0.12em] whitespace-nowrap text-ink lg:text-xl">PAULA&nbsp;AMBROSIO</span>
							<span class="mt-1 block text-[0.5rem] font-medium tracking-[0.42em] text-stone uppercase">Interior&nbsp;Design</span>
						</a>
						<button type="button" class="inquiry-close flex h-10 w-10 cursor-pointer items-center justify-center justify-self-end rounded-full border border-ink/15 transition-colors hover:border-ink/30" aria-label="Close inquiry form">
							<svg viewBox="0 0 20 20" class="h-5 w-5 text-ink" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<path d="M4 4l12 12M16 4L4 16" stroke-linecap="round"></path>
							</svg>
						</button>
					</div>
			</div>
		</div>

		<div class="mx-auto w-full max-w-[30rem] px-6 pb-20 pt-10">
			<h2 class="font-display text-center text-3xl leading-tight">
				Start your full-service interior design project
			</h2>
			<p class="mt-3 text-center text-sm leading-relaxed text-slate">
				This form helps us understand your project and confirm if we&rsquo;re the right fit for your needs.
			</p>

			<form class="mt-7 space-y-5" method="POST" action={import.meta.env.CONTACT_FORM_ENDPOINT ?? 'mailto:concierge@paulaambrosiointeriors.com'}>
				<div>
					<label for="inq-name" class="eyebrow text-slate">Full Name</label>
					<input id="inq-name" name="name" type="text" required autocomplete="name" placeholder="Your full name"
						class="mt-2 w-full border border-sand bg-white px-4 py-3 text-sm placeholder:text-mist focus:border-brass focus:outline-none" />
				</div>
				<div>
					<label for="inq-email" class="eyebrow text-slate">Email</label>
					<input id="inq-email" name="email" type="email" required autocomplete="email" placeholder="you@email.com"
						class="mt-2 w-full border border-sand bg-white px-4 py-3 text-sm placeholder:text-mist focus:border-brass focus:outline-none" />
				</div>
				<div>
					<label for="inq-message" class="eyebrow text-slate">Tell us briefly about your project</label>
					<textarea id="inq-message" name="message" rows="4" placeholder="Share a few details about your vision…"
						class="mt-2 w-full border border-sand bg-white px-4 py-3 text-sm placeholder:text-mist focus:border-brass focus:outline-none"></textarea>
				</div>
				<p class="text-center text-xs italic leading-relaxed text-slate">
					We work with a limited number of full-service projects at a time to ensure quality and attention to detail.
				</p>
				<button type="submit" class="btn-primary w-full">Submit Project Inquiry</button>
			</form>
		</div>
	</div>
</dialog>

<script>
	const sheet = document.getElementById('mobile-menu');
	const modal = document.getElementById('inquiry-modal') as HTMLDialogElement | null;

	// Fullscreen mobile menu — native <dialog>: focus trapped, Esc closes.
	document.querySelectorAll('.menu-open').forEach((btn) =>
		btn.addEventListener('click', () => {
			sheet?.showModal();
			btn.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
		}),
	);
	sheet?.addEventListener('close', () => {
		document.querySelector('.menu-open')?.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	});
	document.querySelectorAll('.menu-close').forEach((el) =>
		el.addEventListener('click', () => sheet?.close()),
	);
	document.querySelectorAll('#mobile-menu .menu-link').forEach((el) =>
		el.addEventListener('click', () => sheet?.close()),
	);

	// Project inquiry sheet — fullscreen <dialog>, focus management included.
	document.querySelectorAll('.inquiry-open').forEach((btn) =>
		btn.addEventListener('click', () => {
			modal?.showModal();
			document.body.style.overflow = 'hidden';
		}),
	);
	document.querySelectorAll('.inquiry-close').forEach((btn) =>
		btn.addEventListener('click', () => modal?.close()),
	);
	modal?.addEventListener('close', () => {
		document.body.style.overflow = '';
	});
</script>
