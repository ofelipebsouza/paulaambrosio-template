---
import { SITE, NAV_LINKS } from '../config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-sand/60 bg-bone/95 backdrop-blur-sm">
	<div class="container-editorial">
		<div class="flex h-20 items-center justify-between">
			<a href="/" class="font-display text-xl tracking-wide" aria-label={`${SITE.name} — Home`}>
				Paula&nbsp;Ambrosio <span class="italic text-stone">Interiors</span>
			</a>

			<nav aria-label="Primary" class="hidden lg:block">
				<ul class="flex items-center gap-9">
					{NAV_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={isActive(link.href) ? 'page' : undefined}
								class:list={[
									'eyebrow py-2 transition-colors duration-300 hover:text-ink',
									isActive(link.href) ? 'text-ink' : 'text-slate',
								]}
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<a href="/contact" class="btn-primary hidden lg:inline-flex">Start Your Project</a>

			<!-- Mobile menu toggle: pure CSS, no JavaScript -->
			<div class="lg:hidden">
				<input type="checkbox" id="nav-toggle" class="peer sr-only" />
				<label
					for="nav-toggle"
					class="flex h-10 w-10 cursor-pointer items-center justify-center"
					aria-label="Toggle navigation menu"
				>
					<span class="relative block h-3 w-5">
						<span class="absolute left-0 top-0 h-px w-full bg-ink transition-transform duration-300 peer-checked:translate-y-0"></span>
						<span class="absolute bottom-0 left-0 h-px w-full bg-ink"></span>
					</span>
				</label>
				<div
					class="invisible absolute inset-x-0 top-20 max-h-0 overflow-hidden bg-bone opacity-0 transition-all duration-500 peer-checked:visible peer-checked:max-h-[80vh] peer-checked:opacity-100 border-b border-sand"
				>
					<nav aria-label="Mobile" class="container-editorial flex flex-col gap-5 py-8">
						{NAV_LINKS.map((link) => (
							<a href={link.href} class="eyebrow text-graphite">
								{link.label}
							</a>
						))}
						<a href="/contact" class="btn-primary mt-2">Start Your Project</a>
					</nav>
				</div>
			</div>
		</div>
	</div>
</header>
