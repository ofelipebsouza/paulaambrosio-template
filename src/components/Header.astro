---
import { SITE, NAV_LEFT, NAV_RIGHT, NAV_LINKS, SOCIAL_LINKS } from '../config';
import Logo from './ui/Logo.astro';
import Turnstile from './ui/Turnstile.astro';
import { CONTACT_API_PATH, FIELD_LIMITS, HONEYPOT_FIELD } from '../lib/contact-form';

// The compact inquiry form posts to the same server-side endpoint as the
// contact page (src/pages/api/contact.ts): server-side validation, honeypot and
// SMTP delivery. There is deliberately no mailto: action — an insecure form
// action on an HTTPS page fails Lighthouse `is-on-https`.

// Routes are served with a trailing slash; normalise both sides so active state
// works regardless of how the href is written.
const normalize = (value: string) => value.replace(/\/+$/, '') || '/';
const path = normalize(Astro.url.pathname);
const isActive = (href: string) => {
	const target = normalize(href);
	return target === '/' ? path === '/' : path === target || path.startsWith(`${target}/`);
};

const socialIconMap: Record<string, string> = {
	Instagram: 'ph ph-instagram-logo',
	TikTok: 'ph ph-tiktok-logo',
	Threads: 'ph ph-threads-logo',
	LinkedIn: 'ph ph-linkedin-logo',
	Houzz: 'ph ph-buildings',
};
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-sand/60 bg-bone/95 backdrop-blur-sm">
	<div class="container-editorial">
		<div class="grid h-16 grid-cols-[1fr_minmax(220px,auto)_1fr] items-center gap-4 lg:h-20">

			<!-- Desktop: left nav / Mobile: hamburger -->
			<nav aria-label="Primary" class="hidden lg:block">
				<ul class="flex items-center justify-start gap-5 xl:gap-8">
					{NAV_LEFT.map((link) => (
						<li class="group relative">
							{'children' in link && link.children ? (
								<div class="dropdown">
									<a
										href={link.href}
										aria-current={isActive(link.href) ? 'page' : undefined}
										aria-haspopup="true"
										class:list={[
											'eyebrow flex items-center gap-1.5 py-2 transition-colors duration-300 hover:text-ink',
											isActive(link.href) ? 'text-ink' : 'text-slate',
										]}
									>
										{link.label}
										<svg viewBox="0 0 10 6" class="h-1.5 w-2.5 text-stone transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
											<path d="M1 1l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
										</svg>
									</a>
									<div class="dropdown-panel">
										<ul class="space-y-0.5">
											{link.children.map((child) => (
												<li>
													<a href={child.href} class="dropdown-link" aria-current={isActive(child.href) ? 'page' : undefined}>
														{child.label}
													</a>
												</li>
											))}
										</ul>
									</div>
								</div>
							) : (
								<a
									href={link.href}
									aria-current={isActive(link.href) ? 'page' : undefined}
									class:list={[
										'eyebrow py-2 transition-colors duration-300 hover:text-ink',
										isActive(link.href) ? 'text-ink' : 'text-slate',
									]}
								>
									{link.label}
								</a>
							)}
						</li>
					))}
				</ul>
			</nav>

			<!-- Mobile hamburger -->
			<div class="lg:hidden">
				<button
					type="button"
					class="menu-open flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-ink/15 transition-colors hover:border-ink/30"
					aria-label="Open navigation menu"
					aria-controls="mobile-menu"
					aria-expanded="false"
				>
					<span class="relative block h-3 w-5" aria-hidden="true">
						<span class="absolute left-0 top-0 h-px w-full bg-ink"></span>
						<span class="absolute bottom-0 left-0 h-px w-full bg-ink"></span>
					</span>
				</button>
			</div>

			<!-- Centered logo -->
			<a href="/" class="justify-self-center" aria-label={`${SITE.name} Home`}>
				<Logo variant="dark" class="h-6 w-auto lg:h-8" />
			</a>

			<!-- Desktop: right nav / Mobile: inquiry shortcut -->
			<nav aria-label="Secondary" class="hidden lg:block">
				<ul class="flex items-center justify-end gap-5 xl:gap-8">
					{NAV_RIGHT.map((link) => (
						<li class="group relative">
							{'children' in link && link.children ? (
								<div class="dropdown">
									<a
										href={link.href}
										aria-current={isActive(link.href) ? 'page' : undefined}
										aria-haspopup="true"
										class:list={[
											'eyebrow flex items-center gap-1.5 py-2 transition-colors duration-300 hover:text-ink',
											isActive(link.href) ? 'text-ink' : 'text-slate',
										]}
									>
										{link.label}
										<svg viewBox="0 0 10 6" class="h-1.5 w-2.5 text-stone transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
											<path d="M1 1l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
										</svg>
									</a>
									<div class="dropdown-panel">
										<ul class="space-y-0.5">
											{link.children.map((child) => (
												<li>
													<a href={child.href} class="dropdown-link" aria-current={isActive(child.href) ? 'page' : undefined}>
														{child.label}
													</a>
												</li>
											))}
										</ul>
									</div>
								</div>
							) : (
								<a
									href={link.href}
									aria-current={isActive(link.href) ? 'page' : undefined}
									class:list={[
										'eyebrow py-2 transition-colors duration-300 hover:text-ink',
										isActive(link.href) ? 'text-ink' : 'text-slate',
									]}
								>
									{link.label}
								</a>
							)}
						</li>
					))}
				</ul>
			</nav>

			<!-- Mobile: inquiry shortcut (paper plane → opens the form modal) -->
			<button
				type="button"
				class="inquiry-open flex h-10 w-10 cursor-pointer items-center justify-center justify-self-end rounded-full border border-ink/15 transition-colors hover:border-ink/30 lg:hidden"
				data-analytics-event="cta_start_project"
				data-analytics-location="header"
				aria-label="Open project inquiry form"
				aria-haspopup="dialog"
			>
				<svg viewBox="0 0 24 24" class="h-4 w-4 text-ink" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M22 2 15 22 11 13 2 9 22 2z"></path>
					<path d="M22 2 11 13"></path>
				</svg>
			</button>
		</div>
	</div>
</header><!-- Fullscreen navigation menu — native <dialog>: focus is trapped, Esc closes, a11y for free -->
<dialog id="mobile-menu" class="menu-sheet m-0 h-dvh max-h-none w-screen max-w-none border-none bg-bone p-0 backdrop:bg-transparent lg:hidden">
	<div class="flex h-full flex-col overflow-y-auto">
		<div class="container-editorial">
			<div class="grid h-16 grid-cols-[1fr_minmax(200px,auto)_1fr] items-center">
			<button type="button" class="menu-close flex h-10 w-10 cursor-pointer items-center justify-center" aria-label="Close navigation menu">
				<svg viewBox="0 0 20 20" class="h-5 w-5 text-ink" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<path d="M4 4l12 12M16 4L4 16" stroke-linecap="round"></path>
				</svg>
			</button>
			<a href="/" class="justify-self-center" aria-label={`${SITE.name} Home`}>
				<Logo variant="dark" class="max-h-7 w-auto" />
			</a>
		</div>
	</div>

		<nav aria-label="Mobile" class="container-editorial mt-4 flex flex-col items-center gap-5">
		{NAV_LINKS.map((link) => (
			<div class="flex w-full flex-col items-center">
				{'children' in link && link.children ? (
					<details class="mobile-group w-full">
						<summary class="menu-link eyebrow flex cursor-pointer list-none items-center justify-center gap-2 text-graphite marker:hidden [&::-webkit-details-marker]:hidden">
							{link.label}
							<span aria-hidden="true" class="text-brass transition-transform duration-300 group-open:rotate-45">+</span>
						</summary>
						<div class="mt-3 flex flex-col items-center gap-3">
							<a href={link.href} class="menu-link text-xs tracking-[0.18em] text-slate uppercase">All {link.label}</a>
							{link.children
								.filter((child) => !child.href.endsWith(link.href))
								.map((child) => (
									<a href={child.href} class="menu-link text-xs tracking-[0.18em] text-slate uppercase">{child.label}</a>
								))}
						</div>
					</details>
				) : (
					<a href={link.href} class="menu-link eyebrow text-graphite transition-colors hover:text-ink">
						{link.label}
					</a>
				)}
			</div>
		))}
	</nav>

		<div class="container-editorial mt-auto pb-10 pt-8">
			<p class="font-display text-center text-2xl text-ink">Let&rsquo;s get social</p>
			<div class="mt-5 flex items-center justify-center gap-4">
				{SOCIAL_LINKS.map(({ label, href }) => {
					const icon = socialIconMap[label];
					return (
						<a
							href={href}
							class="menu-link flex h-11 w-11 items-center justify-center rounded-full bg-coffee text-bone transition-colors hover:bg-coffee-deep"
							aria-label={`${SITE.name} on ${label}`}
							rel="noopener noreferrer"
						>
							<i class={`${icon ?? 'ph ph-link'} text-xl`} aria-hidden="true"></i>
						</a>
					);
				})}
			</div>
		</div>
	</div>
</dialog>

<!-- Project inquiry sheet — fullscreen, integrated with the menu language -->
<dialog id="inquiry-modal" class="inquiry-sheet m-0 h-dvh max-h-none w-screen max-w-none border-none bg-bone p-0 backdrop:bg-transparent">
	<div class="h-full overflow-y-auto">
		<div class="sticky top-0 z-10 border-b border-sand/60 bg-bone">
			<div class="container-editorial">					<div class="grid h-16 grid-cols-[1fr_minmax(200px,auto)_1fr] items-center lg:h-20">
						<span aria-hidden="true"></span>
						<a href="/" class="justify-self-center" aria-label={`${SITE.name} Home`}>
							<Logo variant="dark" class="max-h-7 w-auto lg:max-h-8" />
						</a>
						<button type="button" class="inquiry-close flex h-10 w-10 cursor-pointer items-center justify-center justify-self-end rounded-full border border-ink/15 transition-colors hover:border-ink/30" aria-label="Close inquiry form">
							<svg viewBox="0 0 20 20" class="h-5 w-5 text-ink" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<path d="M4 4l12 12M16 4L4 16" stroke-linecap="round"></path>
							</svg>
						</button>
					</div>
			</div>
		</div>

		<div class="mx-auto w-full max-w-[30rem] px-6 pb-20 pt-10">
			<h2 class="font-display text-center text-3xl leading-tight">
				Start your full-service interior design project
			</h2>
			<p class="mt-3 text-center text-sm leading-relaxed text-slate">
				This form helps us understand your project and confirm if we&rsquo;re the right fit for your needs.
			</p>

			<form
				class="mt-7 space-y-5"
				method="POST"
				action={CONTACT_API_PATH}
				data-analytics-form="project_inquiry"
				data-contact-email={SITE.email}
			>
				<div>
					<label for="inq-name" class="eyebrow text-slate">Full Name</label>
					<input id="inq-name" name="name" type="text" required autocomplete="name" placeholder="Your full name"
						maxlength={FIELD_LIMITS.name}
						class="mt-2 w-full border border-sand bg-white px-4 py-3 text-sm placeholder:text-mist focus:border-brass focus:outline-none" />
				</div>
				<div>
					<label for="inq-email" class="eyebrow text-slate">Email</label>
					<input id="inq-email" name="email" type="email" required autocomplete="email" placeholder="you@email.com"
						maxlength={FIELD_LIMITS.email}
						class="mt-2 w-full border border-sand bg-white px-4 py-3 text-sm placeholder:text-mist focus:border-brass focus:outline-none" />
				</div>
				<div>
					<label for="inq-phone" class="eyebrow text-slate">Phone</label>
					<input id="inq-phone" name="phone" type="tel" autocomplete="tel" placeholder="Your phone number"
						maxlength={FIELD_LIMITS.phone}
						class="mt-2 w-full border border-sand bg-white px-4 py-3 text-sm placeholder:text-mist focus:border-brass focus:outline-none" />
				</div>
				<div>
					<label for="inq-message" class="eyebrow text-slate">Tell us briefly about your project</label>
					<textarea id="inq-message" name="message" rows="4" placeholder="Share a few details about your vision…"
						maxlength={FIELD_LIMITS.message}
						class="mt-2 w-full border border-sand bg-white px-4 py-3 text-sm placeholder:text-mist focus:border-brass focus:outline-none"></textarea>
				</div>

				<!-- Honeypot: hidden from visitors and assistive tech, irresistible to bots. -->
				<div class="hidden" aria-hidden="true">
					<label for="inq-website">Website</label>
					<input id="inq-website" name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
				</div>

				<Turnstile />
				<p class="text-center text-xs italic leading-relaxed text-slate">
					We work with a limited number of full-service projects at a time to ensure quality and attention to detail.
				</p>
				<button type="submit" class="btn-primary w-full">Submit Project Inquiry</button>
				<p class="analytics-form-status mt-3 text-center text-sm" aria-live="polite"></p>
				<noscript>
					<p class="mt-3 text-center text-xs leading-relaxed text-slate">
						Prefer email?
						<a class="underline decoration-brass/60 underline-offset-4" href={`mailto:${SITE.email}`}>{SITE.email}</a>
					</p>
				</noscript>
			</form>
		</div>
	</div>
</dialog>

<script>
	const sheet = document.getElementById('mobile-menu');
	const modal = document.getElementById('inquiry-modal') as HTMLDialogElement | null;

	// Fullscreen mobile menu — native <dialog>: focus trapped, Esc closes.
	document.querySelectorAll('.menu-open').forEach((btn) =>
		btn.addEventListener('click', () => {
			sheet?.showModal();
			btn.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
		}),
	);
	sheet?.addEventListener('close', () => {
		document.querySelector('.menu-open')?.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	});
	document.querySelectorAll('.menu-close').forEach((el) =>
		el.addEventListener('click', () => sheet?.close()),
	);
	document.querySelectorAll('#mobile-menu .menu-link').forEach((el) => {
		// Skip summary elements (dropdown toggles) — they should toggle, not close
		if (el.closest('summary')) return;
		el.addEventListener('click', () => sheet?.close());
	});

	// Project inquiry sheet — fullscreen <dialog>, focus management included.
	document.querySelectorAll('.inquiry-open').forEach((btn) =>
		btn.addEventListener('click', () => {
			modal?.showModal();
			document.body.style.overflow = 'hidden';
		}),
	);
	document.querySelectorAll('.inquiry-close').forEach((btn) =>
		btn.addEventListener('click', () => modal?.close()),
	);
	modal?.addEventListener('close', () => {
		document.body.style.overflow = '';
	});
</script>
