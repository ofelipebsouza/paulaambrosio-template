---
import { Image } from 'astro:assets';
import { projectUrl } from '../../config';

interface Props {
	projects: {
		id: string;
		data: {
			title: string;
			location?: string;
			propertyType?: string;
			featuredImage: { src: string }; // astro:assets ImageMetadata
			imageAlt?: string;
		};
	}[];
	columns?: 2 | 3;
}

const { projects, columns = 3 } = Astro.props;
const cols =
	columns === 3 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2 max-w-4xl mx-auto';
---

<ul class={`grid gap-10 ${cols}`}>
	{projects.map((project) => (
		<li class="group">
			<a href={projectUrl(project.id)} class="block overflow-hidden bg-sand">
				<Image
					src={project.data.featuredImage}
					alt={project.data.imageAlt ?? project.data.title}
					widths={[400, 800]}
					sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
					loading="lazy"
					quality={55}
					decoding="async"
					class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-editorial group-hover:scale-[1.03]"
				/>
			</a>
			<p class="eyebrow mt-5 text-stone">{project.data.location}</p>
			<h3 class="font-display mt-2 text-2xl leading-snug">
				<a href={projectUrl(project.id)} class="hover:text-stone">{project.data.title}</a>
			</h3>
			{project.data.propertyType && (
				<p class="mt-1 text-sm text-slate">{project.data.propertyType}</p>
			)}
		</li>
	))}
</ul>
