---
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	/** Full-size optimized srcs, same order as the gallery triggers. */
	full: string[];
}

const { title, full } = Astro.props;
const total = full.length;
---

<dialog
	id="lightbox"
	class="border-none bg-transparent p-0"
	aria-label={`${title} — image viewer`}
>
	<div class="fixed inset-0 flex flex-col bg-ink/95">
		<div class="flex items-center justify-between px-5 py-4 text-bone">
			<p class="text-sm tracking-widest text-bone/80" data-lightbox-counter>1 / {total}</p>
			<button
				type="button"
				class="flex h-10 w-10 items-center justify-center rounded-full border border-bone/30 text-bone transition-colors hover:bg-bone/10"
				data-lightbox-close
				aria-label="Close image viewer"
			>
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path></svg>
			</button>
		</div>
		<div class="relative flex flex-1 items-center justify-center overflow-hidden px-2 pb-6">
			<img
				data-lightbox-img
				class="mx-auto max-h-[78dvh] w-auto max-w-full select-none object-contain"
				draggable="false"
				alt=""
			/>
			<button
				type="button"
				class="absolute left-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-bone/30 text-bone transition-colors hover:bg-bone/10 sm:left-5"
				data-lightbox-prev
				aria-label="Previous image"
			>
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</button>
			<button
				type="button"
				class="absolute right-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-bone/30 text-bone transition-colors hover:bg-bone/10 sm:right-5"
				data-lightbox-next
				aria-label="Next image"
			>
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</button>
		</div>
	</div>
</dialog>

<script>
	const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
	const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]')];
	if (dialog && triggers.length > 0) {
		const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
		const counter = dialog.querySelector<HTMLElement>('[data-lightbox-counter]')!;
		const sources = triggers.map((btn) => {
			const gridImg = btn.querySelector('img');
			return { src: btn.dataset.full ?? gridImg?.getAttribute('src') ?? '', alt: gridImg?.getAttribute('alt') ?? '' };
		});
		const total = sources.length;
		let current = 0;

		const show = (index: number) => {
			current = ((index % total) + total) % total;
			img.src = sources[current].src;
			img.alt = sources[current].alt;
			counter.textContent = `${current + 1} / ${total}`;
			// Preload neighbors for instant navigation
			for (const delta of [-1, 1]) {
				const next = sources[((current + delta) % total + total) % total];
				if (next.src) new Image().src = next.src;
			}
		};

		for (const [i, btn] of triggers.entries()) {
			btn.addEventListener('click', () => {
				show(i);
				dialog.showModal();
			});
		}

		dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
		dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
		dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));

		// Click on empty backdrop closes
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});

		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
			if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
		});

		// Touch swipe navigation
		let startX = 0;
		dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
		dialog.addEventListener('touchend', (e) => {
			const dx = e.changedTouches[0].clientX - startX;
			if (Math.abs(dx) > 48) show(dx < 0 ? current + 1 : current - 1);
		}, { passive: true });
	}
</script>
