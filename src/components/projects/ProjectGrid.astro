---
import { projectUrl } from '../../config';

interface Props {
	projects: CollectionEntry<'projects'>[];
	columns?: 2 | 3;
}
const { projects, columns = 3 } = Astro.props;
---

<div class:list={['grid gap-x-8 gap-y-14', columns === 3 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2']}>
	{projects.map((project) => (
		<article class="group" data-category={project.data.projectType ?? 'Other'}>
			<a
				href={projectUrl(project.id)}
				class="block overflow-hidden bg-linen"
				data-analytics-event="portfolio_open"
				data-analytics-project={project.id}
			>
				<img
					src={project.data.featuredImage.src}
					alt={project.data.imageAlt ?? `${project.data.title}, ${project.data.location ?? 'luxury interior'}, designed by Paula Ambrosio Interiors`}
					width="1000"
					height="750"
					loading="lazy"
					decoding="async"
					class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-editorial group-hover:scale-[1.03]"
				/>
			</a>
			<div class="mt-5">
				<p class="eyebrow text-stone">{project.data.location ?? project.data.projectType}</p>
				<h3 class="font-display mt-2 text-2xl">
					<a
						href={projectUrl(project.id)}
						class="hover:text-stone"
						data-analytics-event="cta_view_project"
						data-analytics-location="portfolio"
						data-analytics-project={project.id}
					>{project.data.title}</a>
				</h3>
			</div>
		</article>
	))}
</div>
