---
import { SITE, FOOTER_LOCATIONS, NAV_LINKS, SOCIAL_LINKS, serviceUrl, locationUrl } from '../config';
import Logo from './ui/Logo.astro';

const { compactFooter = false } = Astro.props;
const year = new Date().getFullYear();
const socialIconMap: Record<string, string> = {
	Instagram: 'ph ph-instagram-logo',
	TikTok: 'ph ph-tiktok-logo',
	Threads: 'ph ph-threads-logo',
	LinkedIn: 'ph ph-linkedin-logo',
	Houzz: 'ph ph-buildings',
};
---

{compactFooter ? (
	<footer class="bg-ink text-bone">
		<div class="container-editorial py-10">
			<div class="flex flex-col items-center gap-4 text-center">
				<div class="w-48">
					<Logo variant="light" class="h-auto" />
				</div>
				<p class="text-xs text-bone/60">© {year} {SITE.legalName}. All Rights Reserved. Miami, FL.</p>
				<a href="/privacy" class="text-xs text-bone/60 transition-colors hover:text-brass">Privacy Policy</a>
			</div>
		</div>
	</footer>
) : (
<footer class="bg-ink text-bone">
	<div class="container-editorial py-16 lg:py-20">
		<div class="grid gap-12 lg:grid-cols-12">
			<div class="lg:col-span-5">
				<div class="w-56">
					<Logo variant="light" class="h-auto" />
				</div>
				<p class="eyebrow mt-8 text-brass">Miami Luxury Interior Design</p>
				<p class="mt-5 max-w-md text-sm leading-relaxed text-bone/60">
					Full-service and turnkey interior design for luxury residences, penthouses and
					hospitality spaces across Miami and South Florida.
				</p>
				<address class="mt-6 space-y-2 text-sm not-italic text-bone/70">
					<p>{SITE.address}</p>
					<p><a href={`mailto:${SITE.email}`} class="hover:text-brass">{SITE.email}</a></p>
					<p><a href={`tel:${SITE.phoneE164}`} class="hover:text-brass">{SITE.phone}</a></p>
					<p><a href="tel:+17862085412" class="hover:text-brass">{SITE.phone2}</a></p>
				</address>
				<div class="mt-6 flex items-center gap-4">
					{SOCIAL_LINKS.map(({ label, href }) => (
						<a href={href} class="text-bone/60 transition-colors hover:text-brass" aria-label={`${SITE.name} on ${label}`} target="_blank" rel="noopener noreferrer">
							<i class={`${socialIconMap[label] ?? 'ph ph-link'} text-xl`} aria-hidden="true"></i>
						</a>
					))}
				</div>
			</div>

			<nav aria-label="Footer services" class="lg:col-span-2">
				<h3 class="eyebrow text-brass">Services</h3>
				<ul class="mt-4 space-y-2.5 text-sm text-bone/60">
					<li><a href={serviceUrl('design-consultation-miami')} class="hover:text-bone">Design Consultation</a></li>
					<li><a href={serviceUrl('turnkey-interior-design-miami')} class="hover:text-bone">Turnkey Interior Design</a></li>
					<li><a href={serviceUrl('luxury-residential-interior-design-miami')} class="hover:text-bone">Luxury Residential</a></li>
					<li><a href={serviceUrl('hospitality-interior-design-miami')} class="hover:text-bone">Hospitality Design</a></li>
					<li><a href="/services" class="hover:text-bone">All Services</a></li>
				</ul>
			</nav>

			<nav aria-label="Footer locations" class="lg:col-span-2">
				<h3 class="eyebrow text-brass">Locations</h3>
				<ul class="mt-4 space-y-2.5 text-sm text-bone/60">
					{FOOTER_LOCATIONS.map((loc) => (
						<li><a href={loc.href} class="hover:text-bone">{loc.label}</a></li>
					))}
				</ul>
			</nav>

			<nav aria-label="Footer studio" class="lg:col-span-3">
				<h3 class="eyebrow text-brass">Studio</h3>
				<ul class="mt-4 space-y-2.5 text-sm text-bone/60">
					{NAV_LINKS.map((link) => (
						<li><a href={link.href} class="hover:text-bone">{link.label}</a></li>
					))}
					<li><a href="/faq" class="hover:text-bone">FAQ</a></li>
					<li><a href="/sitemap-pages" class="hover:text-bone">Sitemap &amp; Index</a></li>
					<li><a href="/style-guides-and-branding" class="hover:text-bone">Style Guide &amp; Branding</a></li>
				</ul>
				<button type="button" class="inquiry-open btn-primary mt-6 cursor-pointer" data-analytics-event="cta_start_project" data-analytics-location="footer">Start Your Project</button>
			</nav>
		</div>

		<div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-bone/10 pt-8 text-xs text-bone/60 sm:flex-row">
			<p>© {year} {SITE.legalName}. All Rights Reserved. Miami, FL.</p>
		</div>
	</div>
</footer>
)}
