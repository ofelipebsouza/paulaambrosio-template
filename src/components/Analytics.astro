---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
---

<Analytics mode={import.meta.env.PROD ? 'production' : 'development'} />
<SpeedInsights />

<script>
	import { trackEvent } from '../lib/analytics/track';
	import { ANALYTICS_EVENTS } from '../lib/analytics/events';
	import { CONTACT_FIELDS, HONEYPOT_FIELD } from '../lib/contact-form';

	const globalWindow = window as Window & { __paulaAnalyticsInitialized?: boolean };

	if (!globalWindow.__paulaAnalyticsInitialized) {
		globalWindow.__paulaAnalyticsInitialized = true;

		const page = () => window.location.pathname || '/';
		const value = (element: Element, name: string) => element.getAttribute(name) || undefined;
		const metadata = (element: Element, extra: Record<string, string | undefined> = {}) => ({
			page: page(),
			location: value(element, 'data-analytics-location'),
			...extra,
		});

		const trackClick = (element: Element) => {
			const event = value(element, 'data-analytics-event');
			const knownEvent = event && Object.values(ANALYTICS_EVENTS).includes(event as (typeof ANALYTICS_EVENTS)[keyof typeof ANALYTICS_EVENTS])
				? event as (typeof ANALYTICS_EVENTS)[keyof typeof ANALYTICS_EVENTS]
				: undefined;
			if (!knownEvent) return;

			trackEvent(knownEvent, metadata(element, {
				service: value(element, 'data-analytics-service'),
				project: value(element, 'data-analytics-project'),
				faq: value(element, 'data-analytics-faq'),
			}));

			// Internal analytics recording
			fetch('/api/analytics/collect/', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ page: page(), event: knownEvent }),
			}).catch(() => {});
		};

		// Track page view internally
		fetch('/api/analytics/collect/', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ page: page(), referrer: document.referrer || undefined }),
		}).catch(() => {});

		document.addEventListener('click', (event) => {
			if (!(event.target instanceof Element)) return;
			const target = event.target.closest('[data-analytics-event]');
			if (target) trackClick(target);

			const link = event.target.closest('a[href]');
			if (!(link instanceof HTMLAnchorElement)) return;
			const href = link.getAttribute('href') ?? '';
			const linkMetadata = metadata(link);

			if (href.startsWith('tel:')) {
				trackEvent(ANALYTICS_EVENTS.PHONE_CLICK, linkMetadata);
				fetch('/api/analytics/collect/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ page: page(), event: 'phone_click' }) }).catch(() => {});
			}
			if (href.startsWith('mailto:')) {
				trackEvent(ANALYTICS_EVENTS.EMAIL_CLICK, linkMetadata);
				fetch('/api/analytics/collect/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ page: page(), event: 'email_click' }) }).catch(() => {});
			}
			if (/whatsapp|wa\.me/i.test(href)) {
				trackEvent(ANALYTICS_EVENTS.WHATSAPP_CLICK, linkMetadata);
				fetch('/api/analytics/collect/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ page: page(), event: 'whatsapp_click' }) }).catch(() => {});
			}
			if (/instagram\.com/i.test(href)) {
				trackEvent(ANALYTICS_EVENTS.INSTAGRAM_CLICK, linkMetadata);
				fetch('/api/analytics/collect/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ page: page(), event: 'instagram_click' }) }).catch(() => {});
			}
		});

		document.addEventListener('toggle', (event) => {
			const details = event.target;
			if (!(details instanceof HTMLDetailsElement) || !details.open) return;
			const summary = details.querySelector('summary');
			const faq = details.getAttribute('data-analytics-faq') ?? summary?.getAttribute('data-analytics-faq');
			if (faq) trackEvent(ANALYTICS_EVENTS.FAQ_OPEN, { page: page(), faq });
		}, true);

		const startedForms = new WeakSet<HTMLFormElement>();
		document.addEventListener('focusin', (event) => {
			const field = event.target;
			if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
			const form = field.form;
			if (!form || startedForms.has(form)) return;
			startedForms.add(form);
			trackEvent(ANALYTICS_EVENTS.FORM_START, {
				page: page(),
				form: form.getAttribute('data-analytics-form') ?? 'project_inquiry',
			});
		});

		const submitForms = (root: ParentNode = document) => {
			root.querySelectorAll<HTMLFormElement>('form[data-analytics-form]').forEach((form) => {
				if (form.dataset.analyticsBound === 'true') return;
				form.dataset.analyticsBound = 'true';

				const status = form.querySelector<HTMLElement>('.analytics-form-status');
				form.addEventListener('analytics-form-success', (event) => {
					if (!status) return;
					const message = (event as CustomEvent<{ message?: string }>).detail?.message;
					status.textContent =
						message ??
						'Thank you. Your project inquiry has been received. Our team will be in touch soon.';
					status.className = 'analytics-form-status mt-3 text-sm text-coffee';
				});
				form.addEventListener('analytics-form-error', (event) => {
					if (!status) return;
					const email = form.dataset.contactEmail;
					const mailFallback = (event as CustomEvent<{ mailFallback?: string | null }>).detail?.mailFallback;
					if (mailFallback) {
						status.textContent = "We couldn't send your inquiry by email. Your details are still here. Try again, or ";
						const link = document.createElement('a');
						link.href = mailFallback;
						link.textContent = 'Open email draft';
						link.className = 'underline underline-offset-4';
						link.addEventListener('click', (click) => {
							// Include any edits made after the failed attempt.
							const currentDraft = mailFallbackHref(new FormData(form));
							if (currentDraft) link.href = currentDraft;
							else click.preventDefault();
						});
						status.append(link, ' and press Send in your email app.');
					} else {
						status.textContent = email
							? `Something went wrong while sending your inquiry. Please try again or contact us directly at ${email}.`
							: 'Something went wrong while sending your inquiry. Please try again.';
					}
					status.className = 'analytics-form-status mt-3 text-sm text-red-800';
				});

			const action = form.getAttribute('action') ?? '';
			if (!action) return;

			// A delivery failure offers an email draft the visitor can choose to open.
			// Preparing the draft neither opens an app nor confirms delivery.
			const mailFallbackHref = (data: FormData): string | null => {
				const to = form.dataset.contactEmail;
				if (!to) return null;

				const lines: string[] = [];
				for (const spec of CONTACT_FIELDS) {
					const value = String(data.get(spec.name) ?? '').trim();
					if (value) lines.push(`${spec.label}: ${value}`);
				}
				if (String(data.get(HONEYPOT_FIELD) ?? '').trim()) return null;

				const subject = `New Project Inquiry — ${String(data.get('name') ?? '').trim()}`;
				return `mailto:${to}?subject=${encodeURIComponent(
					subject,
				)}&body=${encodeURIComponent(lines.join('\n'))}`;
			};

			const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const submitLabel = submitButton?.textContent ?? '';
			const setSending = (sending: boolean) => {
				form.setAttribute('aria-busy', sending ? 'true' : 'false');
				if (!submitButton) return;
				submitButton.disabled = sending;
				submitButton.textContent = sending ? 'Sending…' : submitLabel;
			};

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (submitButton?.disabled) return;

				// Captured before the request: the only field values Analytics may see.
				const data = new FormData(form);
				const service = String(data.get('service') ?? '').trim();
				const propertyType = String(data.get('propertyType') ?? '').trim();

				setSending(true);
				if (status) status.textContent = '';
				trackEvent(ANALYTICS_EVENTS.FORM_SUBMIT, {
					page: page(),
					form: form.dataset.analyticsForm,
				});

				let mailFallback: string | null = null;
				try {
					const response = await fetch(action, {
						method: form.method || 'POST',
						body: data,
						headers: { Accept: 'application/json' },
					});

					if (response.status === 502 || response.status === 503) {
						const result = await response.json().catch(() => null) as { error?: string } | null;
						if (
							(response.status === 502 && result?.error === 'delivery_failed') ||
							(response.status === 503 && result?.error === 'delivery_unavailable')
						) {
							mailFallback = mailFallbackHref(data);
						}
					}
					if (!response.ok) throw new Error(`Form request failed with ${response.status}`);

					trackEvent(ANALYTICS_EVENTS.FORM_SUCCESS, {
						page: page(),
						form: form.dataset.analyticsForm,
						service: service || undefined,
						property_type: propertyType || undefined,
					});
					form.reset();
					form.dispatchEvent(new CustomEvent('analytics-form-success'));
				} catch {
					// Fields are intentionally kept: retyping an inquiry is not acceptable.
					trackEvent(ANALYTICS_EVENTS.FORM_ERROR, {
						page: page(),
						form: form.dataset.analyticsForm,
					});
					form.dispatchEvent(new CustomEvent('analytics-form-error', { detail: { mailFallback } }));
				} finally {
					setSending(false);
				}
			});
			});
		};

		submitForms();
		document.addEventListener('astro:page-load', () => submitForms());
	}
</script>
