# build output
dist/
# generated types
.astro/
.vercel/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local dev / preview / lighthouse output — rewritten on every run
.freebuff/*.log
.freebuff/*.log.err
.freebuff/*.pid

# environment variables — never commit credentials
.env
.env.local
.env.*.local
.env.production
.env.development

# vercel project link (contains project/team ids)
.vercel

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
