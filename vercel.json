{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "npm run build",
	"trailingSlash": true,
	"cleanUrls": false,
	"redirects": [
		{
			"source": "/(.*)",
			"has": [{ "type": "host", "value": "paulaambrosio.com" }],
			"destination": "https://www.paulaambrosio.com/$1",
			"permanent": true
		},
		{ "source": "/locations/miami", "destination": "/interior-design-miami/", "permanent": true },
		{ "source": "/locations/miami/", "destination": "/interior-design-miami/", "permanent": true },
		{ "source": "/locations/miami-beach", "destination": "/interior-designer-miami-beach/", "permanent": true },
		{ "source": "/locations/miami-beach/", "destination": "/interior-designer-miami-beach/", "permanent": true },
		{ "source": "/locations/sunny-isles-beach", "destination": "/interior-designer-sunny-isles/", "permanent": true },
		{ "source": "/locations/sunny-isles-beach/", "destination": "/interior-designer-sunny-isles/", "permanent": true },
		{ "source": "/locations/aventura", "destination": "/interior-designer-aventura/", "permanent": true },
		{ "source": "/locations/aventura/", "destination": "/interior-designer-aventura/", "permanent": true },
		{ "source": "/locations/bal-harbour", "destination": "/interior-designer-bal-harbour/", "permanent": true },
		{ "source": "/locations/bal-harbour/", "destination": "/interior-designer-bal-harbour/", "permanent": true },
		{ "source": "/locations/boca-raton", "destination": "/interior-designer-boca-raton/", "permanent": true },
		{ "source": "/locations/boca-raton/", "destination": "/interior-designer-boca-raton/", "permanent": true },
		{ "source": "/locations/palm-beach", "destination": "/interior-designer-palm-beach/", "permanent": true },
		{ "source": "/locations/palm-beach/", "destination": "/interior-designer-palm-beach/", "permanent": true },
		{ "source": "/services/turnkey-interior-design-miami", "destination": "/turnkey-interior-design-miami/", "permanent": true },
		{ "source": "/services/turnkey-interior-design-miami/", "destination": "/turnkey-interior-design-miami/", "permanent": true },
		{ "source": "/services/luxury-residential-interior-design-miami", "destination": "/luxury-residential-interior-design-miami/", "permanent": true },
		{ "source": "/services/luxury-residential-interior-design-miami/", "destination": "/luxury-residential-interior-design-miami/", "permanent": true },
		{ "source": "/services/hospitality-interior-design-miami", "destination": "/hospitality-interior-design-miami/", "permanent": true },
		{ "source": "/services/hospitality-interior-design-miami/", "destination": "/hospitality-interior-design-miami/", "permanent": true },
		{ "source": "/locations/sunny-isles", "destination": "/interior-designer-sunny-isles/", "permanent": true },
		{ "source": "/locations/sunny-isles/", "destination": "/interior-designer-sunny-isles/", "permanent": true },
		{ "source": "/locations/interior-designer-sunny-isles", "destination": "/interior-designer-sunny-isles/", "permanent": true },
		{ "source": "/locations/interior-designer-sunny-isles/", "destination": "/interior-designer-sunny-isles/", "permanent": true },
		{ "source": "/locations/interior-designer-aventura", "destination": "/interior-designer-aventura/", "permanent": true },
		{ "source": "/locations/interior-designer-aventura/", "destination": "/interior-designer-aventura/", "permanent": true },
		{ "source": "/locations/interior-designer-bal-harbour", "destination": "/interior-designer-bal-harbour/", "permanent": true },
		{ "source": "/locations/interior-designer-bal-harbour/", "destination": "/interior-designer-bal-harbour/", "permanent": true },
		{ "source": "/locations/interior-designer-boca-raton", "destination": "/interior-designer-boca-raton/", "permanent": true },
		{ "source": "/locations/interior-designer-boca-raton/", "destination": "/interior-designer-boca-raton/", "permanent": true },
		{ "source": "/locations/interior-designer-palm-beach", "destination": "/interior-designer-palm-beach/", "permanent": true },
		{ "source": "/locations/interior-designer-palm-beach/", "destination": "/interior-designer-palm-beach/", "permanent": true },
		{ "source": "/commercial-hs", "destination": "/projects/commercial-hs/", "permanent": true },
		{ "source": "/commercial-hs/", "destination": "/projects/commercial-hs/", "permanent": true },
		{ "source": "/portfolio", "destination": "/projects/", "permanent": true },
		{ "source": "/portfolio/", "destination": "/projects/", "permanent": true },
		{ "source": "/portfolio/:slug", "destination": "/projects/:slug/", "permanent": true },
		{ "source": "/portfolio/:slug/", "destination": "/projects/:slug/", "permanent": true },
		{ "source": "/start-your-project", "destination": "/contact/", "permanent": true },
		{ "source": "/start-your-project/", "destination": "/contact/", "permanent": true },
		{ "source": "/sitemap", "destination": "/sitemap-pages/", "permanent": true },
		{ "source": "/sitemap/", "destination": "/sitemap-pages/", "permanent": true },
		{ "source": "/interior-design-miami-v1", "destination": "/interior-design-miami/", "permanent": true },
		{ "source": "/interior-design-miami-v1/", "destination": "/interior-design-miami/", "permanent": true },
		{ "source": "/interior-design-miami-v2", "destination": "/interior-design-miami/", "permanent": true },
		{ "source": "/interior-design-miami-v2/", "destination": "/interior-design-miami/", "permanent": true },
		{ "source": "/blog", "destination": "/journal/", "permanent": true },
		{ "source": "/blog/", "destination": "/journal/", "permanent": true },
		{ "source": "/blog/:slug", "destination": "/journal/:slug/", "permanent": true },
		{ "source": "/blog/:slug/", "destination": "/journal/:slug/", "permanent": true }
	],
	"crons": [
		{
			"path": "/api/crm/cron/followups/",
			"schedule": "0 9 * * *"
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
				{ "key": "X-Frame-Options", "value": "SAMEORIGIN" },
				{ "key": "Permissions-Policy", "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()" },
				{ "key": "Strict-Transport-Security", "value": "max-age=63072000" },
				{ "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://buy.stripe.com https://stan.store; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://ssl.google-analytics.com https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://www.gstatic.com https://challenges.cloudflare.com https://va.vercel-scripts.com https://vitals.vercel-insights.com https://connect.facebook.net https://bzrcdn.openai.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://www.gstatic.com https://www.facebook.com https://framerusercontent.com https://vitals.vercel-insights.com; font-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://www.google.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://pagead2.googlesyndication.com https://challenges.cloudflare.com https://vitals.vercel-insights.com https://va.vercel-scripts.com https://www.facebook.com https://connect.facebook.net https://bzrcdn.openai.com; frame-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com https://www.google.com https://maps.google.com https://td.doubleclick.net; media-src 'self'; worker-src 'self' blob:" }
			]
		},
		{
			"source": "/fonts/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		},
		{
			"source": "/landing-assets/(.*)\\.(woff2|woff|otf)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		}
	]
}
